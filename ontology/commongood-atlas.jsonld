      "domain": "npo:grantee",
      "range": "npo:application",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:hasMeasurement",
      "type": "owl:ObjectProperty",
      "label": "has",
      "comment": "An Indicator has one or more Measurements -- the observed values recorded over time. Never equated with the Indicator's Target: a Target is planned, a Measurement is observed.",
      "domain": "npo:indicator",
      "range": "npo:measurement",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:hasTarget",
      "type": "owl:ObjectProperty",
      "label": "has",
      "comment": "An Indicator has a Target -- the planned value expected by a defined date.",
      "domain": "npo:indicator",
      "range": "npo:target",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:disbursedAsPayment",
      "type": "owl:ObjectProperty",
      "label": "is disbursed as",
      "comment": "An Installment is disbursed as a Payment once any Payment Condition is satisfied.",
      "domain": "npo:installment",
      "range": "npo:payment",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:mayHavePaymentCondition",
      "type": "owl:ObjectProperty",
      "label": "may have",
      "comment": "An Installment may carry a Payment Condition that must be met before it is disbursed.",
      "domain": "npo:installment",
      "range": "npo:payment-condition",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:includesActivity",
      "type": "owl:ObjectProperty",
      "label": "includes",
      "comment": "A Logic Model includes the Activities it plans for.",
      "domain": "npo:logic-model",
      "range": "npo:activity",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:includesInput",
      "type": "owl:ObjectProperty",
      "label": "includes",
      "comment": "A Logic Model includes the Inputs it plans for.",
      "domain": "npo:logic-model",
      "range": "npo:input",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:includesOutcome",
      "type": "owl:ObjectProperty",
      "label": "includes",
      "comment": "A Logic Model includes the Outcomes it plans for.",
      "domain": "npo:logic-model",
      "range": "npo:outcome",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:includesOutput",
      "type": "owl:ObjectProperty",
      "label": "includes",
      "comment": "A Logic Model includes the Outputs it plans for.",
      "domain": "npo:logic-model",
      "range": "npo:output",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:observedForPopulation",
      "type": "owl:ObjectProperty",
      "label": "was observed for",
      "comment": "A Measurement was observed for a specific Population.",
      "domain": "npo:measurement",
      "range": "npo:population",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:observedIn",
      "type": "owl:ObjectProperty",
      "label": "was observed in",
      "comment": "A Measurement was observed in a specific Geographic Area.",
      "domain": "npo:measurement",
      "range": "npo:geographic-area",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:experiencedByPopulation",
      "type": "owl:ObjectProperty",
      "label": "is experienced by",
      "comment": "A Need is experienced by a specific Population.",
      "domain": "npo:need",
      "range": "npo:population",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:hasLegalForm",
      "type": "owl:ObjectProperty",
      "label": "has legal form",
      "comment": "An Organization has a legal form describing what it fundamentally is under law, independent of any role it plays.",
      "domain": "npo:organization",
      "range": "npo:organization-type",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md"
    },
    {
      "id": "nporel:implementsProject",
      "type": "owl:ObjectProperty",
      "label": "implements",
      "comment": "An Organization carries out a Project -- typically the Grantee, but modeled directly on Organization rather than a specific role so any organization implementing work (e.g. a Sponsored Project's Fiscal Sponsor) can be represented the same way.",
      "domain": "npo:organization",
      "range": "npo:project",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:participatesIn",
      "type": "owl:ObjectProperty",
      "label": "participates in",
      "comment": "An Organization participates in a Philanthropic Arrangement, independent of tracking which specific role it occupies there.",
      "domain": "npo:organization",
      "range": "npo:philanthropic-arrangement",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md"
    },
    {
      "id": "nporel:playsRole",
      "type": "owl:ObjectProperty",
      "label": "plays",
      "comment": "An Organization plays one or more Organization Roles, each a contextual, independently-scoped occupancy rather than a permanent trait.",
      "domain": "npo:organization",
      "range": "npo:organization-role",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md",
      "deprecated": true,
      "isReplacedBy": "nporel:agentPlaysRole"
    },
    {
      "id": "nporel:appliesWithin",
      "type": "owl:ObjectProperty",
      "label": "applies within",
      "comment": "An Organization Role is scoped to the Philanthropic Arrangement it was granted within, so the same organization can hold different roles in different arrangements.",
      "domain": "npo:organization-role",
      "range": "npo:philanthropic-arrangement",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md"
    },
    {
      "id": "nporel:organizationRoleAppliesWithinOrganization",
      "type": "owl:ObjectProperty",
      "label": "applies within",
      "comment": "An Organization Role can also be scoped directly to an Organization rather than an Arrangement -- e.g. a Contractor, Vendor, Service Provider, Employer, or Partner role is naturally scoped to which organization it relates to, not to a Philanthropic Arrangement. A distinct predicate from rel-organization-role-applies-within for the same reason Phase 3.7 Milestone 1's Person relationships needed distinct names: the generator requires every relationship predicate to be globally unique, so one predicate can't have two different declared object concepts. Broadening this into a true Role-appliesWithin-Context union (Award, Application, Agreement, Fund, Grant Program, Funding Opportunity, Project, Review, Payment, Decision, per the Phase 3.7 roadmap) is deferred until real worked-example data actually needs one of those specific contexts -- adding all of them speculatively now, each as its own distinct predicate, would be exactly the kind of premature abstraction this project avoids.",
      "domain": "npo:organization-role",
      "range": "npo:organization",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md"
    },
    {
      "id": "nporel:contributesToImpact",
      "type": "owl:ObjectProperty",
      "label": "contributes to",
      "comment": "An Outcome contributes to a broader or longer-term Impact. Deliberately \"contributes to,\" not \"causes\" -- see Evidence Claim for how a specific causal or contributory interpretation of that contribution is represented and evidenced.",
      "domain": "npo:outcome",
      "range": "npo:impact",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:contributesToOutcome",
      "type": "owl:ObjectProperty",
      "label": "contributes to",
      "comment": "An Output contributes to an intended or observed Outcome. Deliberately \"contributes to,\" not \"causes\" -- see Evidence Claim for how a specific causal or contributory interpretation of that contribution is represented and evidenced.",
      "domain": "npo:output",
      "range": "npo:outcome",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:brokenIntoInstallment",
      "type": "owl:ObjectProperty",
      "label": "is broken into",
      "comment": "A Payment Schedule is broken into Installments.",
      "domain": "npo:payment-schedule",
      "range": "npo:installment",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:affiliatedWith",
      "type": "owl:ObjectProperty",
      "label": "is affiliated with",
      "comment": "A Person is affiliated with an Organization, independent of which specific Person Role(s) they occupy there.",
      "domain": "npo:person",
      "range": "npo:organization",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities"
    },
    {
      "id": "nporel:personPlaysRole",
      "type": "owl:ObjectProperty",
      "label": "plays",
      "comment": "A Person plays one or more Person Roles, each a contextual, independently-scoped occupancy rather than a permanent trait -- mirroring how an Organization plays Organization Roles (rel-organization-plays-role). A distinct predicate rather than a shared `playsRole` because the generator requires every relationship predicate to be globally unique (one fixed subject/object concept pair each); broadening `playsRole` into a real Person-or-Organization union predicate is a generator change deferred to when it's actually needed.",
      "domain": "npo:person",
      "range": "npo:person-role",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities",
      "deprecated": true,
      "isReplacedBy": "nporel:agentPlaysRole"
    },
    {
      "id": "nporel:personRoleAppliesWithin",
      "type": "owl:ObjectProperty",
      "label": "applies within",
      "comment": "A Person Role is scoped to the Organization it was granted within. This is the minimal case needed to make Person Role usable; broadening it to Award, Application, Agreement, and other contexts (matching how Organization Role's own context is broadened) is Phase 3.7 Milestone 2's job -- which will also need to resolve the same predicate-uniqueness constraint noted on personPlaysRole above, likely by generalizing the generator to support a shared predicate across a union of object concepts.",
      "domain": "npo:person-role",
      "range": "npo:organization",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities"
    },
    {
      "id": "nporel:administeredBy",
      "type": "owl:ObjectProperty",
      "label": "is administered by",
      "comment": "A Philanthropic Arrangement is administered by an Organization, such as a fiscal sponsor or fund administrator.",
      "domain": "npo:philanthropic-arrangement",
      "range": "npo:organization",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md"
    },
    {
      "id": "nporel:populationHasClassification",
      "type": "owl:ObjectProperty",
      "label": "has classification",
      "comment": "A Population has one or more Classification Assignments (e.g. Candid PCS Populations) describing its characteristics. Multiple classifications are valid, since a population may have several characteristics at once; the Population resource itself represents the actual contextual group, not a combination of taxonomy terms.",
      "domain": "npo:population",
      "range": "npo:classification-assignment",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#classification"
    },
    {
      "id": "nporel:associatedWithGrantProgram",
      "type": "owl:ObjectProperty",
      "label": "is associated with",
      "comment": "A Program Officer is associated with one or more Grant Programs and typically owns the Review and monitoring relationship for Awards made under them.",
      "domain": "npo:program-officer",
      "range": "npo:grant-program",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#organizational-relationships"
    },
    {
      "id": "nporel:addressesNeed",
      "type": "owl:ObjectProperty",
      "label": "addresses",
      "comment": "A Project addresses one or more identified Needs.",
      "domain": "npo:project",
      "range": "npo:need",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:hasLogicModel",
      "type": "owl:ObjectProperty",
      "label": "has",
      "comment": "A Project has a Logic Model connecting its inputs, activities, outputs, and outcomes.",
      "domain": "npo:project",
      "range": "npo:logic-model",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:hasTheoryOfChange",
      "type": "owl:ObjectProperty",
      "label": "has",
      "comment": "A Project has a Theory of Change articulating how its activities are expected to lead to desired long-term change.",
      "domain": "npo:project",
      "range": "npo:theory-of-change",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:performsActivity",
      "type": "owl:ObjectProperty",
      "label": "performs",
      "comment": "A Project performs one or more Activities.",
      "domain": "npo:project",
      "range": "npo:activity",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:servesPopulation",
      "type": "owl:ObjectProperty",
      "label": "serves",
      "comment": "A Project serves a specific Population, which may or may not be the same Population that experiences the Need it addresses (e.g. a project can serve service providers on behalf of an affected population).",
      "domain": "npo:project",
      "range": "npo:population",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:takesPlaceIn",
      "type": "owl:ObjectProperty",
      "label": "takes place in",
      "comment": "A Project operates within a Geographic Area. Distinct from any organization's registered address -- a project's operating area is not assumed to equal its implementing organization's or grant recipient's mailing address.",
      "domain": "npo:project",
      "range": "npo:geographic-area",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:usesInput",
      "type": "owl:ObjectProperty",
      "label": "uses",
      "comment": "A Project uses Inputs (financial, human, material, or informational resources) to carry out its Activities.",
      "domain": "npo:project",
      "range": "npo:input",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:regrantsTo",
      "type": "owl:ObjectProperty",
      "label": "regrants to",
      "comment": "A Regranting Arrangement regrants funds to a downstream Organization, distinct from the Organization that supplied the funds originally.",
      "domain": "npo:regranting-arrangement",
      "range": "npo:organization",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md"
    },
    {
      "id": "nporel:assessedAgainstLogicModel",
      "type": "owl:ObjectProperty",
      "label": "is assessed against",
      "comment": "Reports are assessed against the project's Logic Model in terms of Outputs and Outcomes.",
      "domain": "npo:report",
      "range": "npo:logic-model",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:assessedAgainstTheoryOfChange",
      "type": "owl:ObjectProperty",
      "label": "is assessed against",
      "comment": "Reports are assessed against the project's Theory of Change in terms of Outputs and Outcomes.",
      "domain": "npo:report",
      "range": "npo:theory-of-change",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:providesEvidence",
      "type": "owl:ObjectProperty",
      "label": "provides",
      "comment": "A Report can itself serve as Evidence supporting an Evidence Claim (e.g. the administrative data or narrative it contains).",
      "domain": "npo:report",
      "range": "npo:evidence",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:fulfilledByReport",
      "type": "owl:ObjectProperty",
      "label": "is fulfilled by",
      "comment": "A Reporting Requirement is fulfilled by a submitted Report. Requirement is what must be supplied; Report is the artifact that was actually supplied.",
      "domain": "npo:reporting-requirement",
      "range": "npo:report",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms"
    },
    {
      "id": "nporel:obligatesReport",
      "type": "owl:ObjectProperty",
      "label": "obligates",
      "comment": "A Reporting Schedule obligates the Grantee to submit Reports on a defined cadence.",
      "domain": "npo:reporting-schedule",
      "range": "npo:report",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:measuredByIndicator",
      "type": "owl:ObjectProperty",
      "label": "is measured by",
      "comment": "A Result (Output, Outcome, or Impact) is measured by an Indicator. Declared against the abstract Result concept rather than each subtype separately, so any Output, Outcome, or Impact instance can be measured the same way.",
      "domain": "npo:result",
      "range": "npo:indicator",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence"
    },
    {
      "id": "nporel:conductedByReviewer",
      "type": "owl:ObjectProperty",
      "label": "is conducted by",
      "comment": "A Review is conducted by one or more Reviewers.",
      "domain": "npo:review",
      "range": "npo:reviewer",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:evaluatedAgainstReviewCriteria",
      "type": "owl:ObjectProperty",
      "label": "is evaluated against",
      "comment": "A Review evaluates an Application against published Review Criteria.",
      "domain": "npo:review",
      "range": "npo:review-criteria",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:mayIncludeSiteVisit",
      "type": "owl:ObjectProperty",
      "label": "may include",
      "comment": "A Review may include a Site Visit before a Decision is made.",
      "domain": "npo:review",
      "range": "npo:site-visit",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:producesDecision",
      "type": "owl:ObjectProperty",
      "label": "produces",
      "comment": "A Review produces a Decision.",
      "domain": "npo:review",
      "range": "npo:decision",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end"
    },
    {
      "id": "nporel:fiscallySponsoredBy",
      "type": "owl:ObjectProperty",
      "label": "is fiscally sponsored by",
      "comment": "A Sponsored Project is fiscally sponsored by an Organization that provides the legal and administrative infrastructure it lacks on its own.",
      "domain": "npo:sponsored-project",
      "range": "npo:organization",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md"
    },
    {
      "id": "npoprop:amendment-effective-date",
      "label": "Effective Date",
      "comment": "When the Amendment's changes take effect.",
      "domain": "npo:amendment",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:date"
    },
    {
      "id": "npoprop:amendment-status",
      "label": "Status",
      "comment": "Where the Amendment stands in its approval process.",
      "domain": "npo:amendment",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "proposed",
        "approved",
        "executed"
      ]
    },
    {
      "id": "npoprop:application-status",
      "label": "Status",
      "comment": "Where the Application currently sits in the review process.",
      "domain": "npo:application",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "draft",
        "submitted",
        "under-review",
        "approved",
        "declined"
      ]
    },
    {
      "id": "npoprop:application-submitted-date",
      "label": "Submitted Date",
      "comment": "When the Application was submitted, once it has been.",
      "domain": "npo:application",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:date"
    },
    {
      "id": "npoprop:approval-requirement-approval-date",
      "label": "Approval Date",
      "comment": "When approval was granted, once it has been.",
      "domain": "npo:approval-requirement",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:date"
    },
    {
      "id": "npoprop:approval-requirement-approval-status",
      "label": "Approval Status",
      "comment": "Where a specific instance of this approval requirement stands.",
      "domain": "npo:approval-requirement",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "not-requested",
        "requested",
        "approved",
        "denied",
        "not-applicable"
      ]
    },
    {
      "id": "npoprop:approval-requirement-approval-threshold",
