      "definition": "Civil rights, civil liberties, and human-rights advocacy."
    },
    {
      "id": "nporef:organization-operating-status",
      "type": "skos:ConceptScheme",
      "prefLabel": "Organization Operating Status",
      "definition": "Whether an Organization is currently operating, independent of any role it holds or arrangement it participates in.",
      "schemeDomain": "organization",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:organization-operating-status-active",
      "type": "skos:Concept",
      "inScheme": "nporef:organization-operating-status",
      "notation": "active",
      "prefLabel": "Active",
      "definition": "The organization is currently operating."
    },
    {
      "id": "nporef:organization-operating-status-dissolved",
      "type": "skos:Concept",
      "inScheme": "nporef:organization-operating-status",
      "notation": "dissolved",
      "prefLabel": "Dissolved",
      "definition": "The organization has formally ceased to exist."
    },
    {
      "id": "nporef:organization-operating-status-merged",
      "type": "skos:Concept",
      "inScheme": "nporef:organization-operating-status",
      "notation": "merged",
      "prefLabel": "Merged",
      "definition": "The organization has combined into another organization and no longer operates independently."
    },
    {
      "id": "nporef:organization-operating-status-unknown",
      "type": "skos:Concept",
      "inScheme": "nporef:organization-operating-status",
      "notation": "unknown",
      "prefLabel": "Unknown",
      "definition": "The organization's current operating status has not been confirmed."
    },
    {
      "id": "nporef:publication-status",
      "type": "skos:ConceptScheme",
      "prefLabel": "Publication Status",
      "definition": "The lifecycle state of a reference-data scheme itself -- whether it's still being drafted, actively governing one or more properties, or deprecated in favor of something else. Distinct from a single value's own `deprecated` flag: a scheme can stay published while one of its values is retired.",
      "schemeDomain": "reference-data-governance",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:publication-status-deprecated",
      "type": "skos:Concept",
      "inScheme": "nporef:publication-status",
      "notation": "deprecated",
      "prefLabel": "Deprecated",
      "definition": "The scheme is no longer recommended for new use, though existing data may still reference its values."
    },
    {
      "id": "nporef:publication-status-draft",
      "type": "skos:Concept",
      "inScheme": "nporef:publication-status",
      "notation": "draft",
      "prefLabel": "Draft",
      "definition": "The scheme is still being defined and does not yet constrain any concept property."
    },
    {
      "id": "nporef:publication-status-published",
      "type": "skos:Concept",
      "inScheme": "nporef:publication-status",
      "notation": "published",
      "prefLabel": "Published",
      "definition": "The scheme is stable and in active use, constraining one or more concept properties."
    },
    {
      "id": "nporef:restriction-type",
      "type": "skos:ConceptScheme",
      "prefLabel": "Restriction Type",
      "definition": "A Fund's accounting restriction status -- whether its use is constrained by the donor, and if so, how. `donor-restricted` is the broader designation covering both time-limited and perpetual donor restrictions; `temporarily-restricted` and `permanently-restricted` narrow it to which kind.",
      "schemeDomain": "financial",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:restriction-type-donor-restricted",
      "type": "skos:Concept",
      "inScheme": "nporef:restriction-type",
      "notation": "donor-restricted",
      "prefLabel": "Donor-Restricted",
      "definition": "The fund's use is constrained by the donor, without specifying here whether the constraint is time-limited or perpetual."
    },
    {
      "id": "nporef:restriction-type-permanently-restricted",
      "type": "skos:Concept",
      "inScheme": "nporef:restriction-type",
      "notation": "permanently-restricted",
      "prefLabel": "Permanently Restricted",
      "definition": "The fund's donor-imposed restriction never expires.",
      "broader": "nporef:restriction-type-donor-restricted"
    },
    {
      "id": "nporef:restriction-type-temporarily-restricted",
      "type": "skos:Concept",
      "inScheme": "nporef:restriction-type",
      "notation": "temporarily-restricted",
      "prefLabel": "Temporarily Restricted",
      "definition": "The fund's donor-imposed restriction expires after a specific time or purpose is satisfied.",
      "broader": "nporef:restriction-type-donor-restricted"
    },
    {
      "id": "nporef:restriction-type-unrestricted",
      "type": "skos:Concept",
      "inScheme": "nporef:restriction-type",
      "notation": "unrestricted",
      "prefLabel": "Unrestricted",
      "definition": "The fund carries no donor-imposed restriction on its use."
    },
    {
      "id": "nporef:role-status",
      "type": "skos:ConceptScheme",
      "prefLabel": "Role Status",
      "definition": "Where a Role occupancy currently sits in its own lifecycle, shared by every person-role and organization-role subtype via the role concept's inherited `status` property.",
      "schemeDomain": "role",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:role-status-active",
      "type": "skos:Concept",
      "inScheme": "nporef:role-status",
      "notation": "active",
      "prefLabel": "Active",
      "definition": "The role occupancy is currently in effect."
    },
    {
      "id": "nporef:role-status-cancelled",
      "type": "skos:Concept",
      "inScheme": "nporef:role-status",
      "notation": "cancelled",
      "prefLabel": "Cancelled",
      "definition": "The role occupancy was called off before or without reaching its expected conclusion."
    },
    {
      "id": "nporef:role-status-ended",
      "type": "skos:Concept",
      "inScheme": "nporef:role-status",
      "notation": "ended",
      "prefLabel": "Ended",
      "definition": "The role occupancy concluded as expected, e.g. at its effectiveTo date."
    },
    {
      "id": "nporef:role-status-planned",
      "type": "skos:Concept",
      "inScheme": "nporef:role-status",
      "notation": "planned",
      "prefLabel": "Planned",
      "definition": "The role occupancy has been agreed but has not yet started."
    },
    {
      "id": "nporef:role-status-suspended",
      "type": "skos:Concept",
      "inScheme": "nporef:role-status",
      "notation": "suspended",
      "prefLabel": "Suspended",
      "definition": "The role occupancy is temporarily paused without having formally ended."
    },
    {
