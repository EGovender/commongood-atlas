    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>tax-exempt-501c3</npo:allowedValue>
    <npo:allowedValue>tax-exempt-other</npo:allowedValue>
    <npo:allowedValue>taxable</npo:allowedValue>
    <npo:allowedValue>government-exempt</npo:allowedValue>
    <npo:allowedValue>unknown</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/output-unit">
    <rdfs:label>Unit</rdfs:label>
    <rdfs:comment>The unit the Output is counted in, e.g. "workshops" or "people served".</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/output" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-amount">
    <rdfs:label>Amount</rdfs:label>
    <rdfs:comment>The actual amount transferred in this Payment.</rdfs:comment>
