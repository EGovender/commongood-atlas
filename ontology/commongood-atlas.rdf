    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-condition-condition-type">
    <rdfs:label>Condition Type</rdfs:label>
    <rdfs:comment>What kind of condition must be satisfied before the corresponding Payment is released.</rdfs:comment>
