<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:dcterms="http://purl.org/dc/terms/" xmlns:npo="https://egovender.github.io/commongood-atlas/ontology/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#">
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <rdfs:label>CommonGood Atlas Grantmaking Ontology</rdfs:label>
    <rdfs:comment>Generated from ontology/source/*.json. Do not hand-edit. See docs/05-data-model.md and docs/06-properties-and-rules.md.</rdfs:comment>
    <npo:version>0.3.0</npo:version>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Activity</rdfs:label>
    <skos:definition>A defined action or body of work performed by a Project to produce Outputs and contribute toward intended Outcomes.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Agent</rdfs:label>
    <skos:definition>An entity capable of participating in an activity, relationship, decision, transaction, or role. Person and Organization are its two subtypes.</skos:definition>
    <npo:category>cross-cutting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#cross-cutting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/amendment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Amendment</rdfs:label>
    <skos:definition>A formally agreed change to an existing grant agreement's terms, budget, timeline, or amount, made after the original agreement was signed.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <skos:altLabel>Grant Amendment</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/applicant-contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Applicant Contact</rdfs:label>
    <skos:definition>The role a person occupies when they serve as the primary point of contact for an application submitted on behalf of an organization or project.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/application">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Application</rdfs:label>
    <skos:definition>A grantee's formal submission requesting funding under a specific funding opportunity, including a proposal narrative and budget.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#application-and-review" />
    <skos:altLabel>Grant Application</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/approval-requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Approval Requirement</rdfs:label>
    <skos:definition>A Grant Term requiring authorization from the funder or another specified party before a defined change, expenditure, action, or deviation may occur (e.g., prior written approval for a budget reallocation above a threshold). Not automatically a Grant Condition -- an approval requirement may simply govern administration of the Award.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/audit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Audit</rdfs:label>
    <skos:definition>A formal, independent examination of a grantee's financial records, either as a general organizational requirement or specific to a grant.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/authorized-signatory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Authorized Signatory</rdfs:label>
    <skos:definition>The role a person occupies when they are authorized to sign a grant agreement or other governing document on behalf of an organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/award">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Award</rdfs:label>
    <skos:definition>A funder's formal commitment to provide a specific amount of funding to a grantee, following an approved application or decision.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <skos:altLabel>Grant Award</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/board-member">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Board Member</rdfs:label>
    <skos:definition>The role a person occupies when they serve on an organization's governing board.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/budget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Budget</rdfs:label>
    <skos:definition>A structured estimate of costs associated with a proposed or funded project, broken into categories (e.g., personnel, overhead, direct program costs).</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/budget-modification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Budget Modification</rdfs:label>
    <skos:definition>A grantee-requested, funder-approved change to how awarded funds are allocated across budget categories, without changing the total award amount.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/classification-assignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Classification Assignment</rdfs:label>
    <skos:definition>A contextual assertion that a resource (e.g. an Award or Population) is classified by a concept from a specified external or internal classification scheme, such as Candid's Philanthropy Classification System. External taxonomies classify CommonGood resources; they do not define those resources -- Need, Population, and Organization remain the ontology's own entities regardless of which taxonomy terms are assigned to them.</skos:definition>
    <npo:category>cross-cutting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#cross-cutting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/closeout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Closeout</rdfs:label>
    <skos:definition>The formal conclusion of a grant award once all funds are disbursed, all reports are submitted and accepted, and all compliance requirements are satisfied.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/collaborative-fund-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Collaborative Fund Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which multiple funders pool resources into a shared Fund and jointly direct or oversee its grantmaking.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Compliance Requirement</rdfs:label>
    <skos:definition>An obligation attached to an award that the grantee must satisfy to remain in good standing (e.g., timely reporting, allowable use of funds, insurance).</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/consultant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Consultant</rdfs:label>
    <skos:definition>The role a person occupies when they provide paid, defined-scope services to an organization without being its employee.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/contractor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Contractor</rdfs:label>
    <skos:definition>The role an organization occupies when it is bound by a contract to deliver a specific, defined piece of work for another organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/decision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Decision</rdfs:label>
    <skos:definition>A recorded determination concerning an application following review or another authorized approval process. Its outcome (approved, declined, or approved with conditions) is carried by the decisionOutcome property, not by the Decision entity's identity itself.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/donor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor</rdfs:label>
    <skos:definition>The role a person occupies when they contribute charitable funds to an organization or fund, without necessarily holding advisory privileges over how they are used.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/donor-advised-fund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor-Advised Fund</rdfs:label>
    <skos:definition>A Fund held by a sponsoring organization, over which a Donor Advisor holds non-binding privileges to recommend grants and investments.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
    <skos:altLabel>DAF</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <npo:legalNote>Donor-advised funds are subject to specific federal tax rules (e.g., IRC 4966-4967) governing what a donor advisor may and may not direct. This ontology models the general shape of the relationship, not compliance with those rules.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/donor-advised-fund-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor-Advised Fund Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which a Donor Advisor holds non-binding advisory privileges over grants made from a Donor-Advised Fund.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <npo:legalNote>The specific privileges and limits granted to a donor advisor are set by the sponsoring organization's own policies and by tax law, not by this ontology -- consult counsel before using this model as a compliance reference.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/donor-advisor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Donor Advisor</rdfs:label>
    <skos:definition>The role a person occupies when they hold non-binding privileges to recommend grants and investments from a Donor-Advised Fund, typically as the fund's original donor.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
    <npo:legalNote>A donor advisor's privileges are non-binding as a matter of federal tax law, not just convention -- treating a recommendation as a binding instruction can jeopardize the sponsoring organization's tax-exempt status.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/eligibility-criteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Eligibility Criteria</rdfs:label>
    <skos:definition>The conditions an organization or project must meet to apply to a funding opportunity.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/employee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Employee</rdfs:label>
    <skos:definition>The role a person occupies when they work for and are compensated by an organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/employer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Employer</rdfs:label>
    <skos:definition>The role an organization occupies when it employs a person -- the organization-side counterpart to that person's Employee role.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/evaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Evaluation</rdfs:label>
    <skos:definition>A structured assessment of whether a grant-funded project achieved its intended outputs and outcomes.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Evidence</rdfs:label>
    <skos:definition>Information used to support, weaken, qualify, or contextualize a claim about a Project, Activity, Result, or other entity (e.g., an evaluation report, survey results, administrative data, a case study).</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/evidence-claim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Evidence Claim</rdfs:label>
    <skos:definition>A sourced assertion about a relationship, condition, result, or causal interpretation whose evidentiary basis can be independently identified. This is where a specific interpretation of a Project's contribution to a Result -- association, contribution, attribution, or causation -- is represented, distinct from the Result itself and from the Evidence supporting the claim.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/fiscal-sponsor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Fiscal Sponsor</rdfs:label>
    <skos:definition>The role an organization occupies when it provides the legal and administrative infrastructure that lets another entity or project receive charitable funding on its behalf.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
    <npo:legalNote>Fiscal sponsorship arrangements vary significantly in legal structure (e.g., comprehensive/"Model A" vs. pre-approved grant relationship/"Model C"), which affects liability, employment, and asset ownership very differently. Consult counsel before relying on this model to characterize a specific arrangement.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/fiscal-sponsorship-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Fiscal Sponsorship Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which a Fiscal Sponsor accepts and administers charitable funds on behalf of a Sponsored Project that lacks independent legal status to receive them directly.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <npo:legalNote>The rights and obligations created by a fiscal sponsorship agreement depend heavily on its specific model (e.g., comprehensive vs. pre-approved grant relationship). Consult counsel and the actual governing agreement rather than this ontology.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/fund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Fund</rdfs:label>
    <skos:definition>A designated pool of financial resources set aside for a purpose, distinct from the grant program or strategy that directs how it's used.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/funder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funder</rdfs:label>
    <skos:definition>The role an organization occupies when it provides funding to grantees through grant programs and awards.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <skos:altLabel>Grantmaker</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/funding-cycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funding Cycle</rdfs:label>
    <skos:definition>A recurring period (e.g., quarterly, annual) within a grant program during which applications are accepted and decided.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/funding-intermediary-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funding Intermediary Role</rdfs:label>
    <skos:definition>The role an organization occupies when it channels funds between an original funding source and an ultimate grantee, without itself being the original funder or the final recipient.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Funding Opportunity</rdfs:label>
    <skos:definition>A specific, time-bound invitation to apply for funding under a grant program, with defined eligibility, focus area, and deadlines.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
    <skos:altLabel>NOFO</skos:altLabel>
    <skos:altLabel>Notice of Funding Opportunity</skos:altLabel>
    <skos:altLabel>RFP</skos:altLabel>
    <skos:altLabel>Request for Proposals</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/geographic-area">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Geographic Area</rdfs:label>
    <skos:definition>A geographic entity used to describe where a Need exists, where a Project operates, where a Population is located, or where a Result is observed.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grant-administrator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Administrator</rdfs:label>
    <skos:definition>The role a person occupies when they are responsible for compliance, reporting, and financial management of an award on behalf of the grantee organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grant-agreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Agreement</rdfs:label>
    <skos:definition>The legal document, signed by both funder and grantee, that formalizes an award's terms, conditions, and obligations.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grant-condition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Condition</rdfs:label>
    <skos:definition>A Grant Term establishing a barrier, milestone, event, requirement, or other criterion that must be satisfied for grant entitlement, payment, continuation, release, or retention. Matching Requirement and Payment Condition are its existing concrete subtypes. A condition's barrier facts (e.g. hasBarrier, threshold) are captured here without the ontology itself making the accounting or legal determination of whether the grant is "conditional".</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grant-lifecycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Lifecycle</rdfs:label>
    <skos:definition>The end-to-end sequence a grant moves through, from funding opportunity through application, review, award, disbursement, reporting, and closeout.</skos:definition>
    <npo:category>cross-cutting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#cross-cutting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grant-program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Program</rdfs:label>
    <skos:definition>A funder's standing area of giving (e.g., "Environmental Justice Grants"), under which funding opportunities are issued over time.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Recommendation</rdfs:label>
    <skos:definition>A Donor Advisor's non-binding request that a Donor-Advised Fund make an award to a specific recipient; the fund's sponsoring organization retains final authority to accept or decline it.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#application-and-review" />
    <npo:legalNote>A Grant Recommendation's non-binding status is a legal requirement for donor-advised funds under federal tax law, not a design choice -- see Donor-Advised Fund and Donor Advisor.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grant-term">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grant Term</rdfs:label>
    <skos:definition>A provision associated with a Grant Agreement or Award that establishes a restriction, condition, obligation, approval requirement, reporting requirement, or other requirement governing the use, administration, performance, or continuation of grant funding. Preserves its original source wording (via originalTermText) alongside its normalized classification -- the classification is an interpretation of the source text, not a replacement for it.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/grantee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Grantee</rdfs:label>
    <skos:definition>The role an organization occupies when it receives and administers grant funding awarded by a funder.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <skos:altLabel>Recipient</skos:altLabel>
    <skos:altLabel>Subrecipient</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/impact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Impact</rdfs:label>
    <skos:definition>A broader or longer-term change to which one or more Outcomes may contribute. An Impact relationship does not itself imply that the Project has been demonstrated to cause the change.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/result" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/indicator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Indicator</rdfs:label>
    <skos:definition>A defined measure used to assess the state or change of a Result (e.g., percentage of participants employed after six months, graduation rate).</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/indirect-cost-rate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Indirect Cost Rate</rdfs:label>
    <skos:definition>The negotiated or de minimis rate at which a grantee may charge overhead/administrative costs against an award.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/input">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Input</rdfs:label>
    <skos:definition>A financial, human, material, informational, or other resource used in carrying out an Activity.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/installment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Installment</rdfs:label>
    <skos:definition>A single scheduled portion of an award's total funds, to be disbursed at a defined point or upon meeting a condition.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/letter-of-inquiry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Letter of Inquiry</rdfs:label>
    <skos:definition>A brief, preliminary submission used by some funders to screen interest before inviting a full application.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#application-and-review" />
    <skos:altLabel>LOI</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/logic-model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Logic Model</rdfs:label>
    <skos:definition>A structured diagram connecting a project's inputs, activities, outputs, and outcomes, used to plan and evaluate a grant-funded project.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/matching-requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Matching Requirement</rdfs:label>
    <skos:definition>A condition requiring the grantee to raise or contribute additional funds alongside the award, often as a ratio (e.g., 1:1 match).</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/measurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Measurement</rdfs:label>
    <skos:definition>An observed value for an Indicator at a particular time and, where relevant, for a defined Population or Geographic Area. Never treated as interchangeable with a Target: a Target is planned, a Measurement is observed.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/need">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Need</rdfs:label>
    <skos:definition>A condition, problem, gap, or opportunity identified as warranting intervention or investment.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Organization</rdfs:label>
    <skos:definition>Any legal entity participating in grantmaking or philanthropy. An organization occupies one or more contextual roles (see Organization Role) rather than being permanently classified as a funder or a recipient.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/agent" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/organization-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Organization Role</rdfs:label>
    <skos:definition>A contextual capacity an organization occupies within a specific arrangement or award -- such as acting as a funder, grant recipient, or fiscal sponsor -- rather than a permanent trait of the organization itself.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/organization-type">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Organization Type</rdfs:label>
    <skos:definition>The legal and tax classification of what an organization fundamentally is (e.g., a public charity, private foundation, or government entity), independent of any role it plays in a specific relationship.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/outcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Outcome</rdfs:label>
    <skos:definition>A change in condition, behavior, knowledge, capacity, practice, or status that is intended or observed in association with a Project or Activity, distinct from a direct Output. A recorded Outcome does not by itself establish that the Project caused it -- see Evidence Claim for how a specific causal or contributory interpretation is represented and evidenced.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/result" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/output">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Output</rdfs:label>
    <skos:definition>A direct product, service, deliverable, or immediate consequence of Activities carried out by a Project (e.g., number of workshops held, people served). Does not itself imply any broader behavioral or social change.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/result" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/partner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Partner</rdfs:label>
    <skos:definition>The role an organization occupies when it collaborates with another organization on shared work, in a relationship not adequately described as one party purchasing from or providing a service to the other.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/payment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Payment</rdfs:label>
    <skos:definition>An actual transfer of funds from funder to grantee against an award, corresponding to one or more installments.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/payment-condition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Payment Condition</rdfs:label>
    <skos:definition>A requirement (e.g., a submitted report, a milestone reached) that must be satisfied before a scheduled payment is released.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#disbursement" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/payment-schedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Payment Schedule</rdfs:label>
    <skos:definition>The agreed timing and amounts by which award funds will be disbursed to the grantee.</skos:definition>
    <npo:category>disbursement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#disbursement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Person</rdfs:label>
    <skos:definition>A natural person who participates in nonprofit, philanthropic, governance, employment, advisory, or service relationships.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <skos:altLabel>Individual</skos:altLabel>
    <skos:altLabel>Natural Person</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/agent" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/person-role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Person Role</rdfs:label>
    <skos:definition>A contextual capacity a person occupies within an organization, award, application, agreement, arrangement, program, project, or other defined context.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Philanthropic Arrangement</rdfs:label>
    <skos:definition>A structured relationship among organizations that channels philanthropic funding outside a direct funder-to-grantee award -- such as a fiscal sponsorship or donor-advised fund arrangement.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/philanthropic-intermediary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Philanthropic Intermediary</rdfs:label>
    <skos:definition>An organization commonly known for facilitating philanthropy on behalf of others -- such as by re-granting, fiscal sponsorship, or hosting donor-advised funds -- regardless of which specific role it occupies in a given arrangement.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/population">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Population</rdfs:label>
    <skos:definition>A group of people defined by demographic, geographic, institutional, experiential, or other characteristics relevant to a Need, Project, Result, or Evaluation.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/program-officer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Program Officer</rdfs:label>
    <skos:definition>The role a person occupies when they manage a portfolio of grants on behalf of a funder, from soliciting or reviewing applications through monitoring active awards.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Project</rdfs:label>
    <skos:definition>A defined body of work undertaken over a period of time to address one or more needs or objectives -- the work being performed, distinct from the Application requesting funding for it or the Award committing funding to it.</skos:definition>
    <npo:category>cross-cutting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#cross-cutting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/regranting-arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Regranting Arrangement</rdfs:label>
    <skos:definition>A Philanthropic Arrangement in which an organization receives funds and redistributes them to other organizations, acting as both a Grantee to the original source and a Funder or Funding Intermediary to the recipients.</skos:definition>
    <npo:category>funding-structure</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#funding-structure" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <npo:legalNote>Regranting to organizations without their own tax-exempt status (or across borders) can trigger expenditure-responsibility or equivalency-determination requirements under U.S. tax law. This ontology does not model those compliance steps.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/report">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Report</rdfs:label>
    <skos:definition>A grantee's submission to the funder describing progress, outcomes, and/or use of funds, per the reporting schedule. Narrative and financial reports are common subtypes.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reporting-requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Reporting Requirement</rdfs:label>
    <skos:definition>A Grant Term requiring submission of information concerning grant activities, finances, progress, outputs, outcomes, compliance, or closeout. Finer-grained than a Reporting Schedule (which sets the overall cadence for an award): one clause such as "quarterly programmatic and financial reports are required" normalizes into two Reporting Requirements, one per report type, each of which may be fulfilledBy a submitted Report.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reporting-schedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Reporting Schedule</rdfs:label>
    <skos:definition>The agreed cadence and due dates for narrative and financial reports over the life of an award.</skos:definition>
    <npo:category>compliance-and-reporting</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#compliance-and-reporting" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/restricted-funding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Restricted Funding</rdfs:label>
    <skos:definition>Funding that must be used for a specific purpose, project, or time period defined in the grant agreement. Deprecated: prefer Fund's restrictionType property, backed by the restriction-type reference scheme, for new data -- retained for backward compatibility.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <owl:deprecated>true</owl:deprecated>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/result">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Result</rdfs:label>
    <skos:definition>A planned or observed state, product, change, or effect associated with an intervention. Output, Outcome, and Impact are its three subtypes, distinguished by directness and time horizon.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/review">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Review</rdfs:label>
    <skos:definition>The process of evaluating an application, producing a recommendation and often a score, conducted by one or more reviewers.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/review-criteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Review Criteria</rdfs:label>
    <skos:definition>The published or internal standards (e.g., alignment with mission, feasibility, budget reasonableness) against which applications are scored.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reviewer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Reviewer</rdfs:label>
    <skos:definition>The role a person occupies when they evaluate an application against review criteria, whether as staff, a board member, or an external peer reviewer.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Role</rdfs:label>
    <skos:definition>A contextual capacity an agent occupies, distinct from the agent's permanent identity or classification.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/service-provider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Service Provider</rdfs:label>
    <skos:definition>The role an organization occupies when it provides an ongoing operational service to another organization -- broader and less transactional than a single Contractor engagement or Vendor purchase.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/site-visit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Site Visit</rdfs:label>
    <skos:definition>An optional step where a funder representative visits or meets with an applicant to assess capacity or verify claims before a decision.</skos:definition>
    <npo:category>application-and-review</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#application-and-review" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/sponsored-project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Sponsored Project</rdfs:label>
    <skos:definition>A project or group carrying out charitable activity under a Fiscal Sponsor's legal and administrative umbrella, without being itself an independent Organization.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <npo:legalNote>Whether a sponsored project's activities, staff, and liabilities legally belong to the fiscal sponsor depends entirely on the specific fiscal sponsorship model in use. This ontology does not distinguish between models -- consult the governing agreement.</npo:legalNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/sponsoring-organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Sponsoring Organization</rdfs:label>
    <skos:definition>The role an organization occupies when it holds and administers a Fund on behalf of the fund's donor or benefactors, distinct from acting as a Fiscal Sponsor for a specific project.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/target">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Target</rdfs:label>
    <skos:definition>A planned value for an Indicator expected to be reached by a defined point in time.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/terms-and-conditions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Terms and Conditions</rdfs:label>
    <skos:definition>The specific obligations, restrictions, and expectations attached to an award (e.g., allowable uses of funds, reporting requirements). Its own restrictionType property is a coarse restricted/unrestricted flag, superseded for new data by the structured Use Restriction model (see Grant Term) -- retained for backward compatibility.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/theory-of-change">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Theory of Change</rdfs:label>
    <skos:definition>A grantee's or funder's articulated model of how specific activities are expected to lead to desired long-term change.</skos:definition>
    <npo:category>outcomes-and-closeout</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#outcomes-and-closeout" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/unrestricted-funding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Unrestricted Funding</rdfs:label>
    <skos:definition>Funding a grantee may use at its discretion in support of its general mission. Deprecated: prefer Fund's restrictionType property, backed by the restriction-type reference scheme, for new data -- retained for backward compatibility.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <owl:deprecated>true</owl:deprecated>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/use-restriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Use Restriction</rdfs:label>
    <skos:definition>A Grant Term limiting the purposes, activities, populations, geographies, time periods, cost categories, or other uses for which grant resources may be applied. Governs permitted use -- distinct from a Grant Condition, which governs whether some entitlement, payment, or continuation becomes effective.</skos:definition>
    <npo:category>award-and-agreement</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#award-and-agreement" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/vendor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:label>Vendor</rdfs:label>
    <skos:definition>The role an organization occupies when it is the source from which another organization purchases standard goods or services, without a defined-work contract the way a Contractor has.</skos:definition>
    <npo:category>organizational-entities</npo:category>
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <rdfs:subClassOf rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/producesOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>produces</rdfs:label>
    <rdfs:comment>An Activity produces one or more Outputs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/activity" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/output" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/agentPlaysRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>plays</rdfs:label>
    <rdfs:comment>An Agent (Person or Organization) plays one or more Roles. The preferred predicate for new data now that Agent exists as a shared superclass, replacing the separate playsRole (Organization) and personPlaysRole (Person) predicates -- both kept and still valid on existing data, not migrated, per this project's policy of never deleting or force-migrating published predicates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/agent" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/role" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/modifiesGrantAgreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>modifies</rdfs:label>
    <rdfs:comment>An Amendment changes the Grant Agreement going forward; it does not retroactively alter Payments or Reports already completed under the prior terms.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/amendment" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/includesBudget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>An Application includes a proposed Budget.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/budget" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/proposesProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>proposes</rdfs:label>
    <rdfs:comment>An Application proposes the Project it is requesting funding for. The Application is the request; the Project is the work being proposed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/respondsToFundingOpportunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>responds to</rdfs:label>
    <rdfs:comment>An Application is submitted in response to a specific Funding Opportunity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/undergoesReview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>undergoes</rdfs:label>
    <rdfs:comment>An Application undergoes Review by one or more Reviewers.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/review" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/requiresApprovalFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>requires approval from</rdfs:label>
    <rdfs:comment>An Approval Requirement identifies the Agent whose authorization is required before the governed change, expenditure, action, or deviation may occur -- typically the Funder.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/approval-requirement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/agent" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/awardedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is awarded by</rdfs:label>
    <rdfs:comment>An Award is awarded by an Organization -- the original source of the funding, which may differ from the organization that administers it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/awardedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is awarded to</rdfs:label>
    <rdfs:comment>An Award is awarded to an Organization -- the ultimate recipient, which may differ from the organization managing compliance on its behalf.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/followsGrantLifecycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>follows</rdfs:label>
    <rdfs:comment>An Award's progression from decision through closeout follows the Grant Lifecycle sequence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-lifecycle" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/formalizedByGrantAgreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is formalized by</rdfs:label>
    <rdfs:comment>An Award is formalized by a Grant Agreement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/fundedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is funded from</rdfs:label>
    <rdfs:comment>An Award draws its funds from a specific Fund.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/fundsProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>funds</rdfs:label>
    <rdfs:comment>An Award commits funding to a Project. The Award is the funding commitment; the Project is the work performed using it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/awardHasClassification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has classification</rdfs:label>
    <rdfs:comment>An Award has one or more Classification Assignments (e.g. Candid PCS Subjects) drawn from an external or internal classification scheme. The scheme classifies the Award; it does not redefine it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#classification" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/hasPaymentSchedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has</rdfs:label>
    <rdfs:comment>An Award's funds are released according to a Payment Schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment-schedule" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/managedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is administered by</rdfs:label>
    <rdfs:comment>An Award may be administered day-to-day by an Organization other than the one that awarded or received it, such as a fiscal sponsor or intermediary.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/reachesCloseout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>reaches</rdfs:label>
    <rdfs:comment>Once all Payments are disbursed and all Compliance Requirements are satisfied, the Award reaches Closeout.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/closeout" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/pools">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>pools</rdfs:label>
    <rdfs:comment>A Collaborative Fund Arrangement pools multiple funders' contributions into a shared Fund.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/collaborative-fund-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/appliesToAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies to</rdfs:label>
    <rdfs:comment>A Compliance Requirement applies to a specific Award -- distinct from the Grant Agreement specifying it: the Agreement is the document that spells out the requirement, while this relationship tracks which Award it actually binds. The same organization can be in good standing on one award and delinquent on another, so the requirement must attach to the Award, not the Grantee in the abstract.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/includesReportingSchedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>A Compliance Requirement includes a Reporting Schedule that obligates the Grantee to submit Reports.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reporting-schedule" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/mayIncludeAudit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may include</rdfs:label>
    <rdfs:comment>A Compliance Requirement may include an Audit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/audit" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/resultsInAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>results in</rdfs:label>
    <rdfs:comment>An approved Decision results in an Award.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/decision" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/governs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>governs</rdfs:label>
    <rdfs:comment>A Donor-Advised Fund Arrangement governs the specific Donor-Advised Fund it establishes the advisory relationship for.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/donor-advised-fund-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/donor-advised-fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/advises">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>advises</rdfs:label>
    <rdfs:comment>A Donor Advisor advises a specific Donor-Advised Fund, holding non-binding privileges to recommend its grants and investments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/donor-advisor" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/donor-advised-fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/makesRecommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>makes</rdfs:label>
    <rdfs:comment>A Donor Advisor makes a Grant Recommendation requesting that their Donor-Advised Fund make an award.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/donor-advisor" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/assessesOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>assesses</rdfs:label>
    <rdfs:comment>An Evaluation assesses whether a grant-funded project achieved its intended Outcomes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evaluation" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/outcome" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/assessesOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>assesses</rdfs:label>
    <rdfs:comment>An Evaluation assesses whether a grant-funded project achieved its intended Outputs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evaluation" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/output" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/evaluatesProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>evaluates</rdfs:label>
    <rdfs:comment>An Evaluation assesses a Project.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evaluation" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/producesEvidenceClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>produces</rdfs:label>
    <rdfs:comment>An Evaluation produces one or more Evidence Claims.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evaluation" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evidence-claim" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/aboutResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is about</rdfs:label>
    <rdfs:comment>An Evidence Claim is about a Result. Declared against the abstract Result concept rather than each subtype separately, so a claim can concern any Output, Outcome, or Impact instance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evidence-claim" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/result" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/supportedByEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is supported by</rdfs:label>
    <rdfs:comment>An Evidence Claim is supported by one or more pieces of Evidence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evidence-claim" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evidence" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/actsOnBehalfOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>acts on behalf of</rdfs:label>
    <rdfs:comment>A Fiscal Sponsor stands in for a Grantee that lacks independent legal status to receive an Award directly.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fiscal-sponsor" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grantee" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/supports">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>supports</rdfs:label>
    <rdfs:comment>A Fiscal Sponsorship Arrangement supports a specific Sponsored Project carried out under the fiscal sponsor's umbrella.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fiscal-sponsorship-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/sponsored-project" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/heldBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is held by</rdfs:label>
    <rdfs:comment>A Fund is held and administered by an Organization.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/maintainsGrantProgram">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>maintains</rdfs:label>
    <rdfs:comment>A Funder maintains one or more Grant Programs, each of which issues Funding Opportunities over time.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funder" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-program" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/mayRequireLetterOfInquiry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may require</rdfs:label>
    <rdfs:comment>A Funding Opportunity may require a Letter of Inquiry before a full Application is invited.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/letter-of-inquiry" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/occursDuringFundingCycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>occurs during</rdfs:label>
    <rdfs:comment>A Funding Opportunity is issued within a defined Funding Cycle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-cycle" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/specifiesEligibilityCriteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>specifies</rdfs:label>
    <rdfs:comment>A Funding Opportunity specifies the Eligibility Criteria an applicant must meet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/eligibility-criteria" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/responsibleForComplianceRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is responsible for</rdfs:label>
    <rdfs:comment>A Grant Administrator is typically responsible for tracking Compliance Requirements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-administrator" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/responsibleForReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is responsible for</rdfs:label>
    <rdfs:comment>A Grant Administrator is typically responsible for Report submission.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-administrator" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/attachesComplianceRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>attaches</rdfs:label>
    <rdfs:comment>A Grant Agreement attaches Compliance Requirements, including a Reporting Schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/mayIncludeMatchingRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may include</rdfs:label>
    <rdfs:comment>A Grant Agreement may include a Matching Requirement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/matching-requirement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/maySpecifyRestrictedFunding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may specify</rdfs:label>
    <rdfs:comment>A Grant Agreement's Terms and Conditions may classify the award as Restricted Funding.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/restricted-funding" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/maySpecifyUnrestrictedFunding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may specify</rdfs:label>
    <rdfs:comment>A Grant Agreement's Terms and Conditions may classify the award as Unrestricted Funding.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/unrestricted-funding" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/specifiesGrantTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>specifies</rdfs:label>
    <rdfs:comment>A Grant Agreement specifies one or more Grant Terms. Declared against the abstract Grant Term concept rather than each subtype separately, so any Use Restriction, Grant Condition, Approval Requirement, Reporting Requirement, Compliance Requirement, or Reporting Schedule instance satisfies it the same way.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/specifiesTermsAndConditions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>specifies</rdfs:label>
    <rdfs:comment>A Grant Agreement specifies Terms and Conditions, including whether funding is restricted or unrestricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/terms-and-conditions" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/hasConditionResponsibleParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has responsible party</rdfs:label>
    <rdfs:comment>A Grant Condition optionally identifies the Agent (Person or Organization) responsible for satisfying it -- e.g. the grantee organization for a matching requirement, or a fiscal sponsor rather than the project itself.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/agent" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/fundedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is funded by</rdfs:label>
    <rdfs:comment>A Grant Program is funded by a Fund -- the pool of financial resources backing the program's giving strategy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-program" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/issuesFundingOpportunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>issues</rdfs:label>
    <rdfs:comment>A Grant Program issues Funding Opportunities during defined Funding Cycles.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-program" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/concernsFund">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>concerns</rdfs:label>
    <rdfs:comment>A Grant Recommendation concerns a specific Fund -- ordinarily a Donor-Advised Fund -- that would pay for the recommended award.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/leadsToAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>leads to</rdfs:label>
    <rdfs:comment>A Grant Recommendation the sponsoring organization accepts leads to an Award, mirroring how a Decision results in an Award in the direct-grant path.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/recommendsRecipient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>recommends</rdfs:label>
    <rdfs:comment>A Grant Recommendation recommends a specific Organization as the award's recipient.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/grantTermAppliesToAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies to</rdfs:label>
    <rdfs:comment>A Grant Term applies to a specific Award. Declared against the abstract Grant Term concept, used by Use Restriction, Grant Condition, Approval Requirement, and Reporting Requirement instances -- Compliance Requirement keeps its own existing, more specific appliesToAward predicate unchanged, and Matching Requirement/Payment Condition/Reporting Schedule are already reachable from Award through their existing relationships, so none of those three need this one too.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/mayRequestBudgetModification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may request</rdfs:label>
    <rdfs:comment>Over the life of an Award, the Grantee may request a Budget Modification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grantee" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/budget-modification" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/submitsApplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>submits</rdfs:label>
    <rdfs:comment>A Grantee (or a project operating under a Fiscal Sponsor) submits an Application in response to a Funding Opportunity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grantee" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/hasMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has</rdfs:label>
    <rdfs:comment>An Indicator has one or more Measurements -- the observed values recorded over time. Never equated with the Indicator's Target: a Target is planned, a Measurement is observed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indicator" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/measurement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/hasTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has</rdfs:label>
    <rdfs:comment>An Indicator has a Target -- the planned value expected by a defined date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indicator" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/target" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/indirectCostRateAppliesToAward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies to</rdfs:label>
    <rdfs:comment>An Indirect Cost Rate applies to a specific Award -- the rate itself may be negotiated at the organization level (independent of any one award), but this relationship tracks which Award's budget it is actually being charged against, mirroring why Compliance Requirement's own appliesToAward attaches to a specific Award rather than the Grantee in the abstract: the same organization can have a different applicable rate situation on one award than another. A distinct predicate from Compliance Requirement's own appliesToAward for the same reason every relationship predicate in this ontology is unique -- the generator requires one fixed declared subject per predicate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indirect-cost-rate" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/disbursedAsPayment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is disbursed as</rdfs:label>
    <rdfs:comment>An Installment is disbursed as a Payment once any Payment Condition is satisfied.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/mayHavePaymentCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may have</rdfs:label>
    <rdfs:comment>An Installment may carry a Payment Condition that must be met before it is disbursed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment-condition" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/includesActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>A Logic Model includes the Activities it plans for.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/logic-model" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/activity" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/includesInput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>A Logic Model includes the Inputs it plans for.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/logic-model" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/input" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/includesOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>A Logic Model includes the Outcomes it plans for.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/logic-model" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/outcome" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/includesOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>includes</rdfs:label>
    <rdfs:comment>A Logic Model includes the Outputs it plans for.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/logic-model" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/output" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/observedForPopulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>was observed for</rdfs:label>
    <rdfs:comment>A Measurement was observed for a specific Population.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/measurement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/population" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/observedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>was observed in</rdfs:label>
    <rdfs:comment>A Measurement was observed in a specific Geographic Area.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/measurement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/geographic-area" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/experiencedByPopulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is experienced by</rdfs:label>
    <rdfs:comment>A Need is experienced by a specific Population.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/need" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/population" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/hasLegalForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has legal form</rdfs:label>
    <rdfs:comment>An Organization has a legal form describing what it fundamentally is under law, independent of any role it plays.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-type" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/implementsProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>implements</rdfs:label>
    <rdfs:comment>An Organization carries out a Project -- typically the Grantee, but modeled directly on Organization rather than a specific role so any organization implementing work (e.g. a Sponsored Project's Fiscal Sponsor) can be represented the same way.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/participatesIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>participates in</rdfs:label>
    <rdfs:comment>An Organization participates in a Philanthropic Arrangement, independent of tracking which specific role it occupies there.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/playsRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>plays</rdfs:label>
    <rdfs:comment>An Organization plays one or more Organization Roles, each a contextual, independently-scoped occupancy rather than a permanent trait.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
    <owl:deprecated>true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="https://egovender.github.io/commongood-atlas/ontology/relations/agentPlaysRole" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/appliesWithin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies within</rdfs:label>
    <rdfs:comment>An Organization Role is scoped to the Philanthropic Arrangement it was granted within, so the same organization can hold different roles in different arrangements.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/organizationRoleAppliesWithinOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies within</rdfs:label>
    <rdfs:comment>An Organization Role can also be scoped directly to an Organization rather than an Arrangement -- e.g. a Contractor, Vendor, Service Provider, Employer, or Partner role is naturally scoped to which organization it relates to, not to a Philanthropic Arrangement. A distinct predicate from rel-organization-role-applies-within for the same reason Phase 3.7 Milestone 1's Person relationships needed distinct names: the generator requires every relationship predicate to be globally unique, so one predicate can't have two different declared object concepts. Broadening this into a true Role-appliesWithin-Context union (Award, Application, Agreement, Fund, Grant Program, Funding Opportunity, Project, Review, Payment, Decision, per the Phase 3.7 roadmap) is deferred until real worked-example data actually needs one of those specific contexts -- adding all of them speculatively now, each as its own distinct predicate, would be exactly the kind of premature abstraction this project avoids.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization-role" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/contributesToImpact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>contributes to</rdfs:label>
    <rdfs:comment>An Outcome contributes to a broader or longer-term Impact. Deliberately "contributes to," not "causes" -- see Evidence Claim for how a specific causal or contributory interpretation of that contribution is represented and evidenced.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/outcome" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/impact" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/contributesToOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>contributes to</rdfs:label>
    <rdfs:comment>An Output contributes to an intended or observed Outcome. Deliberately "contributes to," not "causes" -- see Evidence Claim for how a specific causal or contributory interpretation of that contribution is represented and evidenced.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/output" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/outcome" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/brokenIntoInstallment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is broken into</rdfs:label>
    <rdfs:comment>A Payment Schedule is broken into Installments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment-schedule" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/affiliatedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is affiliated with</rdfs:label>
    <rdfs:comment>A Person is affiliated with an Organization, independent of which specific Person Role(s) they occupy there.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/personPlaysRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>plays</rdfs:label>
    <rdfs:comment>A Person plays one or more Person Roles, each a contextual, independently-scoped occupancy rather than a permanent trait -- mirroring how an Organization plays Organization Roles (rel-organization-plays-role). A distinct predicate rather than a shared `playsRole` because the generator requires every relationship predicate to be globally unique (one fixed subject/object concept pair each); broadening `playsRole` into a real Person-or-Organization union predicate is a generator change deferred to when it's actually needed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
    <owl:deprecated>true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="https://egovender.github.io/commongood-atlas/ontology/relations/agentPlaysRole" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/personRoleAppliesWithin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>applies within</rdfs:label>
    <rdfs:comment>A Person Role is scoped to the Organization it was granted within. This is the minimal case needed to make Person Role usable; broadening it to Award, Application, Agreement, and other contexts (matching how Organization Role's own context is broadened) is Phase 3.7 Milestone 2's job -- which will also need to resolve the same predicate-uniqueness constraint noted on personPlaysRole above, likely by generalizing the generator to support a shared predicate across a union of object concepts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/person-role" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/administeredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is administered by</rdfs:label>
    <rdfs:comment>A Philanthropic Arrangement is administered by an Organization, such as a fiscal sponsor or fund administrator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/philanthropic-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/populationHasClassification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has classification</rdfs:label>
    <rdfs:comment>A Population has one or more Classification Assignments (e.g. Candid PCS Populations) describing its characteristics. Multiple classifications are valid, since a population may have several characteristics at once; the Population resource itself represents the actual contextual group, not a combination of taxonomy terms.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/population" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#classification" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/associatedWithGrantProgram">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is associated with</rdfs:label>
    <rdfs:comment>A Program Officer is associated with one or more Grant Programs and typically owns the Review and monitoring relationship for Awards made under them.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/program-officer" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-program" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#organizational-relationships" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/addressesNeed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>addresses</rdfs:label>
    <rdfs:comment>A Project addresses one or more identified Needs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/need" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/hasLogicModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has</rdfs:label>
    <rdfs:comment>A Project has a Logic Model connecting its inputs, activities, outputs, and outcomes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/logic-model" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/hasTheoryOfChange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>has</rdfs:label>
    <rdfs:comment>A Project has a Theory of Change articulating how its activities are expected to lead to desired long-term change.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/theory-of-change" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/performsActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>performs</rdfs:label>
    <rdfs:comment>A Project performs one or more Activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/activity" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/servesPopulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>serves</rdfs:label>
    <rdfs:comment>A Project serves a specific Population, which may or may not be the same Population that experiences the Need it addresses (e.g. a project can serve service providers on behalf of an affected population).</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/population" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/takesPlaceIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>takes place in</rdfs:label>
    <rdfs:comment>A Project operates within a Geographic Area. Distinct from any organization's registered address -- a project's operating area is not assumed to equal its implementing organization's or grant recipient's mailing address.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/geographic-area" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/usesInput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>uses</rdfs:label>
    <rdfs:comment>A Project uses Inputs (financial, human, material, or informational resources) to carry out its Activities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/input" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/regrantsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>regrants to</rdfs:label>
    <rdfs:comment>A Regranting Arrangement regrants funds to a downstream Organization, distinct from the Organization that supplied the funds originally.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/regranting-arrangement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/assessedAgainstLogicModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is assessed against</rdfs:label>
    <rdfs:comment>Reports are assessed against the project's Logic Model in terms of Outputs and Outcomes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/logic-model" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/assessedAgainstTheoryOfChange">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is assessed against</rdfs:label>
    <rdfs:comment>Reports are assessed against the project's Theory of Change in terms of Outputs and Outcomes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/theory-of-change" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/providesEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>provides</rdfs:label>
    <rdfs:comment>A Report can itself serve as Evidence supporting an Evidence Claim (e.g. the administrative data or narrative it contains).</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evidence" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/fulfilledByReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is fulfilled by</rdfs:label>
    <rdfs:comment>A Reporting Requirement is fulfilled by a submitted Report. Requirement is what must be supplied; Report is the artifact that was actually supplied.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reporting-requirement" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/obligatesReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>obligates</rdfs:label>
    <rdfs:comment>A Reporting Schedule obligates the Grantee to submit Reports on a defined cadence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reporting-schedule" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/report" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/measuredByIndicator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is measured by</rdfs:label>
    <rdfs:comment>A Result (Output, Outcome, or Impact) is measured by an Indicator. Declared against the abstract Result concept rather than each subtype separately, so any Output, Outcome, or Impact instance can be measured the same way.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/result" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indicator" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/conductedByReviewer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is conducted by</rdfs:label>
    <rdfs:comment>A Review is conducted by one or more Reviewers.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/review" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reviewer" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/evaluatedAgainstReviewCriteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is evaluated against</rdfs:label>
    <rdfs:comment>A Review evaluates an Application against published Review Criteria.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/review" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/review-criteria" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/mayIncludeSiteVisit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>may include</rdfs:label>
    <rdfs:comment>A Review may include a Site Visit before a Decision is made.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/review" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/site-visit" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/producesDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>produces</rdfs:label>
    <rdfs:comment>A Review produces a Decision.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/review" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/decision" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/relations/fiscallySponsoredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:label>is fiscally sponsored by</rdfs:label>
    <rdfs:comment>A Sponsored Project is fiscally sponsored by an Organization that provides the legal and administrative infrastructure it lacks on its own.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/sponsored-project" />
    <rdfs:range rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <rdfs:isDefinedBy rdf:resource="https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/amendment-effective-date">
    <rdfs:label>Effective Date</rdfs:label>
    <rdfs:comment>When the Amendment's changes take effect.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/amendment" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/amendment-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Amendment stands in its approval process.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/amendment" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>proposed</npo:allowedValue>
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>executed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/application-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Application currently sits in the review process.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>draft</npo:allowedValue>
    <npo:allowedValue>submitted</npo:allowedValue>
    <npo:allowedValue>under-review</npo:allowedValue>
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>declined</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/application-submitted-date">
    <rdfs:label>Submitted Date</rdfs:label>
    <rdfs:comment>When the Application was submitted, once it has been.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/application" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/approval-requirement-approval-date">
    <rdfs:label>Approval Date</rdfs:label>
    <rdfs:comment>When approval was granted, once it has been.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/approval-requirement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/approval-requirement-approval-status">
    <rdfs:label>Approval Status</rdfs:label>
    <rdfs:comment>Where a specific instance of this approval requirement stands.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/approval-requirement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>not-requested</npo:allowedValue>
    <npo:allowedValue>requested</npo:allowedValue>
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>denied</npo:allowedValue>
    <npo:allowedValue>not-applicable</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/approval-requirement-approval-threshold">
    <rdfs:label>Approval Threshold</rdfs:label>
    <rdfs:comment>The numeric threshold above which prior approval is required, where applicable (e.g. 10 for a 10% budget-reallocation threshold).</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/approval-requirement" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/approval-requirement-approval-type">
    <rdfs:label>Approval Type</rdfs:label>
    <rdfs:comment>What kind of change, expenditure, action, or deviation this Approval Requirement governs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/approval-requirement" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>budget-reallocation</npo:allowedValue>
    <npo:allowedValue>scope-change</npo:allowedValue>
    <npo:allowedValue>project-change</npo:allowedValue>
    <npo:allowedValue>key-personnel-change</npo:allowedValue>
    <npo:allowedValue>timeline-extension</npo:allowedValue>
    <npo:allowedValue>subgrant</npo:allowedValue>
    <npo:allowedValue>regrant</npo:allowedValue>
    <npo:allowedValue>contractor</npo:allowedValue>
    <npo:allowedValue>capital-purchase</npo:allowedValue>
    <npo:allowedValue>equipment-purchase</npo:allowedValue>
    <npo:allowedValue>equipment-disposition</npo:allowedValue>
    <npo:allowedValue>travel</npo:allowedValue>
    <npo:allowedValue>geographic-change</npo:allowedValue>
    <npo:allowedValue>population-change</npo:allowedValue>
    <npo:allowedValue>other</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/approval-requirement-threshold-unit">
    <rdfs:label>Threshold Unit</rdfs:label>
    <rdfs:comment>The unit the approval threshold is expressed in (e.g. percent, USD).</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/approval-requirement" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/audit-scheduled-date">
    <rdfs:label>Scheduled Date</rdfs:label>
    <rdfs:comment>When the Audit is scheduled to occur.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/audit" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/audit-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Audit stands.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/audit" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>scheduled</npo:allowedValue>
    <npo:allowedValue>in-progress</npo:allowedValue>
    <npo:allowedValue>completed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/award-amount">
    <rdfs:label>Amount</rdfs:label>
    <rdfs:comment>The total amount committed under the Award.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/award-currency">
    <rdfs:label>Currency</rdfs:label>
    <rdfs:comment>The currency the Award amount is denominated in, if not implied by context.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/award-date">
    <rdfs:label>Award Date</rdfs:label>
    <rdfs:comment>When the Award was made.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/award-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Award currently sits in the grant lifecycle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/award" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>proposed</npo:allowedValue>
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>active</npo:allowedValue>
    <npo:allowedValue>closed</npo:allowedValue>
    <npo:allowedValue>terminated</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/budget-modification-amount">
    <rdfs:label>Amount</rdfs:label>
    <rdfs:comment>The amount being moved between budget categories.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/budget-modification" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/budget-modification-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the funder has approved the requested Budget Modification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/budget-modification" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>requested</npo:allowedValue>
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>denied</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/budget-total-amount">
    <rdfs:label>Total Amount</rdfs:label>
    <rdfs:comment>The sum of all budget categories in the proposed or funded Budget.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/budget" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-allocation-percentage">
    <rdfs:label>Allocation Percentage</rdfs:label>
    <rdfs:comment>An actual distribution of the classified resource's value across classifications, only stored when supported by real source information -- never inferred to make reporting additive.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-assigned-at">
    <rdfs:label>Assigned At</rdfs:label>
    <rdfs:comment>When this classification assignment was created or imported.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-assignment-method">
    <rdfs:label>Assignment Method</rdfs:label>
    <rdfs:comment>How this classification was assigned. Ancestor classifications reached via the scheme's broader hierarchy are not normally stored as their own assignment with this field -- they're computed from the hierarchy at reporting time instead.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>source-provided</npo:allowedValue>
    <npo:allowedValue>imported</npo:allowedValue>
    <npo:allowedValue>manual</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-assignment-source">
    <rdfs:label>Assignment Source</rdfs:label>
    <rdfs:comment>Where this classification originated (e.g. "Candid import", "manual CommonGood assignment").</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-classification-concept-code">
    <rdfs:label>Classification Concept Code</rdfs:label>
    <rdfs:comment>The code of the term selected from the named classificationScheme (e.g. "affordable-housing"). A plain string, not independently validated against that scheme -- a reference-typed property's referenceScheme must be one fixed scheme declared on the property itself, and this field's scheme genuinely varies per instance. See docs/06-properties-and-rules.md for the full explanation of this known limitation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-classification-scheme">
    <rdfs:label>Classification Scheme</rdfs:label>
    <rdfs:comment>Which classification scheme classificationConceptCode is drawn from.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-is-primary">
    <rdfs:label>Is Primary</rdfs:label>
    <rdfs:comment>Whether this is the exclusive reporting classification for the classified resource within this scheme. At most one Classification Assignment per classified resource + scheme should be primary -- see business rules.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/classification-assignment-taxonomy-version">
    <rdfs:label>Taxonomy Version</rdfs:label>
    <rdfs:comment>The version or release of the classification scheme used for this assignment, so historical assignments retain the taxonomy version they were made under.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/classification-assignment" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/closeout-date">
    <rdfs:label>Closeout Date</rdfs:label>
    <rdfs:comment>When Closeout was completed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/closeout" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/closeout-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Award's Closeout has been completed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/closeout" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>pending</npo:allowedValue>
    <npo:allowedValue>completed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/compliance-requirement-requirement-type">
    <rdfs:label>Requirement Type</rdfs:label>
    <rdfs:comment>The kind of obligation the Compliance Requirement imposes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <npo:group>governance</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>reporting</npo:allowedValue>
    <npo:allowedValue>financial</npo:allowedValue>
    <npo:allowedValue>insurance</npo:allowedValue>
    <npo:allowedValue>other</npo:allowedValue>
    <npo:allowedValue>records-retention</npo:allowedValue>
    <npo:allowedValue>books-and-records-access</npo:allowedValue>
    <npo:allowedValue>financial-controls</npo:allowedValue>
    <npo:allowedValue>audit</npo:allowedValue>
    <npo:allowedValue>certification</npo:allowedValue>
    <npo:allowedValue>acknowledgement</npo:allowedValue>
    <npo:allowedValue>notification-of-change</npo:allowedValue>
    <npo:allowedValue>notification-of-breach</npo:allowedValue>
    <npo:allowedValue>conflict-disclosure</npo:allowedValue>
    <npo:allowedValue>legal-compliance</npo:allowedValue>
    <npo:allowedValue>tax-status-maintenance</npo:allowedValue>
    <npo:allowedValue>return-unused-funds</npo:allowedValue>
    <npo:allowedValue>data-protection</npo:allowedValue>
    <npo:allowedValue>publicity-requirement</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/compliance-requirement-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Grantee has met the Compliance Requirement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/compliance-requirement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>open</npo:allowedValue>
    <npo:allowedValue>satisfied</npo:allowedValue>
    <npo:allowedValue>overdue</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/decision-date">
    <rdfs:label>Decision Date</rdfs:label>
    <rdfs:comment>When the Decision was made.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/decision" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/decision-outcome">
    <rdfs:label>Outcome</rdfs:label>
    <rdfs:comment>The result of the review process for the Application.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/decision" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>declined</npo:allowedValue>
    <npo:allowedValue>approved-with-conditions</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/evaluation-completed-date">
    <rdfs:label>Completed Date</rdfs:label>
    <rdfs:comment>When the Evaluation was completed, once it has been.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evaluation" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/evaluation-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Evaluation stands.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evaluation" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>planned</npo:allowedValue>
    <npo:allowedValue>in-progress</npo:allowedValue>
    <npo:allowedValue>completed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/evidence-claim-claim-type">
    <rdfs:label>Claim Type</rdfs:label>
    <rdfs:comment>Whether this claim asserts association, contribution, attribution, or causation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evidence-claim" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/evidence-claim-evidence-strength">
    <rdfs:label>Evidence Strength</rdfs:label>
    <rdfs:comment>How strong the supporting evidence is for this claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/evidence-claim" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/fiscal-sponsorship-arrangement-fee-percentage">
    <rdfs:label>Fee Percentage</rdfs:label>
    <rdfs:comment>The fiscal sponsor's administrative fee, charged as a percentage of funds processed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fiscal-sponsorship-arrangement" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/fund-closing-date">
    <rdfs:label>Closing Date</rdfs:label>
    <rdfs:comment>When the fund was closed, if it has been.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/fund-currency">
    <rdfs:label>Currency</rdfs:label>
    <rdfs:comment>The currency the fund's balance is denominated in.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/fund-opening-date">
    <rdfs:label>Opening Date</rdfs:label>
    <rdfs:comment>When the fund was established.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/fund-restriction-type">
    <rdfs:label>Restriction Type</rdfs:label>
    <rdfs:comment>The fund's accounting restriction status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/fund-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the fund is currently active.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/fund" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>active</npo:allowedValue>
    <npo:allowedValue>closed</npo:allowedValue>
    <npo:allowedValue>frozen</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/funding-cycle-end-date">
    <rdfs:label>End Date</rdfs:label>
    <rdfs:comment>When the Funding Cycle closes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-cycle" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/funding-cycle-start-date">
    <rdfs:label>Start Date</rdfs:label>
    <rdfs:comment>When the Funding Cycle begins accepting applications.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-cycle" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/funding-opportunity-application-deadline">
    <rdfs:label>Application Deadline</rdfs:label>
    <rdfs:comment>The date by which an Application must be submitted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/funding-opportunity-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Funding Opportunity is still accepting applications.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/funding-opportunity" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>draft</npo:allowedValue>
    <npo:allowedValue>open</npo:allowedValue>
    <npo:allowedValue>closed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-agreement-effective-date">
    <rdfs:label>Effective Date</rdfs:label>
    <rdfs:comment>When the Grant Agreement's terms take effect.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-agreement-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Grant Agreement stands in its own lifecycle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-agreement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>draft</npo:allowedValue>
    <npo:allowedValue>signed</npo:allowedValue>
    <npo:allowedValue>active</npo:allowedValue>
    <npo:allowedValue>closed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-condition-barrier-type">
    <rdfs:label>Condition Barrier Type</rdfs:label>
    <rdfs:comment>What kind of barrier this condition's entitlement, payment, continuation, release, or retention depends on.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/condition-barrier-type" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-condition-status">
    <rdfs:label>Condition Status</rdfs:label>
    <rdfs:comment>Whether this condition has been satisfied. Never inferred solely from dates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>not-yet-assessed</npo:allowedValue>
    <npo:allowedValue>pending</npo:allowedValue>
    <npo:allowedValue>satisfied</npo:allowedValue>
    <npo:allowedValue>partially-satisfied</npo:allowedValue>
    <npo:allowedValue>not-satisfied</npo:allowedValue>
    <npo:allowedValue>waived</npo:allowedValue>
    <npo:allowedValue>expired</npo:allowedValue>
    <npo:allowedValue>not-applicable</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-due-date">
    <rdfs:label>Due Date</rdfs:label>
    <rdfs:comment>The date by which this condition must be satisfied, where applicable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-failure-consequence">
    <rdfs:label>Failure Consequence</rdfs:label>
    <rdfs:comment>What happens if this condition is not met.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>none-specified</npo:allowedValue>
    <npo:allowedValue>funds-withheld</npo:allowedValue>
    <npo:allowedValue>future-payment-withheld</npo:allowedValue>
    <npo:allowedValue>right-of-return</npo:allowedValue>
    <npo:allowedValue>repayment-required</npo:allowedValue>
    <npo:allowedValue>award-reduced</npo:allowedValue>
    <npo:allowedValue>award-suspended</npo:allowedValue>
    <npo:allowedValue>award-terminated</npo:allowedValue>
    <npo:allowedValue>corrective-action-required</npo:allowedValue>
    <npo:allowedValue>future-funding-affected</npo:allowedValue>
    <npo:allowedValue>other</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-has-barrier">
    <rdfs:label>Has Barrier</rdfs:label>
    <rdfs:comment>Whether this condition has a defined barrier that must be overcome. Captures the fact without the ontology itself concluding that the grant is legally or accountingly "conditional" -- that determination may require separate accounting or legal analysis.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-has-right-of-release">
    <rdfs:label>Has Right Of Release</rdfs:label>
    <rdfs:comment>Whether satisfying this condition releases funds that were otherwise being withheld.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-has-right-of-return">
    <rdfs:label>Has Right Of Return</rdfs:label>
    <rdfs:comment>Whether failing this condition creates a right for the funder to require return of funds already disbursed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-threshold-operator">
    <rdfs:label>Threshold Operator</rdfs:label>
    <rdfs:comment>How the threshold value must be compared against to satisfy the condition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>greater-than</npo:allowedValue>
    <npo:allowedValue>greater-than-or-equal</npo:allowedValue>
    <npo:allowedValue>less-than</npo:allowedValue>
    <npo:allowedValue>less-than-or-equal</npo:allowedValue>
    <npo:allowedValue>equal</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-threshold-unit">
    <rdfs:label>Threshold Unit</rdfs:label>
    <rdfs:comment>The unit the threshold value is expressed in (e.g. USD, percent, participants).</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-condition-threshold-value">
    <rdfs:label>Threshold Value</rdfs:label>
    <rdfs:comment>The numeric threshold this condition's barrier is measured against (e.g. 250000, or 10 for a percentage), where applicable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-condition" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-program-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Where the Grant Program currently sits in its own lifecycle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-program" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>planning</npo:allowedValue>
    <npo:allowedValue>open</npo:allowedValue>
    <npo:allowedValue>closed</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-program-total-budget">
    <rdfs:label>Total Budget</rdfs:label>
    <rdfs:comment>The total amount set aside for this Grant Program, if the funder tracks one.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-program" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-recommendation-amount">
    <rdfs:label>Amount</rdfs:label>
    <rdfs:comment>The amount recommended, if the Donor Advisor specified one.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-recommendation-date">
    <rdfs:label>Recommendation Date</rdfs:label>
    <rdfs:comment>When the Donor Advisor made the recommendation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-recommendation-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the sponsoring organization has acted on the Grant Recommendation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-recommendation" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>pending</npo:allowedValue>
    <npo:allowedValue>approved</npo:allowedValue>
    <npo:allowedValue>declined</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-effective-from">
    <rdfs:label>Effective From</rdfs:label>
    <rdfs:comment>When this specific term takes effect -- not assumed to equal the whole Grant Agreement's effective date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-effective-until">
    <rdfs:label>Effective Until</rdfs:label>
    <rdfs:comment>When this specific term stops applying, if it has an end date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-normalization-method">
    <rdfs:label>Normalization Method</rdfs:label>
    <rdfs:comment>How this term was normalized from its source. Machine-derived normalization is not treated as equivalent to source-provided structured data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>manual</npo:allowedValue>
    <npo:allowedValue>rules-based</npo:allowedValue>
    <npo:allowedValue>imported-structured</npo:allowedValue>
    <npo:allowedValue>machine-assisted</npo:allowedValue>
    <npo:allowedValue>reviewed-machine-assisted</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-normalization-status">
    <rdfs:label>Normalization Status</rdfs:label>
    <rdfs:comment>Whether this term's normalization from source text is complete, partial, or still needs review. Preferred over forcing an uncertain clause into an incorrect category.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>mapped</npo:allowedValue>
    <npo:allowedValue>partially-mapped</npo:allowedValue>
    <npo:allowedValue>unmapped</npo:allowedValue>
    <npo:allowedValue>needs-review</npo:allowedValue>
    <npo:allowedValue>not-applicable</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-original-term-text">
    <rdfs:label>Original Term Text</rdfs:label>
    <rdfs:comment>The term's original source wording, preserved verbatim. Recommended for imported terms; the normalized classification is an interpretation of this text, not a replacement for it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-source-clause-identifier">
    <rdfs:label>Source Clause Identifier</rdfs:label>
    <rdfs:comment>An identifier tying this term back to the specific source clause it was segmented from -- lets several Grant Terms normalized from one free-text field retain a shared linkage back to that field.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-source-field">
    <rdfs:label>Source Field</rdfs:label>
    <rdfs:comment>The source system's field this term was imported from, if any.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-source-record-identifier">
    <rdfs:label>Source Record Identifier</rdfs:label>
    <rdfs:comment>The identifier of the source record this term was imported from, if any.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/grant-term-source-system">
    <rdfs:label>Source System</rdfs:label>
    <rdfs:comment>The system this term was imported from (e.g. Tides), if any.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/grant-term" />
    <npo:group>governance</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/indirect-cost-rate-rate">
    <rdfs:label>Rate</rdfs:label>
    <rdfs:comment>The indirect cost rate, expressed as a percentage of direct costs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indirect-cost-rate" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/indirect-cost-rate-rate-type">
    <rdfs:label>Rate Type</rdfs:label>
    <rdfs:comment>Whether the rate was individually negotiated or is the de minimis rate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/indirect-cost-rate" />
    <npo:group>classification</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>negotiated</npo:allowedValue>
    <npo:allowedValue>de-minimis</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/installment-amount">
    <rdfs:label>Amount</rdfs:label>
    <rdfs:comment>The amount scheduled for this Installment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/installment-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Installment has been disbursed, or is being held pending its Payment Condition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/installment" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>scheduled</npo:allowedValue>
    <npo:allowedValue>released</npo:allowedValue>
    <npo:allowedValue>held</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/letter-of-inquiry-status">
    <rdfs:label>Status</rdfs:label>
    <rdfs:comment>Whether the Letter of Inquiry resulted in an invitation to submit a full Application.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/letter-of-inquiry" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>submitted</npo:allowedValue>
    <npo:allowedValue>invited</npo:allowedValue>
    <npo:allowedValue>declined</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/matching-requirement-match-type">
    <rdfs:label>Match Type</rdfs:label>
    <rdfs:comment>Whether the required match must be cash or may be in-kind.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/matching-requirement" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>cash</npo:allowedValue>
    <npo:allowedValue>in-kind</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/matching-requirement-required-ratio">
    <rdfs:label>Required Ratio</rdfs:label>
    <rdfs:comment>The match ratio the Grantee must meet, e.g. "1:1".</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/matching-requirement" />
    <npo:group>financial</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/measurement-observation-date">
    <rdfs:label>Observation Date</rdfs:label>
    <rdfs:comment>The date the value was observed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/measurement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/measurement-value">
    <rdfs:label>Value</rdfs:label>
    <rdfs:comment>The observed value for the indicator. A plain string so it can hold a numeric ("64%"), categorical ("improved"), ordinal ("high"), or textual observation without conflating these kinds of values into different fields.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/measurement" />
    <npo:group>lifecycle</npo:group>
    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-formation-date">
    <rdfs:label>Formation Date</rdfs:label>
    <rdfs:comment>When the organization was legally formed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-identifier">
    <rdfs:label>Identifier</rdfs:label>
    <rdfs:comment>A registration number or unique identifier for the organization (e.g., an EIN or DUNS number), if tracked.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-jurisdiction">
    <rdfs:label>Jurisdiction</rdfs:label>
    <rdfs:comment>The legal jurisdiction (country or state) the organization is formed and regulated under.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-operating-status">
    <rdfs:label>Operating Status</rdfs:label>
    <rdfs:comment>Whether the organization is currently operating.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <npo:referenceScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-tax-identifier">
    <rdfs:label>Tax Identifier</rdfs:label>
    <rdfs:comment>The organization's tax identification number (e.g., an EIN), if applicable and disclosed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/organization" />
    <npo:group>classification</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/organization-tax-status">
    <rdfs:label>Tax Status</rdfs:label>
    <rdfs:comment>The organization's tax-exemption status, independent of its legal form.</rdfs:comment>
