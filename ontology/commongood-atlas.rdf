    <skos:notation>political-campaign-activity</skos:notation>
    <skos:prefLabel>Political Campaign Activity</skos:prefLabel>
    <skos:definition>Concerns political campaign activity, typically as a prohibited use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-regranting">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>regranting</skos:notation>
    <skos:prefLabel>Regranting</skos:prefLabel>
    <skos:definition>Restricted to redistribution as regrants.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-scholarship">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>scholarship</skos:notation>
