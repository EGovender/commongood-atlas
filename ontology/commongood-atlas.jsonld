      "definition": "Reliable access to sufficient, affordable, nutritious food."
    },
    {
      "id": "nporef:issue-area-health",
      "type": "skos:Concept",
      "inScheme": "nporef:issue-area",
      "notation": "health",
      "prefLabel": "Health",
      "definition": "Physical and behavioral health, including access to care."
    },
    {
      "id": "nporef:issue-area-housing",
      "type": "skos:Concept",
      "inScheme": "nporef:issue-area",
