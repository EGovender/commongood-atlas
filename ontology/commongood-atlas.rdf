    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
    <skos:notation>monthly</skos:notation>
    <skos:prefLabel>Monthly</skos:prefLabel>
    <skos:definition>Recurs every month.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-one-time">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
    <skos:notation>one-time</skos:notation>
    <skos:prefLabel>One-Time</skos:prefLabel>
    <skos:definition>Occurs once, with no recurrence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-quarterly">
