    <skos:broadMatch rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-environment" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects-housing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects" />
    <skos:notation>housing</skos:notation>
    <skos:prefLabel>Housing</skos:prefLabel>
    <skos:definition>Illustrative placeholder for Candid PCS's Housing subject.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects-housing-development">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects" />
    <skos:notation>housing-development</skos:notation>
    <skos:prefLabel>Housing Development</skos:prefLabel>
    <skos:definition>Illustrative placeholder for Candid PCS's Housing Development subject.</skos:definition>
    <skos:broader rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects-housing" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Claim Type</skos:prefLabel>
    <skos:definition>How strong an interpretation an Evidence Claim makes about a Project's relationship to a Result -- deliberately distinct, ordered from weakest to strongest evidentiary interpretation, and never treated as equivalent to one another.</skos:definition>
    <npo:schemeDomain>program</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-association">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>association</skos:notation>
    <skos:prefLabel>Association</skos:prefLabel>
    <skos:definition>Two phenomena are observed together, without asserting that one influenced the other.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-attribution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>attribution</skos:notation>
    <skos:prefLabel>Attribution</skos:prefLabel>
    <skos:definition>The evidence assigns a defined portion or substantial responsibility for the result to the intervention.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-causation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>causation</skos:notation>
    <skos:prefLabel>Causation</skos:prefLabel>
    <skos:definition>The evidence supports a causal relationship between the intervention and the result.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type-contribution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/claim-type" />
    <skos:notation>contribution</skos:notation>
    <skos:prefLabel>Contribution</skos:prefLabel>
    <skos:definition>There is evidence that the intervention played some role in producing the result, alongside other factors.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Classification Scheme Registry</skos:prefLabel>
    <skos:definition>Which classification scheme a Classification Assignment draws its classificationConceptCode from. This registry entry is what's SHACL-validated; the code itself is a plain string naming a value within that scheme, not independently validated against it -- see docs/06-properties-and-rules.md for why. Candid PCS Organization Types, Transaction Types, and Support Strategies are registered here as valid facets but not yet populated as their own reference-data files -- add them when real data needs them, following candid-pcs-subjects.json/candid-pcs-populations.json as the template.</skos:definition>
    <npo:schemeDomain>classification</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry-candid-pcs-organization-types">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry" />
    <skos:notation>candid-pcs-organization-types</skos:notation>
    <skos:prefLabel>Candid PCS Organization Types</skos:prefLabel>
    <skos:definition>Candid's Philanthropy Classification System organization-type facet. Registered but not yet populated as its own reference-data file.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry-candid-pcs-populations">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry" />
    <skos:notation>candid-pcs-populations</skos:notation>
    <skos:prefLabel>Candid PCS Populations</skos:prefLabel>
    <skos:definition>Candid's Philanthropy Classification System population facet -- what population(s) a resource serves or describes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry-candid-pcs-subjects">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry" />
    <skos:notation>candid-pcs-subjects</skos:notation>
    <skos:prefLabel>Candid PCS Subjects</skos:prefLabel>
    <skos:definition>Candid's Philanthropy Classification System subject facet -- what issue or subject a resource addresses or supports.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry-candid-pcs-support-strategies">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry" />
    <skos:notation>candid-pcs-support-strategies</skos:notation>
    <skos:prefLabel>Candid PCS Support Strategies</skos:prefLabel>
    <skos:definition>Candid's Philanthropy Classification System support-strategy facet. Registered but not yet populated as its own reference-data file.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry-candid-pcs-transaction-types">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/classification-scheme-registry" />
    <skos:notation>candid-pcs-transaction-types</skos:notation>
    <skos:prefLabel>Candid PCS Transaction Types</skos:prefLabel>
