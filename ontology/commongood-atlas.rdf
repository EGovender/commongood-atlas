    <skos:notation>other</skos:notation>
    <skos:prefLabel>Other</skos:prefLabel>
    <skos:definition>A use restriction not captured by another value in this scheme.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-political-campaign-activity">
