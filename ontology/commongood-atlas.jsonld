    {
      "id": "nporef:evidence-strength",
      "type": "skos:ConceptScheme",
      "prefLabel": "Evidence Strength",
      "definition": "How strong the supporting Evidence is for an Evidence Claim, independent of the claim's type (association/contribution/attribution/causation) -- a causation claim and an association claim can each be backed by strong or weak evidence.",
      "schemeDomain": "program",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:evidence-strength-anecdotal",
      "type": "skos:Concept",
      "inScheme": "nporef:evidence-strength",
      "notation": "anecdotal",
      "prefLabel": "Anecdotal",
      "definition": "Based on isolated stories or individual accounts, not a systematic review."
    },
    {
      "id": "nporef:evidence-strength-inconclusive",
      "type": "skos:Concept",
      "inScheme": "nporef:evidence-strength",
      "notation": "inconclusive",
      "prefLabel": "Inconclusive",
      "definition": "The available evidence does not clearly support or refute the claim."
    },
    {
      "id": "nporef:evidence-strength-limited",
      "type": "skos:Concept",
      "inScheme": "nporef:evidence-strength",
      "notation": "limited",
      "prefLabel": "Limited",
      "definition": "Based on a small or narrow body of evidence with significant gaps."
    },
    {
      "id": "nporef:evidence-strength-moderate",
      "type": "skos:Concept",
      "inScheme": "nporef:evidence-strength",
      "notation": "moderate",
      "prefLabel": "Moderate",
      "definition": "Based on a reasonably systematic body of evidence with some limitations."
    },
    {
      "id": "nporef:evidence-strength-strong",
      "type": "skos:Concept",
      "inScheme": "nporef:evidence-strength",
      "notation": "strong",
      "prefLabel": "Strong",
      "definition": "Based on a rigorous, systematic body of evidence with few limitations."
    },
    {
      "id": "nporef:frequency",
      "type": "skos:ConceptScheme",
      "prefLabel": "Frequency",
      "definition": "How often a recurring obligation is due. Currently used for how often Reports are due under a Reporting Schedule; generic enough to apply to other recurring obligations later without a new scheme.",
      "schemeDomain": "scheduling",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:frequency-annual",
      "type": "skos:Concept",
      "inScheme": "nporef:frequency",
      "notation": "annual",
      "prefLabel": "Annual",
      "definition": "Recurs once a year."
    },
    {
      "id": "nporef:frequency-monthly",
      "type": "skos:Concept",
      "inScheme": "nporef:frequency",
      "notation": "monthly",
      "prefLabel": "Monthly",
      "definition": "Recurs every month."
    },
    {
      "id": "nporef:frequency-one-time",
      "type": "skos:Concept",
      "inScheme": "nporef:frequency",
      "notation": "one-time",
      "prefLabel": "One-Time",
      "definition": "Occurs once, with no recurrence."
    },
    {
      "id": "nporef:frequency-quarterly",
      "type": "skos:Concept",
      "inScheme": "nporef:frequency",
      "notation": "quarterly",
      "prefLabel": "Quarterly",
      "definition": "Recurs every three months."
    },
    {
      "id": "nporef:issue-area",
      "type": "skos:ConceptScheme",
      "prefLabel": "Issue Area",
      "definition": "The primary social or environmental issue a Project addresses. Not assumed to be a complete list of every possible issue area -- new values can be proposed as real projects need them.",
      "schemeDomain": "program",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
