  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status-dissolved">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
    <skos:notation>dissolved</skos:notation>
    <skos:prefLabel>Dissolved</skos:prefLabel>
    <skos:definition>The organization has formally ceased to exist.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status-merged">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
    <skos:notation>merged</skos:notation>
    <skos:prefLabel>Merged</skos:prefLabel>
    <skos:definition>The organization has combined into another organization and no longer operates independently.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status-unknown">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/organization-operating-status" />
    <skos:notation>unknown</skos:notation>
    <skos:prefLabel>Unknown</skos:prefLabel>
    <skos:definition>The organization's current operating status has not been confirmed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Publication Status</skos:prefLabel>
    <skos:definition>The lifecycle state of a reference-data scheme itself -- whether it's still being drafted, actively governing one or more properties, or deprecated in favor of something else. Distinct from a single value's own `deprecated` flag: a scheme can stay published while one of its values is retired.</skos:definition>
    <npo:schemeDomain>reference-data-governance</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-deprecated">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status" />
    <skos:notation>deprecated</skos:notation>
    <skos:prefLabel>Deprecated</skos:prefLabel>
    <skos:definition>The scheme is no longer recommended for new use, though existing data may still reference its values.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-draft">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status" />
    <skos:notation>draft</skos:notation>
    <skos:prefLabel>Draft</skos:prefLabel>
    <skos:definition>The scheme is still being defined and does not yet constrain any concept property.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status" />
    <skos:notation>published</skos:notation>
    <skos:prefLabel>Published</skos:prefLabel>
    <skos:definition>The scheme is stable and in active use, constraining one or more concept properties.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Restriction Type</skos:prefLabel>
    <skos:definition>A Fund's accounting restriction status -- whether its use is constrained by the donor, and if so, how. `donor-restricted` is the broader designation covering both time-limited and perpetual donor restrictions; `temporarily-restricted` and `permanently-restricted` narrow it to which kind.</skos:definition>
    <npo:schemeDomain>financial</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-donor-restricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>donor-restricted</skos:notation>
    <skos:prefLabel>Donor-Restricted</skos:prefLabel>
    <skos:definition>The fund's use is constrained by the donor, without specifying here whether the constraint is time-limited or perpetual.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-permanently-restricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>permanently-restricted</skos:notation>
    <skos:prefLabel>Permanently Restricted</skos:prefLabel>
    <skos:definition>The fund's donor-imposed restriction never expires.</skos:definition>
    <skos:broader rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-donor-restricted" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-temporarily-restricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>temporarily-restricted</skos:notation>
    <skos:prefLabel>Temporarily Restricted</skos:prefLabel>
    <skos:definition>The fund's donor-imposed restriction expires after a specific time or purpose is satisfied.</skos:definition>
    <skos:broader rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-donor-restricted" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type-unrestricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/restriction-type" />
    <skos:notation>unrestricted</skos:notation>
    <skos:prefLabel>Unrestricted</skos:prefLabel>
    <skos:definition>The fund carries no donor-imposed restriction on its use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Role Status</skos:prefLabel>
    <skos:definition>Where a Role occupancy currently sits in its own lifecycle, shared by every person-role and organization-role subtype via the role concept's inherited `status` property.</skos:definition>
    <npo:schemeDomain>role</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-active">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>active</skos:notation>
    <skos:prefLabel>Active</skos:prefLabel>
    <skos:definition>The role occupancy is currently in effect.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-cancelled">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>cancelled</skos:notation>
    <skos:prefLabel>Cancelled</skos:prefLabel>
    <skos:definition>The role occupancy was called off before or without reaching its expected conclusion.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-ended">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>ended</skos:notation>
    <skos:prefLabel>Ended</skos:prefLabel>
    <skos:definition>The role occupancy concluded as expected, e.g. at its effectiveTo date.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-planned">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>planned</skos:notation>
    <skos:prefLabel>Planned</skos:prefLabel>
    <skos:definition>The role occupancy has been agreed but has not yet started.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status-suspended">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/role-status" />
    <skos:notation>suspended</skos:notation>
    <skos:prefLabel>Suspended</skos:prefLabel>
    <skos:definition>The role occupancy is temporarily paused without having formally ended.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Use Restriction Type</skos:prefLabel>
    <skos:definition>The nature of what a Use Restriction limits grant funds to (or from) -- distinct from Fund's own restriction-type scheme, which describes a Fund's accounting restriction status rather than the specific nature of a grant term's use restriction. Values do not all carry identical legal significance.</skos:definition>
    <npo:schemeDomain>award-and-agreement</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-capital-only">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>capital-only</skos:notation>
    <skos:prefLabel>Capital Only</skos:prefLabel>
    <skos:definition>Restricted to capital expenditures.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-endowment">
