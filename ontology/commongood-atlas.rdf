  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Evidence Strength</skos:prefLabel>
    <skos:definition>How strong the supporting Evidence is for an Evidence Claim, independent of the claim's type (association/contribution/attribution/causation) -- a causation claim and an association claim can each be backed by strong or weak evidence.</skos:definition>
    <npo:schemeDomain>program</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-anecdotal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>anecdotal</skos:notation>
    <skos:prefLabel>Anecdotal</skos:prefLabel>
    <skos:definition>Based on isolated stories or individual accounts, not a systematic review.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-inconclusive">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>inconclusive</skos:notation>
    <skos:prefLabel>Inconclusive</skos:prefLabel>
    <skos:definition>The available evidence does not clearly support or refute the claim.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-limited">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>limited</skos:notation>
    <skos:prefLabel>Limited</skos:prefLabel>
    <skos:definition>Based on a small or narrow body of evidence with significant gaps.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-moderate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>moderate</skos:notation>
    <skos:prefLabel>Moderate</skos:prefLabel>
    <skos:definition>Based on a reasonably systematic body of evidence with some limitations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength-strong">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/evidence-strength" />
    <skos:notation>strong</skos:notation>
    <skos:prefLabel>Strong</skos:prefLabel>
    <skos:definition>Based on a rigorous, systematic body of evidence with few limitations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Frequency</skos:prefLabel>
    <skos:definition>How often a recurring obligation is due. Currently used for how often Reports are due under a Reporting Schedule; generic enough to apply to other recurring obligations later without a new scheme.</skos:definition>
    <npo:schemeDomain>scheduling</npo:schemeDomain>
    <npo:authorityType>internal</npo:authorityType>
    <npo:version>1.0.0</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-published" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-annual">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency" />
    <skos:notation>annual</skos:notation>
    <skos:prefLabel>Annual</skos:prefLabel>
    <skos:definition>Recurs once a year.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/frequency-monthly">
