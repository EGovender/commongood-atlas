      "domain": "npo:grant-recommendation",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "pending",
        "approved",
        "declined"
      ]
    },
    {
      "id": "npoprop:grant-term-effective-from",
      "label": "Effective From",
      "comment": "When this specific term takes effect -- not assumed to equal the whole Grant Agreement's effective date.",
      "domain": "npo:grant-term",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:date"
    },
    {
      "id": "npoprop:grant-term-effective-until",
      "label": "Effective Until",
      "comment": "When this specific term stops applying, if it has an end date.",
      "domain": "npo:grant-term",
      "group": "lifecycle",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:date"
    },
    {
      "id": "npoprop:grant-term-normalization-method",
      "label": "Normalization Method",
      "comment": "How this term was normalized from its source. Machine-derived normalization is not treated as equivalent to source-provided structured data.",
      "domain": "npo:grant-term",
      "group": "governance",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "manual",
        "rules-based",
        "imported-structured",
        "machine-assisted",
        "reviewed-machine-assisted"
      ]
    },
    {
      "id": "npoprop:grant-term-normalization-status",
      "label": "Normalization Status",
      "comment": "Whether this term's normalization from source text is complete, partial, or still needs review. Preferred over forcing an uncertain clause into an incorrect category.",
      "domain": "npo:grant-term",
      "group": "governance",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "mapped",
        "partially-mapped",
        "unmapped",
        "needs-review",
        "not-applicable"
      ]
    },
    {
      "id": "npoprop:grant-term-original-term-text",
      "label": "Original Term Text",
      "comment": "The term's original source wording, preserved verbatim. Recommended for imported terms; the normalized classification is an interpretation of this text, not a replacement for it.",
      "domain": "npo:grant-term",
      "group": "governance",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string"
    },
    {
      "id": "npoprop:grant-term-source-clause-identifier",
      "label": "Source Clause Identifier",
      "comment": "An identifier tying this term back to the specific source clause it was segmented from -- lets several Grant Terms normalized from one free-text field retain a shared linkage back to that field.",
      "domain": "npo:grant-term",
      "group": "governance",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string"
    },
    {
      "id": "npoprop:grant-term-source-field",
      "label": "Source Field",
      "comment": "The source system's field this term was imported from, if any.",
      "domain": "npo:grant-term",
      "group": "governance",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string"
    },
    {
      "id": "npoprop:grant-term-source-record-identifier",
      "label": "Source Record Identifier",
      "comment": "The identifier of the source record this term was imported from, if any.",
      "domain": "npo:grant-term",
      "group": "governance",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string"
    },
    {
      "id": "npoprop:grant-term-source-system",
      "label": "Source System",
