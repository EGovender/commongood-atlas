    <npo:group>financial</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-date">
    <rdfs:label>Payment Date</rdfs:label>
    <rdfs:comment>When the Payment was sent or received.</rdfs:comment>
    <rdfs:domain rdf:resource="https://egovender.github.io/commongood-atlas/ontology/payment" />
    <npo:group>lifecycle</npo:group>
    <npo:required>false</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-schedule-status">
