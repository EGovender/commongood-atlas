---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LogicalModelWorkbench from '../../components/logical-model/LogicalModelWorkbench';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Your Logical Model"
  description="A database-independent logical model -- entities, attributes, and associations -- generated from your Model Your Program responses."
  wide="full"
>
  <PageHero
    slot="pageHero"
    eyebrow="Build your model"
    title="Your Logical Model"
    description="Entities, attributes, and associations generated from your Model Your Program responses."
  />
  <LogicalModelWorkbench client:load base={base} />
</BaseLayout>
