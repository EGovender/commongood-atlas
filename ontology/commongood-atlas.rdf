    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/report-report-type">
    <rdfs:label>Report Type</rdfs:label>
