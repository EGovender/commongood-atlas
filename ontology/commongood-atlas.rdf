    <npo:required>true</npo:required>
    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <npo:allowedValue>report-required</npo:allowedValue>
    <npo:allowedValue>milestone-required</npo:allowedValue>
    <npo:allowedValue>none</npo:allowedValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/payment-currency">
    <rdfs:label>Currency</rdfs:label>
    <rdfs:comment>The currency the Payment was made in, if not implied by context.</rdfs:comment>
