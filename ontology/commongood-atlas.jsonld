    {
      "id": "nporef:claim-type",
      "type": "skos:ConceptScheme",
      "prefLabel": "Claim Type",
      "definition": "How strong an interpretation an Evidence Claim makes about a Project's relationship to a Result -- deliberately distinct, ordered from weakest to strongest evidentiary interpretation, and never treated as equivalent to one another.",
      "schemeDomain": "program",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:claim-type-association",
      "type": "skos:Concept",
      "inScheme": "nporef:claim-type",
      "notation": "association",
      "prefLabel": "Association",
      "definition": "Two phenomena are observed together, without asserting that one influenced the other."
    },
    {
      "id": "nporef:claim-type-attribution",
      "type": "skos:Concept",
      "inScheme": "nporef:claim-type",
      "notation": "attribution",
      "prefLabel": "Attribution",
      "definition": "The evidence assigns a defined portion or substantial responsibility for the result to the intervention."
    },
    {
      "id": "nporef:claim-type-causation",
      "type": "skos:Concept",
      "inScheme": "nporef:claim-type",
      "notation": "causation",
      "prefLabel": "Causation",
      "definition": "The evidence supports a causal relationship between the intervention and the result."
    },
    {
      "id": "nporef:claim-type-contribution",
      "type": "skos:Concept",
      "inScheme": "nporef:claim-type",
      "notation": "contribution",
      "prefLabel": "Contribution",
      "definition": "There is evidence that the intervention played some role in producing the result, alongside other factors."
    },
    {
      "id": "nporef:classification-scheme-registry",
      "type": "skos:ConceptScheme",
      "prefLabel": "Classification Scheme Registry",
      "definition": "Which classification scheme a Classification Assignment draws its classificationConceptCode from. This registry entry is what's SHACL-validated; the code itself is a plain string naming a value within that scheme, not independently validated against it -- see docs/06-properties-and-rules.md for why. Candid PCS Organization Types, Transaction Types, and Support Strategies are registered here as valid facets but not yet populated as their own reference-data files -- add them when real data needs them, following candid-pcs-subjects.json/candid-pcs-populations.json as the template.",
      "schemeDomain": "classification",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:classification-scheme-registry-candid-pcs-organization-types",
      "type": "skos:Concept",
      "inScheme": "nporef:classification-scheme-registry",
      "notation": "candid-pcs-organization-types",
      "prefLabel": "Candid PCS Organization Types",
      "definition": "Candid's Philanthropy Classification System organization-type facet. Registered but not yet populated as its own reference-data file."
    },
    {
      "id": "nporef:classification-scheme-registry-candid-pcs-populations",
      "type": "skos:Concept",
      "inScheme": "nporef:classification-scheme-registry",
      "notation": "candid-pcs-populations",
      "prefLabel": "Candid PCS Populations",
      "definition": "Candid's Philanthropy Classification System population facet -- what population(s) a resource serves or describes."
    },
    {
      "id": "nporef:classification-scheme-registry-candid-pcs-subjects",
      "type": "skos:Concept",
      "inScheme": "nporef:classification-scheme-registry",
      "notation": "candid-pcs-subjects",
      "prefLabel": "Candid PCS Subjects",
      "definition": "Candid's Philanthropy Classification System subject facet -- what issue or subject a resource addresses or supports."
    },
    {
      "id": "nporef:classification-scheme-registry-candid-pcs-support-strategies",
      "type": "skos:Concept",
      "inScheme": "nporef:classification-scheme-registry",
      "notation": "candid-pcs-support-strategies",
      "prefLabel": "Candid PCS Support Strategies",
      "definition": "Candid's Philanthropy Classification System support-strategy facet. Registered but not yet populated as its own reference-data file."
    },
    {
      "id": "nporef:classification-scheme-registry-candid-pcs-transaction-types",
      "type": "skos:Concept",
      "inScheme": "nporef:classification-scheme-registry",
      "notation": "candid-pcs-transaction-types",
      "prefLabel": "Candid PCS Transaction Types",
      "definition": "Candid's Philanthropy Classification System transaction-type facet -- the form through which support is provided or received. Registered but not yet populated as its own reference-data file."
    },
    {
      "id": "nporef:classification-scheme-registry-commongood-issue-areas",
      "type": "skos:Concept",
      "inScheme": "nporef:classification-scheme-registry",
      "notation": "commongood-issue-areas",
      "prefLabel": "CommonGood Issue Areas",
      "definition": "This ontology's own Issue Area scheme (see issue-area.json), usable as a classification scheme in its own right alongside external taxonomies."
    },
    {
      "id": "nporef:condition-barrier-type",
      "type": "skos:ConceptScheme",
      "prefLabel": "Condition Barrier Type",
      "definition": "What kind of barrier, milestone, or event a Grant Condition's entitlement, payment, continuation, release, or retention depends on.",
      "schemeDomain": "award-and-agreement",
      "authorityType": "internal",
      "version": "1.0.0",
      "publicationStatus": "nporef:publication-status-published"
    },
    {
      "id": "nporef:condition-barrier-type-cost-sharing-requirement",
      "type": "skos:Concept",
      "inScheme": "nporef:condition-barrier-type",
      "notation": "cost-sharing-requirement",
      "prefLabel": "Cost-Sharing Requirement",
      "definition": "Contingent on sharing costs alongside the award."
    },
    {
      "id": "nporef:condition-barrier-type-fundraising-target",
      "type": "skos:Concept",
      "inScheme": "nporef:condition-barrier-type",
      "notation": "fundraising-target",
      "prefLabel": "Fundraising Target",
      "definition": "Contingent on reaching a fundraising target."
    },
    {
      "id": "nporef:condition-barrier-type-matching-requirement",
      "type": "skos:Concept",
      "inScheme": "nporef:condition-barrier-type",
      "notation": "matching-requirement",
      "prefLabel": "Matching Requirement",
      "definition": "Contingent on raising or contributing matching funds."
    },
    {
      "id": "nporef:condition-barrier-type-other",
      "type": "skos:Concept",
      "inScheme": "nporef:condition-barrier-type",
      "notation": "other",
      "prefLabel": "Other",
      "definition": "A condition barrier not captured by another value in this scheme."
    },
    {
      "id": "nporef:condition-barrier-type-other-measurable-barrier",
      "type": "skos:Concept",
      "inScheme": "nporef:condition-barrier-type",
      "notation": "other-measurable-barrier",
      "prefLabel": "Other Measurable Barrier",
      "definition": "Contingent on another measurable barrier not otherwise listed."
    },
    {
      "id": "nporef:condition-barrier-type-outcome-threshold",
      "type": "skos:Concept",
      "inScheme": "nporef:condition-barrier-type",
      "notation": "outcome-threshold",
      "prefLabel": "Outcome Threshold",
      "definition": "Contingent on reaching a specified outcome level."
    },
    {
