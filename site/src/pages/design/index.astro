---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DesignWizard from '../../components/DesignWizard';
import { DESIGN_QUESTIONS } from '../../data/design-questions';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Model Your Program"
  description="Answer a few questions about your grantmaking program and get a recommended subset of the CommonGood Atlas ontology."
  wide
>
  <PageHero
    slot="pageHero"
    eyebrow="Build your model"
    title="Model Your Program"
    description="Answer practical questions about how your grantmaking works. CommonGood Atlas will identify the concepts most relevant to your program as you go."
  >
    <span slot="meta" class="page-hero-meta-item">{DESIGN_QUESTIONS.length} questions</span>
    <span slot="meta" class="page-hero-meta-item">Personalized concept set</span>
    <span slot="meta" class="page-hero-meta-item">Shareable result</span>
  </PageHero>
  <DesignWizard client:load base={base} />
</BaseLayout>
