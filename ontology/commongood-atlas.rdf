    <npo:cardinality>one</npo:cardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/properties/reporting-requirement-due-date">
    <rdfs:label>Due Date</rdfs:label>
    <rdfs:comment>When a specific instance of this report is due.</rdfs:comment>
