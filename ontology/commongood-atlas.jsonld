      "required": true,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "active",
        "completed",
        "terminated"
      ]
    },
    {
      "id": "npoprop:target-target-date",
      "label": "Target Date",
      "comment": "The date by which the target value is expected to be reached.",
      "domain": "npo:target",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:date"
    },
    {
      "id": "npoprop:target-value",
      "label": "Value",
      "comment": "The planned value for the indicator (e.g. \"70%\", \"500 households\"). A plain string so it can hold a numeric, percentage, or other planned value without a separate typed field per kind of indicator.",
      "domain": "npo:target",
      "group": "lifecycle",
      "required": true,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string"
    },
    {
      "id": "npoprop:terms-and-conditions-restriction-type",
      "label": "Restriction Type",
      "comment": "Whether the funding governed by these Terms and Conditions is Restricted or Unrestricted Funding. A coarse flag, superseded for new data by one or more structured Use Restriction Grant Terms (see grant-term), which can express what specifically the funding is restricted to or from -- retained here for backward compatibility.",
      "domain": "npo:terms-and-conditions",
      "group": "governance",
      "required": true,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "restricted",
        "unrestricted"
      ]
    },
    {
      "id": "npoprop:use-restriction-restricted-to",
      "label": "Restricted To",
      "comment": "Free-text naming what the funds are specifically restricted to (e.g. a project or program name), where applicable.",
      "domain": "npo:use-restriction",
      "group": "classification",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string"
    },
    {
      "id": "npoprop:use-restriction-restriction-mode",
      "label": "Restriction Mode",
      "comment": "Whether this restriction requires a use, merely permits it, or prohibits it. An Award may carry more than one Use Restriction with different modes (e.g. a required-use restriction to a project, and a separate prohibited-use restriction on lobbying).",
      "domain": "npo:use-restriction",
      "group": "classification",
      "required": false,
      "cardinality": "one",
      "type": "owl:DatatypeProperty",
      "range": "xsd:string",
      "allowedValues": [
        "required-use",
        "permitted-use",
        "prohibited-use"
      ]
    },
    {
      "id": "npoprop:use-restriction-restriction-type",
      "label": "Restriction Type",
      "comment": "The nature of what this Use Restriction limits grant funds to or from.",
      "domain": "npo:use-restriction",
      "group": "classification",
      "required": true,
      "cardinality": "one",
      "type": "owl:ObjectProperty",
      "range": "skos:Concept",
      "referenceScheme": "nporef:use-restriction-type"
    },
    {
      "id": "nporule:rule-active-role-requires-effective-from",
      "type": "npo:BusinessRule",
      "label": "An active role must have an effective start date",
      "comment": "A Role occupancy with status Active must specify Effective From -- a role cannot be considered in effect without a defined start.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities",
      "appliesTo": [
        "npo:role",
        "npo:person-role",
        "npo:organization-role"
      ]
    },
    {
      "id": "nporule:rule-amendment-not-retroactive",
      "type": "npo:BusinessRule",
      "label": "An Amendment is forward-looking, not retroactive",
      "comment": "An Amendment changes the Grant Agreement going forward; it does not retroactively alter Payments or Reports already completed under the prior terms.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:amendment",
        "npo:grant-agreement",
        "npo:payment",
        "npo:report"
      ]
    },
    {
      "id": "nporule:rule-award-requires-approved-decision",
      "type": "npo:BusinessRule",
      "label": "An Award requires an approved Decision",
      "comment": "An Award cannot exist without a Decision that approved an Application (or, in funder-initiated giving, an equivalent internal approval).",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:award",
        "npo:decision",
        "npo:application"
      ]
    },
    {
      "id": "nporule:rule-classification-assignment-allocation-should-sum-to-100",
      "type": "npo:BusinessRule",
      "label": "Allocation percentages should sum to 100 when allocation is asserted complete",
      "comment": "When a classified resource's Classification Assignments for a given scheme carry an Allocation Percentage, those percentages should sum to 100 once the allocation is asserted as complete. An incomplete sum is a data-quality signal to surface, not a gap to silently renormalize or complete on the resource's behalf.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#classification",
      "appliesTo": [
        "npo:classification-assignment",
        "npo:award",
        "npo:population"
      ]
    },
    {
      "id": "nporule:rule-classification-assignment-at-most-one-primary",
      "type": "npo:BusinessRule",
      "label": "At most one primary Classification Assignment per resource and scheme",
      "comment": "For a given classified resource (e.g. an Award or a Population) and a given classification scheme, at most one Classification Assignment should have Is Primary set to true -- multiple simultaneous primaries make Primary-mode reporting ambiguous about which classification the resource is chiefly attributed to.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#classification",
      "appliesTo": [
        "npo:classification-assignment",
        "npo:award",
        "npo:population"
      ]
    },
    {
      "id": "nporule:rule-classification-rolls-up-not-down",
      "type": "npo:BusinessRule",
      "label": "Classification rolls upward through broader terms, never downward",
      "comment": "A Classification Assignment's Classification Concept Code rolls upward through that concept's Broader chain for reporting purposes -- a resource explicitly classified under a narrower term is implicitly also covered by every broader ancestor. The reverse never holds: a resource explicitly classified under a broader term is not implicitly classified under any of its more specific descendants, since the source data made no claim that specific.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#classification",
      "appliesTo": [
        "npo:classification-assignment"
      ]
    },
    {
      "id": "nporule:rule-closeout-requires-payments-and-reports",
      "type": "npo:BusinessRule",
      "label": "Closeout requires both financial and reporting conditions",
      "comment": "Closeout requires both financial conditions (all Payments made or the award formally reduced) and reporting conditions (all required Reports accepted) to be true.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:closeout",
        "npo:payment",
        "npo:report"
      ]
    },
    {
      "id": "nporule:rule-compliance-requirement-attaches-to-award",
      "type": "npo:BusinessRule",
      "label": "A Compliance Requirement attaches to a specific Award, not the Grantee in the abstract",
      "comment": "A Compliance Requirement is always attached to a specific Award, not to the Grantee in the abstract -- the same organization can be in good standing on one award and delinquent on another.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:compliance-requirement",
        "npo:award",
        "npo:grantee"
      ]
    },
    {
      "id": "nporule:rule-grant-recommendation-non-binding",
      "type": "npo:BusinessRule",
      "label": "A Grant Recommendation is non-binding",
      "comment": "A Donor Advisor's Grant Recommendation does not itself obligate a Donor-Advised Fund to make an Award; the fund's sponsoring organization retains final legal authority over whether to accept it.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md",
      "appliesTo": [
        "npo:grant-recommendation",
        "npo:donor-advised-fund",
        "npo:award"
      ]
    },
    {
      "id": "nporule:rule-grant-term-should-identify-its-award",
      "type": "npo:BusinessRule",
      "label": "A Grant Term should identify which Award it applies to",
      "comment": "A Grant Term should specify the Award it applies to (via Grant Term Applies To Award, or, for a Compliance Requirement, its own existing Applies To Award relationship), unless it is still in draft or unnormalized form -- an Award-less Grant Term that has completed normalization is missing the link that makes it actionable.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms",
      "appliesTo": [
        "npo:grant-term",
        "npo:use-restriction",
        "npo:grant-condition",
        "npo:approval-requirement",
        "npo:reporting-requirement",
        "npo:compliance-requirement",
        "npo:award"
      ]
    },
    {
      "id": "nporule:rule-installment-condition-before-payment",
      "type": "npo:BusinessRule",
      "label": "An Installment's Payment Condition must be met before release",
      "comment": "An Installment's Payment Condition, if any, must be satisfied before its corresponding Payment is released.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:installment",
        "npo:payment-condition",
        "npo:payment"
      ]
    },
    {
      "id": "nporule:rule-payment-requires-award-and-agreement",
      "type": "npo:BusinessRule",
      "label": "A Payment requires an Award, typically with a Grant Agreement",
      "comment": "A Payment cannot exist without an Award and, typically, a Grant Agreement -- though some funders disburse an initial installment before a fully signed agreement is in place.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#key-relationship-rules-draft",
      "appliesTo": [
        "npo:payment",
        "npo:award",
        "npo:grant-agreement"
      ]
    },
    {
      "id": "nporule:rule-role-effective-to-not-before-from",
      "type": "npo:BusinessRule",
      "label": "A role's effective end date must not precede its start date",
      "comment": "A Role occupancy's Effective To, if present, must not be earlier than its Effective From.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities",
      "appliesTo": [
        "npo:role",
        "npo:person-role",
        "npo:organization-role"
      ]
    },
    {
      "id": "nporule:rule-role-occupancy-requires-context-unless-organization-wide",
      "type": "npo:BusinessRule",
      "label": "A role occupancy should identify its context unless explicitly organization-wide",
      "comment": "A Role occupancy should specify what it applies within (via appliesWithin), unless its Scope is explicitly organization-wide -- a role with neither a context nor an organization-wide scope is ambiguous about what it actually governs.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities",
      "appliesTo": [
        "npo:role",
        "npo:person-role",
        "npo:organization-role"
      ]
    },
    {
      "id": "nporule:rule-role-occupancy-requires-holder",
      "type": "npo:BusinessRule",
      "label": "A role occupancy must identify its role holder",
      "comment": "An instance of a Person Role must be held by a Person (via playsRole); an instance of an Organization Role must be held by an Organization (via playsRole). A role occupancy with no holder is not a valid occupancy, only a role definition.",
      "isDefinedBy": "https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities",
      "appliesTo": [
        "npo:role",
        "npo:person-role",
        "npo:organization-role",
        "npo:person",
        "npo:organization"
      ]
    },
    {
      "id": "nporef:candid-pcs-populations",
      "type": "skos:ConceptScheme",
      "prefLabel": "Candid PCS Populations",
      "definition": "A small illustrative subset of Candid's Philanthropy Classification System (PCS) Populations facet, used to demonstrate CommonGood Atlas's classification-assignment mechanism -- NOT a reproduction of Candid's actual licensed PCS taxonomy. Real codes and coverage should be imported from Candid's own published taxonomy release before this scheme is used for anything beyond illustration. Multiple population classifications on the same Population resource are valid, since a population may have several characteristics at once.",
      "schemeDomain": "classification",
      "authorityType": "external",
      "version": "illustrative-subset",
      "publicationStatus": "nporef:publication-status-draft"
    },
