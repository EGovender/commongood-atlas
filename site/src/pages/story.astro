---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import {
  workedExample,
  getConcept,
  getPropertiesForConcept,
  type ExampleIndividual,
  type Property,
} from '../data/ontology';
import { getCategory } from '../data/categories';
import { getReferenceScheme } from '../data/reference-data';

const base = import.meta.env.BASE_URL;

// Hand-authored UI content describing each narrative thread -- like
// design-questions.ts, this is presentation logic layered on top of the
// ontology's own worked-example data, not an ontology claim itself, so it
// lives here rather than in ontology/source/example.json.
const SCENARIO_META: Record<string, { description: string; complexity: 'Simple' | 'Moderate' | 'Complex' }> = {
  'direct-grant': { description: 'A funder awards directly to a single grantee, start to finish.', complexity: 'Simple' },
  'fiscal-sponsorship': {
    description: "A funder supports a project that doesn't have its own nonprofit status, via a fiscal sponsor.",
    complexity: 'Moderate',
  },
  'donor-advised-fund': {
    description: 'A donor recommends grants from a fund the sponsoring organization legally controls.',
    complexity: 'Moderate',
  },
  regranting: {
    description: 'One organization receives funds and redistributes them to its own sub-grantees.',
    complexity: 'Moderate',
  },
  'collaborative-fund': {
    description: 'Two funders pool contributions into one fund and jointly award a grant.',
    complexity: 'Complex',
  },
  'contractor-relationship': {
    description: 'An organization engages a contractor directly, outside the philanthropic-arrangement pattern.',
    complexity: 'Simple',
  },
};
const DEFAULT_SCENARIO_META = { description: 'A connected thread in the worked example.', complexity: 'Moderate' as const };

// Financial-group decimal properties that are unconditionally a percentage
// per their own definition (never a dollar amount, so no sibling unit field
// exists to check).
const PERCENTAGE_DECIMAL_PROPERTY_IDS = new Set(['indirect-cost-rate-rate', 'fiscal-sponsorship-arrangement-fee-percentage']);

/** Renders a property value the way someone reading the story (not the raw
 * data) would expect: reference-backed codes as their scheme label, decimals
 * in the "financial" group with thousands separators (using a sibling
 * `thresholdUnit` property, where one exists on the individual, to tell a
 * percentage or other unit apart from a dollar amount -- properties.json's
 * threshold-value/approval-threshold properties are unit-agnostic numbers,
 * not currency, despite living in the "financial" group), dates spelled out,
 * booleans as Yes/No, other enums title-cased. Falls back to the raw value
 * for anything that doesn't map cleanly, rather than guessing. */
function formatPropertyValue(pdef: Property | undefined, value: string, siblingProperties?: Record<string, string>): string {
  if (!pdef) return value;
  if (pdef.datatype === 'reference' && pdef.referenceScheme) {
    const match = getReferenceScheme(pdef.referenceScheme).values.find((v) => v.code === value);
    return match ? match.label : value;
  }
  if (pdef.datatype === 'decimal') {
    const num = Number(value);
    if (!Number.isFinite(num)) return value;
    const formatted = num.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (PERCENTAGE_DECIMAL_PROPERTY_IDS.has(pdef.id)) return `${formatted}%`;
    const unit = siblingProperties?.thresholdUnit;
    if (unit) return unit.toLowerCase() === 'usd' ? `$${formatted}` : unit.toLowerCase() === 'percent' ? `${formatted}%` : `${formatted} ${unit}`;
    return pdef.group === 'financial' ? `$${formatted}` : formatted;
  }
  if (pdef.datatype === 'date') {
    const d = new Date(`${value}T00:00:00`);
    return Number.isNaN(d.getTime()) ? value : d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }
  if (pdef.datatype === 'boolean') {
    return value === 'true' ? 'Yes' : 'No';
  }
  if (pdef.datatype === 'enum') {
    return value.split('-').map((w) => w[0]?.toUpperCase() + w.slice(1)).join(' ');
  }
  return value;
}

interface Stage {
  id: string;
  label: string;
  colorLight: string;
  colorDark: string;
}

interface Scenario {
  id: string;
  label: string;
  stages: Stage[];
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/^a \w+ engagement:\s*/i, '')
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

function shortLabel(act: string): string {
  return act.replace(/^A \w+ Engagement:\s*/i, '').trim();
}

function stagesFor(individuals: ExampleIndividual[]): Stage[] {
  const stages: Stage[] = [];
  const seen = new Set<string>();
  for (const ind of individuals) {
    const concept = getConcept(ind.concept);
    if (!concept || seen.has(concept.category)) continue;
    seen.add(concept.category);
    const cat = getCategory(concept.category);
    stages.push({ id: concept.category, label: cat.label, colorLight: cat.colorLight, colorDark: cat.colorDark });
  }
  return stages;
}

// Split the flat individuals list into scenarios wherever an `act` marks the
// start of a new thread -- everything before the first `act` is the base
// "Direct Grant" scenario (see docs/07-worked-example.md for why the whole
// worked example is one file, not several).
const scenarios: Scenario[] = [];
const scenarioIdByIndividualId = new Map<string, string>();
let bucket: ExampleIndividual[] = [];
let bucketId = 'direct-grant';
let bucketLabel = 'Direct Grant';

function flushBucket() {
  if (bucket.length === 0) return;
  scenarios.push({ id: bucketId, label: bucketLabel, stages: stagesFor(bucket) });
  for (const ind of bucket) scenarioIdByIndividualId.set(ind.id, bucketId);
}

for (const individual of workedExample.individuals) {
  if (individual.act) {
    flushBucket();
    bucket = [];
    bucketId = slugify(individual.act);
    bucketLabel = shortLabel(individual.act);
  }
  bucket.push(individual);
}
flushBucket();
---

<BaseLayout title="Worked Example" description={workedExample.summary}>
  <PageHero slot="pageHero" eyebrow="Worked Example" title={workedExample.title} description={workedExample.summary}>
    <span slot="meta" class="page-hero-meta-item">All names are fictional</span>
    <span slot="meta" class="page-hero-meta-item">Validated against the ontology</span>
  </PageHero>
  <p class="muted story-intro-note" style="max-width: 65ch;">
    Each step is a real instance of a concept in the ontology - see{' '}
    <a href="https://github.com/EGovender/commongood-atlas/blob/main/docs/07-worked-example.md">docs/07-worked-example.md</a>{' '}
    for how it was built and validated.
  </p>

  <div class="page-panel story-scenario-panel">
    <span class="page-section-kicker">Choose a scenario</span>
    <div class="story-scenario-cards" role="tablist" aria-label="Choose a scenario">
      {
        scenarios.map((s, i) => {
          const meta = SCENARIO_META[s.id] ?? DEFAULT_SCENARIO_META;
          return (
            <button
              type="button"
              class={`card story-scenario-card${i === 0 ? ' active' : ''}`}
              data-scenario={s.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="story-scenario-card-label">{s.label}</span>
              <span class="secondary story-scenario-card-desc">{meta.description}</span>
              <span class={`badge story-scenario-complexity story-scenario-complexity-${meta.complexity.toLowerCase()}`}>
                {meta.complexity}
              </span>
            </button>
          );
        })
      }
    </div>
    <div class="story-tools-row">
      <button type="button" class="link-button story-scenario-tab" data-scenario="all" aria-pressed="false">
        Show all scenarios combined
      </button>
      <label class="story-tech-toggle">
        <input type="checkbox" id="story-show-technical" />
        Show technical field names and raw values
      </label>
    </div>
  </div>

  {
    scenarios.map((s) => (
      <div class="story-stage-bar" data-stage-bar={s.id} hidden>
        {s.stages.map((stage) => (
          <button
            type="button"
            class="story-stage-pill"
            data-stage={stage.id}
            data-stage-scenario={s.id}
            style={`--stage-color: light-dark(${stage.colorLight}, ${stage.colorDark})`}
          >
            {stage.label}
          </button>
        ))}
      </div>
    ))
  }

  <ol class="story-timeline">
    {
      workedExample.individuals.map((individual) => {
        const concept = getConcept(individual.concept);
        if (!concept) return null;
        const category = getCategory(concept.category);
        const propertyEntries = Object.entries(individual.properties);
        const conceptProperties = getPropertiesForConcept(concept.id);
        const scenarioId = scenarioIdByIndividualId.get(individual.id) ?? 'direct-grant';
        return (
          <>
            {individual.act && (
              <li class="story-act" data-scenario={scenarioId} aria-hidden="false">
                <h2 class="story-act-title">{individual.act}</h2>
              </li>
            )}
            <li
              class="story-step"
              data-scenario={scenarioId}
              data-stage={concept.category}
              style={`--stage-color: light-dark(${category.colorLight}, ${category.colorDark})`}
            >
              <div class="story-step-marker" style={`background: light-dark(${category.colorLight}, ${category.colorDark})`} />
              <div class="story-step-body">
                <div class="story-step-header">
                  <a class="story-step-concept" href={`${base}concepts/${concept.id}`}>
                    {concept.label}
                  </a>
                  <span class="muted story-step-label">{individual.label}</span>
                </div>
                <p class="story-step-narrative">{individual.narrative}</p>
                {propertyEntries.length > 0 && (
                  <>
                    <div class="story-step-props story-step-props-human">
                      {propertyEntries.map(([name, value]) => {
                        const pdef = conceptProperties.find((p) => p.name === name);
                        return (
                          <span class="chip">
                            {pdef?.label ?? name}: {formatPropertyValue(pdef, value, individual.properties)}
                          </span>
                        );
                      })}
                    </div>
                    <div class="story-step-props story-step-props-tech" hidden>
                      {propertyEntries.map(([name, value]) => (
                        <span class="chip">
                          {name}: {value}
                        </span>
                      ))}
                    </div>
                  </>
                )}
                <a class="story-step-graph-link" href={`${base}explore?concept=${concept.id}`}>
                  Open in graph &rarr;
                </a>
              </div>
            </li>
          </>
        );
      })
    }
  </ol>

  <script>
    const tabs = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.story-scenario-card, .story-scenario-tab')
    );
    const steps = Array.from(document.querySelectorAll<HTMLLIElement>('.story-step'));
    const acts = Array.from(document.querySelectorAll<HTMLLIElement>('.story-act'));
    const stageBars = Array.from(document.querySelectorAll<HTMLDivElement>('.story-stage-bar'));
    const stagePills = Array.from(document.querySelectorAll<HTMLButtonElement>('.story-stage-pill'));
    const technicalToggle = document.getElementById('story-show-technical') as HTMLInputElement | null;

    // Clicking a stage pill below scrolls its step to the top of the
    // viewport -- exactly where the sticky stage bar itself sits, so
    // without this the step's heading ends up hidden underneath it.
    // Recomputed on resize and whenever the visible stage bar changes
    // (switching scenarios can change its pill count/wrapping).
    function updateStageOffset() {
      const bar = stageBars.find((b) => !b.hidden);
      if (!bar) return;
      document.documentElement.style.setProperty('--story-stage-offset', `${bar.getBoundingClientRect().height + 16}px`);
    }
    updateStageOffset();
    window.addEventListener('resize', updateStageOffset);

    // Default to the first real scenario (Direct Grant), not "All" -- the
    // longest, most complex view shouldn't be what a first-time visitor
    // lands on. An explicit ?scenario= (including "all") still wins.
    const defaultScenario = tabs.find((t) => t.dataset.scenario && t.dataset.scenario !== 'all')?.dataset.scenario ?? 'all';

    function readScenarioFromURL(): string {
      return new URLSearchParams(location.search).get('scenario') || defaultScenario;
    }

    function updateActiveStage(scenarioId: string) {
      const bar = stageBars.find((b) => b.dataset.stageBar === scenarioId);
      if (!bar) return;
      const pills = Array.from(bar.querySelectorAll<HTMLSpanElement>('.story-stage-pill'));
      const visibleSteps = steps.filter((s) => s.dataset.scenario === scenarioId);
      const threshold = bar.getBoundingClientRect().bottom + 20;
      let activeStage = visibleSteps[0]?.dataset.stage;
      for (const s of visibleSteps) {
        if (s.getBoundingClientRect().top <= threshold) activeStage = s.dataset.stage;
        else break;
      }
      pills.forEach((p) => p.classList.toggle('active', p.dataset.stage === activeStage));
    }

    function setScenario(id: string) {
      tabs.forEach((t) => {
        const active = t.dataset.scenario === id;
        t.classList.toggle('active', active);
        t.setAttribute('aria-pressed', String(active));
      });
      steps.forEach((s) => {
        s.hidden = id !== 'all' && s.dataset.scenario !== id;
      });
      acts.forEach((a) => {
        a.hidden = id !== 'all' && a.dataset.scenario !== id;
      });
      stageBars.forEach((b) => {
        b.hidden = id === 'all' || b.dataset.stageBar !== id;
      });
      updateStageOffset();

      const params = new URLSearchParams();
      if (id !== 'all') params.set('scenario', id);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);

      if (id !== 'all') updateActiveStage(id);
    }

    tabs.forEach((t) => t.addEventListener('click', () => setScenario(t.dataset.scenario!)));

    let ticking = false;
    document.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const current = tabs.find((t) => t.classList.contains('active'))?.dataset.scenario ?? 'all';
          if (current !== 'all') updateActiveStage(current);
          ticking = false;
        });
      },
      { passive: true }
    );

    stagePills.forEach((pill) =>
      pill.addEventListener('click', () => {
        const scenarioId = pill.dataset.stageScenario!;
        const stage = pill.dataset.stage!;
        const target = steps.find((s) => s.dataset.scenario === scenarioId && s.dataset.stage === stage && !s.hidden);
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
    );

    technicalToggle?.addEventListener('change', () => {
      const showTechnical = technicalToggle.checked;
      document.querySelectorAll<HTMLElement>('.story-step-props-human').forEach((el) => {
        el.hidden = showTechnical;
      });
      document.querySelectorAll<HTMLElement>('.story-step-props-tech').forEach((el) => {
        el.hidden = !showTechnical;
      });
    });

    setScenario(readScenarioFromURL());
  </script>
</BaseLayout>
