    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-populations" />
    <skos:notation>people-of-color</skos:notation>
    <skos:prefLabel>People of Color</skos:prefLabel>
    <skos:definition>Illustrative placeholder for Candid PCS's People of Color population.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-populations-young-adults">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-populations" />
    <skos:notation>young-adults</skos:notation>
    <skos:prefLabel>Young Adults</skos:prefLabel>
    <skos:definition>Illustrative placeholder for Candid PCS's Young Adults population.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <skos:prefLabel>Candid PCS Subjects</skos:prefLabel>
    <skos:definition>A small illustrative subset of Candid's Philanthropy Classification System (PCS) Subjects facet, used to demonstrate CommonGood Atlas's classification-assignment mechanism -- NOT a reproduction of Candid's actual licensed PCS taxonomy. Real codes, hierarchy, and coverage should be imported from Candid's own published taxonomy release before this scheme is used for anything beyond illustration. affordable-housing's mapping to CommonGood's own issue-area-housing uses broadMatch, not exactMatch, since Affordable Housing is more specific than the CommonGood Housing issue area.</skos:definition>
    <npo:schemeDomain>classification</npo:schemeDomain>
    <npo:authorityType>external</npo:authorityType>
    <npo:version>illustrative-subset</npo:version>
    <npo:publicationStatus rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/publication-status-draft" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects-affordable-housing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects" />
    <skos:notation>affordable-housing</skos:notation>
    <skos:prefLabel>Affordable Housing</skos:prefLabel>
    <skos:definition>Illustrative placeholder for Candid PCS's Affordable Housing subject.</skos:definition>
    <skos:broader rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects-housing-development" />
    <skos:broadMatch rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/issue-area-housing" />
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects-economic-development">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/candid-pcs-subjects" />
