@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix npo: <https://egovender.github.io/commongood-atlas/ontology/> .
@prefix npoprop: <https://egovender.github.io/commongood-atlas/ontology/properties/> .
@prefix nporef: <https://egovender.github.io/commongood-atlas/ontology/reference-data/> .
@prefix nporel: <https://egovender.github.io/commongood-atlas/ontology/relations/> .
@prefix nporule: <https://egovender.github.io/commongood-atlas/ontology/rules/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

npo:BusinessRule a rdfs:Class ;
    rdfs:label "Business Rule" .

<https://egovender.github.io/commongood-atlas/ontology> a owl:Ontology ;
    rdfs:label "CommonGood Atlas Grantmaking Ontology" ;
    rdfs:comment "Generated from ontology/source/*.json. Do not hand-edit. See docs/05-data-model.md and docs/06-properties-and-rules.md." ;
    npo:version "0.3.0" .

npo:applicant-contact a owl:Class ;
    rdfs:label "Applicant Contact" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:person-role ;
    skos:definition "The role a person occupies when they serve as the primary point of contact for an application submitted on behalf of an organization or project." ;
    npo:category "organizational-entities" .

npo:authorized-signatory a owl:Class ;
    rdfs:label "Authorized Signatory" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:person-role ;
    skos:definition "The role a person occupies when they are authorized to sign a grant agreement or other governing document on behalf of an organization." ;
    npo:category "organizational-entities" .

npo:board-member a owl:Class ;
    rdfs:label "Board Member" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:person-role ;
    skos:definition "The role a person occupies when they serve on an organization's governing board." ;
    npo:category "organizational-entities" .

npo:consultant a owl:Class ;
    rdfs:label "Consultant" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:person-role ;
    skos:definition "The role a person occupies when they provide paid, defined-scope services to an organization without being its employee." ;
    npo:category "organizational-entities" .

npo:contractor a owl:Class ;
    rdfs:label "Contractor" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:organization-role ;
    skos:definition "The role an organization occupies when it is bound by a contract to deliver a specific, defined piece of work for another organization." ;
    npo:category "organizational-entities" .

npo:donor a owl:Class ;
    rdfs:label "Donor" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:person-role ;
    skos:definition "The role a person occupies when they contribute charitable funds to an organization or fund, without necessarily holding advisory privileges over how they are used." ;
    npo:category "organizational-entities" .

npo:employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:person-role ;
    skos:definition "The role a person occupies when they work for and are compensated by an organization." ;
    npo:category "organizational-entities" .

npo:employer a owl:Class ;
    rdfs:label "Employer" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:organization-role ;
    skos:definition "The role an organization occupies when it employs a person -- the organization-side counterpart to that person's Employee role." ;
    npo:category "organizational-entities" .

npo:funding-intermediary-role a owl:Class ;
    rdfs:label "Funding Intermediary Role" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:organization-role ;
    skos:definition "The role an organization occupies when it channels funds between an original funding source and an ultimate grantee, without itself being the original funder or the final recipient." ;
    npo:category "organizational-entities" .

npo:partner a owl:Class ;
    rdfs:label "Partner" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:organization-role ;
    skos:definition "The role an organization occupies when it collaborates with another organization on shared work, in a relationship not adequately described as one party purchasing from or providing a service to the other." ;
    npo:category "organizational-entities" .

npo:philanthropic-intermediary a owl:Class ;
    rdfs:label "Philanthropic Intermediary" ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:subClassOf npo:organization ;
    skos:definition "An organization commonly known for facilitating philanthropy on behalf of others -- such as by re-granting, fiscal sponsorship, or hosting donor-advised funds -- regardless of which specific role it occupies in a given arrangement." ;
    npo:category "organizational-entities" .

npoprop:amendment-effective-date a owl:DatatypeProperty ;
    rdfs:label "Effective Date" ;
    rdfs:comment "When the Amendment's changes take effect." ;
    rdfs:domain npo:amendment ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:amendment-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Amendment stands in its approval process." ;
    rdfs:domain npo:amendment ;
    rdfs:range xsd:string ;
    npo:allowedValue "approved",
        "executed",
        "proposed" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:application-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Application currently sits in the review process." ;
    rdfs:domain npo:application ;
    rdfs:range xsd:string ;
    npo:allowedValue "approved",
        "declined",
        "draft",
        "submitted",
        "under-review" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:application-submitted-date a owl:DatatypeProperty ;
    rdfs:label "Submitted Date" ;
    rdfs:comment "When the Application was submitted, once it has been." ;
    rdfs:domain npo:application ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:approval-requirement-approval-date a owl:DatatypeProperty ;
    rdfs:label "Approval Date" ;
    rdfs:comment "When approval was granted, once it has been." ;
    rdfs:domain npo:approval-requirement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:approval-requirement-approval-status a owl:DatatypeProperty ;
    rdfs:label "Approval Status" ;
    rdfs:comment "Where a specific instance of this approval requirement stands." ;
    rdfs:domain npo:approval-requirement ;
    rdfs:range xsd:string ;
    npo:allowedValue "approved",
        "denied",
        "not-applicable",
        "not-requested",
        "requested" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:approval-requirement-approval-threshold a owl:DatatypeProperty ;
    rdfs:label "Approval Threshold" ;
    rdfs:comment "The numeric threshold above which prior approval is required, where applicable (e.g. 10 for a 10% budget-reallocation threshold)." ;
    rdfs:domain npo:approval-requirement ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:approval-requirement-approval-type a owl:DatatypeProperty ;
    rdfs:label "Approval Type" ;
    rdfs:comment "What kind of change, expenditure, action, or deviation this Approval Requirement governs." ;
    rdfs:domain npo:approval-requirement ;
    rdfs:range xsd:string ;
    npo:allowedValue "budget-reallocation",
        "capital-purchase",
        "contractor",
        "equipment-disposition",
        "equipment-purchase",
        "geographic-change",
        "key-personnel-change",
        "other",
        "population-change",
        "project-change",
        "regrant",
        "scope-change",
        "subgrant",
        "timeline-extension",
        "travel" ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required true .

npoprop:approval-requirement-threshold-unit a owl:DatatypeProperty ;
    rdfs:label "Threshold Unit" ;
    rdfs:comment "The unit the approval threshold is expressed in (e.g. percent, USD)." ;
    rdfs:domain npo:approval-requirement ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:audit-scheduled-date a owl:DatatypeProperty ;
    rdfs:label "Scheduled Date" ;
    rdfs:comment "When the Audit is scheduled to occur." ;
    rdfs:domain npo:audit ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:audit-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Audit stands." ;
    rdfs:domain npo:audit ;
    rdfs:range xsd:string ;
    npo:allowedValue "completed",
        "in-progress",
        "scheduled" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:award-amount a owl:DatatypeProperty ;
    rdfs:label "Amount" ;
    rdfs:comment "The total amount committed under the Award." ;
    rdfs:domain npo:award ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:award-currency a owl:DatatypeProperty ;
    rdfs:label "Currency" ;
    rdfs:comment "The currency the Award amount is denominated in, if not implied by context." ;
    rdfs:domain npo:award ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:award-date a owl:DatatypeProperty ;
    rdfs:label "Award Date" ;
    rdfs:comment "When the Award was made." ;
    rdfs:domain npo:award ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:award-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Award currently sits in the grant lifecycle." ;
    rdfs:domain npo:award ;
    rdfs:range xsd:string ;
    npo:allowedValue "active",
        "approved",
        "closed",
        "proposed",
        "terminated" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:budget-modification-amount a owl:DatatypeProperty ;
    rdfs:label "Amount" ;
    rdfs:comment "The amount being moved between budget categories." ;
    rdfs:domain npo:budget-modification ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:budget-modification-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the funder has approved the requested Budget Modification." ;
    rdfs:domain npo:budget-modification ;
    rdfs:range xsd:string ;
    npo:allowedValue "approved",
        "denied",
        "requested" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:budget-total-amount a owl:DatatypeProperty ;
    rdfs:label "Total Amount" ;
    rdfs:comment "The sum of all budget categories in the proposed or funded Budget." ;
    rdfs:domain npo:budget ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:classification-assignment-allocation-percentage a owl:DatatypeProperty ;
    rdfs:label "Allocation Percentage" ;
    rdfs:comment "An actual distribution of the classified resource's value across classifications, only stored when supported by real source information -- never inferred to make reporting additive." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:classification-assignment-assigned-at a owl:DatatypeProperty ;
    rdfs:label "Assigned At" ;
    rdfs:comment "When this classification assignment was created or imported." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:classification-assignment-assignment-method a owl:DatatypeProperty ;
    rdfs:label "Assignment Method" ;
    rdfs:comment "How this classification was assigned. Ancestor classifications reached via the scheme's broader hierarchy are not normally stored as their own assignment with this field -- they're computed from the hierarchy at reporting time instead." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range xsd:string ;
    npo:allowedValue "imported",
        "manual",
        "source-provided" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:classification-assignment-assignment-source a owl:DatatypeProperty ;
    rdfs:label "Assignment Source" ;
    rdfs:comment "Where this classification originated (e.g. \"Candid import\", \"manual CommonGood assignment\")." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:classification-assignment-classification-concept-code a owl:DatatypeProperty ;
    rdfs:label "Classification Concept Code" ;
    rdfs:comment "The code of the term selected from the named classificationScheme (e.g. \"affordable-housing\"). A plain string, not independently validated against that scheme -- a reference-typed property's referenceScheme must be one fixed scheme declared on the property itself, and this field's scheme genuinely varies per instance. See docs/06-properties-and-rules.md for the full explanation of this known limitation." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required true .

npoprop:classification-assignment-classification-scheme a owl:ObjectProperty ;
    rdfs:label "Classification Scheme" ;
    rdfs:comment "Which classification scheme classificationConceptCode is drawn from." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:referenceScheme nporef:classification-scheme-registry ;
    npo:required true .

npoprop:classification-assignment-is-primary a owl:DatatypeProperty ;
    rdfs:label "Is Primary" ;
    rdfs:comment "Whether this is the exclusive reporting classification for the classified resource within this scheme. At most one Classification Assignment per classified resource + scheme should be primary -- see business rules." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range xsd:boolean ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:classification-assignment-taxonomy-version a owl:DatatypeProperty ;
    rdfs:label "Taxonomy Version" ;
    rdfs:comment "The version or release of the classification scheme used for this assignment, so historical assignments retain the taxonomy version they were made under." ;
    rdfs:domain npo:classification-assignment ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:closeout-date a owl:DatatypeProperty ;
    rdfs:label "Closeout Date" ;
    rdfs:comment "When Closeout was completed." ;
    rdfs:domain npo:closeout ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:closeout-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the Award's Closeout has been completed." ;
    rdfs:domain npo:closeout ;
    rdfs:range xsd:string ;
    npo:allowedValue "completed",
        "pending" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:compliance-requirement-requirement-type a owl:DatatypeProperty ;
    rdfs:label "Requirement Type" ;
    rdfs:comment "The kind of obligation the Compliance Requirement imposes." ;
    rdfs:domain npo:compliance-requirement ;
    rdfs:range xsd:string ;
    npo:allowedValue "acknowledgement",
        "audit",
        "books-and-records-access",
        "certification",
        "conflict-disclosure",
        "data-protection",
        "financial",
        "financial-controls",
        "insurance",
        "legal-compliance",
        "notification-of-breach",
        "notification-of-change",
        "other",
        "publicity-requirement",
        "records-retention",
        "reporting",
        "return-unused-funds",
        "tax-status-maintenance" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required true .

npoprop:compliance-requirement-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the Grantee has met the Compliance Requirement." ;
    rdfs:domain npo:compliance-requirement ;
    rdfs:range xsd:string ;
    npo:allowedValue "open",
        "overdue",
        "satisfied" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:decision-date a owl:DatatypeProperty ;
    rdfs:label "Decision Date" ;
    rdfs:comment "When the Decision was made." ;
    rdfs:domain npo:decision ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:decision-outcome a owl:DatatypeProperty ;
    rdfs:label "Outcome" ;
    rdfs:comment "The result of the review process for the Application." ;
    rdfs:domain npo:decision ;
    rdfs:range xsd:string ;
    npo:allowedValue "approved",
        "approved-with-conditions",
        "declined" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:evaluation-completed-date a owl:DatatypeProperty ;
    rdfs:label "Completed Date" ;
    rdfs:comment "When the Evaluation was completed, once it has been." ;
    rdfs:domain npo:evaluation ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:evaluation-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Evaluation stands." ;
    rdfs:domain npo:evaluation ;
    rdfs:range xsd:string ;
    npo:allowedValue "completed",
        "in-progress",
        "planned" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:evidence-claim-claim-type a owl:ObjectProperty ;
    rdfs:label "Claim Type" ;
    rdfs:comment "Whether this claim asserts association, contribution, attribution, or causation." ;
    rdfs:domain npo:evidence-claim ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:referenceScheme nporef:claim-type ;
    npo:required true .

npoprop:evidence-claim-evidence-strength a owl:ObjectProperty ;
    rdfs:label "Evidence Strength" ;
    rdfs:comment "How strong the supporting evidence is for this claim." ;
    rdfs:domain npo:evidence-claim ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:referenceScheme nporef:evidence-strength ;
    npo:required true .

npoprop:fiscal-sponsorship-arrangement-fee-percentage a owl:DatatypeProperty ;
    rdfs:label "Fee Percentage" ;
    rdfs:comment "The fiscal sponsor's administrative fee, charged as a percentage of funds processed." ;
    rdfs:domain npo:fiscal-sponsorship-arrangement ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:fund-closing-date a owl:DatatypeProperty ;
    rdfs:label "Closing Date" ;
    rdfs:comment "When the fund was closed, if it has been." ;
    rdfs:domain npo:fund ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:fund-currency a owl:DatatypeProperty ;
    rdfs:label "Currency" ;
    rdfs:comment "The currency the fund's balance is denominated in." ;
    rdfs:domain npo:fund ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:fund-opening-date a owl:DatatypeProperty ;
    rdfs:label "Opening Date" ;
    rdfs:comment "When the fund was established." ;
    rdfs:domain npo:fund ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:fund-restriction-type a owl:ObjectProperty ;
    rdfs:label "Restriction Type" ;
    rdfs:comment "The fund's accounting restriction status." ;
    rdfs:domain npo:fund ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:referenceScheme nporef:restriction-type ;
    npo:required true .

npoprop:fund-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the fund is currently active." ;
    rdfs:domain npo:fund ;
    rdfs:range xsd:string ;
    npo:allowedValue "active",
        "closed",
        "frozen" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:funding-cycle-end-date a owl:DatatypeProperty ;
    rdfs:label "End Date" ;
    rdfs:comment "When the Funding Cycle closes." ;
    rdfs:domain npo:funding-cycle ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:funding-cycle-start-date a owl:DatatypeProperty ;
    rdfs:label "Start Date" ;
    rdfs:comment "When the Funding Cycle begins accepting applications." ;
    rdfs:domain npo:funding-cycle ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:funding-opportunity-application-deadline a owl:DatatypeProperty ;
    rdfs:label "Application Deadline" ;
    rdfs:comment "The date by which an Application must be submitted." ;
    rdfs:domain npo:funding-opportunity ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:funding-opportunity-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the Funding Opportunity is still accepting applications." ;
    rdfs:domain npo:funding-opportunity ;
    rdfs:range xsd:string ;
    npo:allowedValue "closed",
        "draft",
        "open" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:grant-agreement-effective-date a owl:DatatypeProperty ;
    rdfs:label "Effective Date" ;
    rdfs:comment "When the Grant Agreement's terms take effect." ;
    rdfs:domain npo:grant-agreement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:grant-agreement-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Grant Agreement stands in its own lifecycle." ;
    rdfs:domain npo:grant-agreement ;
    rdfs:range xsd:string ;
    npo:allowedValue "active",
        "closed",
        "draft",
        "signed" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:grant-condition-condition-barrier-type a owl:ObjectProperty ;
    rdfs:label "Condition Barrier Type" ;
    rdfs:comment "What kind of barrier this condition's entitlement, payment, continuation, release, or retention depends on." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:referenceScheme nporef:condition-barrier-type ;
    npo:required false .

npoprop:grant-condition-condition-status a owl:DatatypeProperty ;
    rdfs:label "Condition Status" ;
    rdfs:comment "Whether this condition has been satisfied. Never inferred solely from dates." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:string ;
    npo:allowedValue "expired",
        "not-applicable",
        "not-satisfied",
        "not-yet-assessed",
        "partially-satisfied",
        "pending",
        "satisfied",
        "waived" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:grant-condition-due-date a owl:DatatypeProperty ;
    rdfs:label "Due Date" ;
    rdfs:comment "The date by which this condition must be satisfied, where applicable." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:grant-condition-failure-consequence a owl:DatatypeProperty ;
    rdfs:label "Failure Consequence" ;
    rdfs:comment "What happens if this condition is not met." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:string ;
    npo:allowedValue "award-reduced",
        "award-suspended",
        "award-terminated",
        "corrective-action-required",
        "funds-withheld",
        "future-funding-affected",
        "future-payment-withheld",
        "none-specified",
        "other",
        "repayment-required",
        "right-of-return" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-condition-has-barrier a owl:DatatypeProperty ;
    rdfs:label "Has Barrier" ;
    rdfs:comment "Whether this condition has a defined barrier that must be overcome. Captures the fact without the ontology itself concluding that the grant is legally or accountingly \"conditional\" -- that determination may require separate accounting or legal analysis." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:boolean ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-condition-has-right-of-release a owl:DatatypeProperty ;
    rdfs:label "Has Right Of Release" ;
    rdfs:comment "Whether satisfying this condition releases funds that were otherwise being withheld." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:boolean ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-condition-has-right-of-return a owl:DatatypeProperty ;
    rdfs:label "Has Right Of Return" ;
    rdfs:comment "Whether failing this condition creates a right for the funder to require return of funds already disbursed." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:boolean ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-condition-threshold-operator a owl:DatatypeProperty ;
    rdfs:label "Threshold Operator" ;
    rdfs:comment "How the threshold value must be compared against to satisfy the condition." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:string ;
    npo:allowedValue "equal",
        "greater-than",
        "greater-than-or-equal",
        "less-than",
        "less-than-or-equal" ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:grant-condition-threshold-unit a owl:DatatypeProperty ;
    rdfs:label "Threshold Unit" ;
    rdfs:comment "The unit the threshold value is expressed in (e.g. USD, percent, participants)." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:grant-condition-threshold-value a owl:DatatypeProperty ;
    rdfs:label "Threshold Value" ;
    rdfs:comment "The numeric threshold this condition's barrier is measured against (e.g. 250000, or 10 for a percentage), where applicable." ;
    rdfs:domain npo:grant-condition ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:grant-program-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Grant Program currently sits in its own lifecycle." ;
    rdfs:domain npo:grant-program ;
    rdfs:range xsd:string ;
    npo:allowedValue "closed",
        "open",
        "planning" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:grant-program-total-budget a owl:DatatypeProperty ;
    rdfs:label "Total Budget" ;
    rdfs:comment "The total amount set aside for this Grant Program, if the funder tracks one." ;
    rdfs:domain npo:grant-program ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:grant-recommendation-amount a owl:DatatypeProperty ;
    rdfs:label "Amount" ;
    rdfs:comment "The amount recommended, if the Donor Advisor specified one." ;
    rdfs:domain npo:grant-recommendation ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:grant-recommendation-date a owl:DatatypeProperty ;
    rdfs:label "Recommendation Date" ;
    rdfs:comment "When the Donor Advisor made the recommendation." ;
    rdfs:domain npo:grant-recommendation ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:grant-recommendation-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the sponsoring organization has acted on the Grant Recommendation." ;
    rdfs:domain npo:grant-recommendation ;
    rdfs:range xsd:string ;
    npo:allowedValue "approved",
        "declined",
        "pending" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:grant-term-effective-from a owl:DatatypeProperty ;
    rdfs:label "Effective From" ;
    rdfs:comment "When this specific term takes effect -- not assumed to equal the whole Grant Agreement's effective date." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:grant-term-effective-until a owl:DatatypeProperty ;
    rdfs:label "Effective Until" ;
    rdfs:comment "When this specific term stops applying, if it has an end date." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:grant-term-normalization-method a owl:DatatypeProperty ;
    rdfs:label "Normalization Method" ;
    rdfs:comment "How this term was normalized from its source. Machine-derived normalization is not treated as equivalent to source-provided structured data." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:string ;
    npo:allowedValue "imported-structured",
        "machine-assisted",
        "manual",
        "reviewed-machine-assisted",
        "rules-based" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-term-normalization-status a owl:DatatypeProperty ;
    rdfs:label "Normalization Status" ;
    rdfs:comment "Whether this term's normalization from source text is complete, partial, or still needs review. Preferred over forcing an uncertain clause into an incorrect category." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:string ;
    npo:allowedValue "mapped",
        "needs-review",
        "not-applicable",
        "partially-mapped",
        "unmapped" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-term-original-term-text a owl:DatatypeProperty ;
    rdfs:label "Original Term Text" ;
    rdfs:comment "The term's original source wording, preserved verbatim. Recommended for imported terms; the normalized classification is an interpretation of this text, not a replacement for it." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-term-source-clause-identifier a owl:DatatypeProperty ;
    rdfs:label "Source Clause Identifier" ;
    rdfs:comment "An identifier tying this term back to the specific source clause it was segmented from -- lets several Grant Terms normalized from one free-text field retain a shared linkage back to that field." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-term-source-field a owl:DatatypeProperty ;
    rdfs:label "Source Field" ;
    rdfs:comment "The source system's field this term was imported from, if any." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-term-source-record-identifier a owl:DatatypeProperty ;
    rdfs:label "Source Record Identifier" ;
    rdfs:comment "The identifier of the source record this term was imported from, if any." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:grant-term-source-system a owl:DatatypeProperty ;
    rdfs:label "Source System" ;
    rdfs:comment "The system this term was imported from (e.g. Tides), if any." ;
    rdfs:domain npo:grant-term ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:indirect-cost-rate-rate a owl:DatatypeProperty ;
    rdfs:label "Rate" ;
    rdfs:comment "The indirect cost rate, expressed as a percentage of direct costs." ;
    rdfs:domain npo:indirect-cost-rate ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:indirect-cost-rate-rate-type a owl:DatatypeProperty ;
    rdfs:label "Rate Type" ;
    rdfs:comment "Whether the rate was individually negotiated or is the de minimis rate." ;
    rdfs:domain npo:indirect-cost-rate ;
    rdfs:range xsd:string ;
    npo:allowedValue "de-minimis",
        "negotiated" ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required true .

npoprop:installment-amount a owl:DatatypeProperty ;
    rdfs:label "Amount" ;
    rdfs:comment "The amount scheduled for this Installment." ;
    rdfs:domain npo:installment ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:installment-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the Installment has been disbursed, or is being held pending its Payment Condition." ;
    rdfs:domain npo:installment ;
    rdfs:range xsd:string ;
    npo:allowedValue "held",
        "released",
        "scheduled" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:letter-of-inquiry-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the Letter of Inquiry resulted in an invitation to submit a full Application." ;
    rdfs:domain npo:letter-of-inquiry ;
    rdfs:range xsd:string ;
    npo:allowedValue "declined",
        "invited",
        "submitted" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:matching-requirement-match-type a owl:DatatypeProperty ;
    rdfs:label "Match Type" ;
    rdfs:comment "Whether the required match must be cash or may be in-kind." ;
    rdfs:domain npo:matching-requirement ;
    rdfs:range xsd:string ;
    npo:allowedValue "cash",
        "in-kind" ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:matching-requirement-required-ratio a owl:DatatypeProperty ;
    rdfs:label "Required Ratio" ;
    rdfs:comment "The match ratio the Grantee must meet, e.g. \"1:1\"." ;
    rdfs:domain npo:matching-requirement ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:measurement-observation-date a owl:DatatypeProperty ;
    rdfs:label "Observation Date" ;
    rdfs:comment "The date the value was observed." ;
    rdfs:domain npo:measurement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:measurement-value a owl:DatatypeProperty ;
    rdfs:label "Value" ;
    rdfs:comment "The observed value for the indicator. A plain string so it can hold a numeric (\"64%\"), categorical (\"improved\"), ordinal (\"high\"), or textual observation without conflating these kinds of values into different fields." ;
    rdfs:domain npo:measurement ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:organization-formation-date a owl:DatatypeProperty ;
    rdfs:label "Formation Date" ;
    rdfs:comment "When the organization was legally formed." ;
    rdfs:domain npo:organization ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:organization-identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier" ;
    rdfs:comment "A registration number or unique identifier for the organization (e.g., an EIN or DUNS number), if tracked." ;
    rdfs:domain npo:organization ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:organization-jurisdiction a owl:DatatypeProperty ;
    rdfs:label "Jurisdiction" ;
    rdfs:comment "The legal jurisdiction (country or state) the organization is formed and regulated under." ;
    rdfs:domain npo:organization ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:organization-operating-status a owl:ObjectProperty ;
    rdfs:label "Operating Status" ;
    rdfs:comment "Whether the organization is currently operating." ;
    rdfs:domain npo:organization ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:referenceScheme nporef:organization-operating-status ;
    npo:required false .

npoprop:organization-tax-identifier a owl:DatatypeProperty ;
    rdfs:label "Tax Identifier" ;
    rdfs:comment "The organization's tax identification number (e.g., an EIN), if applicable and disclosed." ;
    rdfs:domain npo:organization ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:organization-tax-status a owl:DatatypeProperty ;
    rdfs:label "Tax Status" ;
    rdfs:comment "The organization's tax-exemption status, independent of its legal form." ;
    rdfs:domain npo:organization ;
    rdfs:range xsd:string ;
    npo:allowedValue "government-exempt",
        "tax-exempt-501c3",
        "tax-exempt-other",
        "taxable",
        "unknown" ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:output-unit a owl:DatatypeProperty ;
    rdfs:label "Unit" ;
    rdfs:comment "The unit the Output is counted in, e.g. \"workshops\" or \"people served\"." ;
    rdfs:domain npo:output ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:payment-amount a owl:DatatypeProperty ;
    rdfs:label "Amount" ;
    rdfs:comment "The actual amount transferred in this Payment." ;
    rdfs:domain npo:payment ;
    rdfs:range xsd:decimal ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required true .

npoprop:payment-condition-condition-type a owl:DatatypeProperty ;
    rdfs:label "Condition Type" ;
    rdfs:comment "What kind of condition must be satisfied before the corresponding Payment is released." ;
    rdfs:domain npo:payment-condition ;
    rdfs:range xsd:string ;
    npo:allowedValue "milestone-required",
        "none",
        "report-required" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required true .

npoprop:payment-currency a owl:DatatypeProperty ;
    rdfs:label "Currency" ;
    rdfs:comment "The currency the Payment was made in, if not implied by context." ;
    rdfs:domain npo:payment ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "financial" ;
    npo:required false .

npoprop:payment-date a owl:DatatypeProperty ;
    rdfs:label "Payment Date" ;
    rdfs:comment "When the Payment was sent or received." ;
    rdfs:domain npo:payment ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:payment-schedule-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether all Installments in the Payment Schedule have been disbursed." ;
    rdfs:domain npo:payment-schedule ;
    rdfs:range xsd:string ;
    npo:allowedValue "active",
        "completed" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:payment-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Payment stands in transit." ;
    rdfs:domain npo:payment ;
    rdfs:range xsd:string ;
    npo:allowedValue "pending",
        "received",
        "sent" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:philanthropic-arrangement-effective-date a owl:DatatypeProperty ;
    rdfs:label "Effective Date" ;
    rdfs:comment "When the arrangement took effect." ;
    rdfs:domain npo:philanthropic-arrangement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:philanthropic-arrangement-governing-document a owl:DatatypeProperty ;
    rdfs:label "Governing Document" ;
    rdfs:comment "The name or type of document that formally establishes the arrangement (e.g., a fiscal sponsorship agreement)." ;
    rdfs:domain npo:philanthropic-arrangement ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:philanthropic-arrangement-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the arrangement is currently active." ;
    rdfs:domain npo:philanthropic-arrangement ;
    rdfs:range xsd:string ;
    npo:allowedValue "active",
        "pending",
        "terminated" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:philanthropic-arrangement-termination-date a owl:DatatypeProperty ;
    rdfs:label "Termination Date" ;
    rdfs:comment "When the arrangement ended, if it has." ;
    rdfs:domain npo:philanthropic-arrangement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:project-issue-area a owl:ObjectProperty ;
    rdfs:label "Issue Area" ;
    rdfs:comment "The primary social or environmental issue this Project addresses." ;
    rdfs:domain npo:project ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:referenceScheme nporef:issue-area ;
    npo:required false .

npoprop:report-due-date a owl:DatatypeProperty ;
    rdfs:label "Due Date" ;
    rdfs:comment "When the Report is due per the Reporting Schedule." ;
    rdfs:domain npo:report ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:report-report-type a owl:DatatypeProperty ;
    rdfs:label "Report Type" ;
    rdfs:comment "Whether the Report covers narrative progress, financial use of funds, or both." ;
    rdfs:domain npo:report ;
    rdfs:range xsd:string ;
    npo:allowedValue "both",
        "financial",
        "narrative" ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required true .

npoprop:report-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Report stands with the funder." ;
    rdfs:domain npo:report ;
    rdfs:range xsd:string ;
    npo:allowedValue "accepted",
        "not-started",
        "rejected",
        "submitted" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:report-submitted-date a owl:DatatypeProperty ;
    rdfs:label "Submitted Date" ;
    rdfs:comment "When the Report was actually submitted, once it has been." ;
    rdfs:domain npo:report ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:reporting-requirement-due-date a owl:DatatypeProperty ;
    rdfs:label "Due Date" ;
    rdfs:comment "When a specific instance of this report is due." ;
    rdfs:domain npo:reporting-requirement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:reporting-requirement-frequency a owl:ObjectProperty ;
    rdfs:label "Frequency" ;
    rdfs:comment "How often this report is due, reusing the same Frequency scheme Reporting Schedule already uses." ;
    rdfs:domain npo:reporting-requirement ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:referenceScheme nporef:frequency ;
    npo:required false .

npoprop:reporting-requirement-report-type a owl:DatatypeProperty ;
    rdfs:label "Report Type" ;
    rdfs:comment "What kind of report this requirement obligates." ;
    rdfs:domain npo:reporting-requirement ;
    rdfs:range xsd:string ;
    npo:allowedValue "audit-report",
        "certification-report",
        "closeout-report",
        "expenditure-report",
        "final-report",
        "financial-report",
        "impact-report",
        "other",
        "outcome-report",
        "programmatic-report",
        "progress-report" ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required true .

npoprop:reporting-requirement-reporting-period-end a owl:DatatypeProperty ;
    rdfs:label "Reporting Period End" ;
    rdfs:comment "The end of the period this report covers." ;
    rdfs:domain npo:reporting-requirement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:reporting-requirement-reporting-period-start a owl:DatatypeProperty ;
    rdfs:label "Reporting Period Start" ;
    rdfs:comment "The start of the period this report covers." ;
    rdfs:domain npo:reporting-requirement ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:reporting-requirement-required-format a owl:DatatypeProperty ;
    rdfs:label "Required Format" ;
    rdfs:comment "The format the report must be submitted in, where the funder specifies one." ;
    rdfs:domain npo:reporting-requirement ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:reporting-schedule-frequency a owl:ObjectProperty ;
    rdfs:label "Frequency" ;
    rdfs:comment "How often Reports are due under this Reporting Schedule." ;
    rdfs:domain npo:reporting-schedule ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:referenceScheme nporef:frequency ;
    npo:required true .

npoprop:review-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where the Review currently stands." ;
    rdfs:domain npo:review ;
    rdfs:range xsd:string ;
    npo:allowedValue "completed",
        "in-progress",
        "pending" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:role-effective-from a owl:DatatypeProperty ;
    rdfs:label "Effective From" ;
    rdfs:comment "When this role occupancy takes effect. Inherited by every Person Role and Organization Role subclass." ;
    rdfs:domain npo:role ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:role-effective-to a owl:DatatypeProperty ;
    rdfs:label "Effective To" ;
    rdfs:comment "When this role occupancy ends, if it has a defined end. Must not precede Effective From." ;
    rdfs:domain npo:role ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:role-notes a owl:DatatypeProperty ;
    rdfs:label "Notes" ;
    rdfs:comment "Free-text context about this role occupancy not captured by its other properties." ;
    rdfs:domain npo:role ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:role-scope a owl:DatatypeProperty ;
    rdfs:label "Scope" ;
    rdfs:comment "How narrowly this role occupancy is scoped. A plain inline enum until Phase 3.7 Milestone 3's reference-data framework exists, at which point this becomes a governed vocabulary instead." ;
    rdfs:domain npo:role ;
    rdfs:range xsd:string ;
    npo:allowedValue "agreement-specific",
        "arrangement-specific",
        "award-specific",
        "organization-wide",
        "program-specific",
        "project-specific",
        "transaction-specific" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required false .

npoprop:role-status a owl:ObjectProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Where this role occupancy currently sits in its own lifecycle." ;
    rdfs:domain npo:role ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:referenceScheme nporef:role-status ;
    npo:required true .

npoprop:site-visit-scheduled-date a owl:DatatypeProperty ;
    rdfs:label "Scheduled Date" ;
    rdfs:comment "When the Site Visit is scheduled to occur." ;
    rdfs:domain npo:site-visit ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:site-visit-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the Site Visit has happened yet." ;
    rdfs:domain npo:site-visit ;
    rdfs:range xsd:string ;
    npo:allowedValue "cancelled",
        "completed",
        "scheduled" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:sponsored-project-end-date a owl:DatatypeProperty ;
    rdfs:label "End Date" ;
    rdfs:comment "When the Sponsored Project ended, if it has." ;
    rdfs:domain npo:sponsored-project ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:sponsored-project-start-date a owl:DatatypeProperty ;
    rdfs:label "Start Date" ;
    rdfs:comment "When the Sponsored Project began operating under its Fiscal Sponsor." ;
    rdfs:domain npo:sponsored-project ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required false .

npoprop:sponsored-project-status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:comment "Whether the Sponsored Project is still operating under its Fiscal Sponsor." ;
    rdfs:domain npo:sponsored-project ;
    rdfs:range xsd:string ;
    npo:allowedValue "active",
        "completed",
        "terminated" ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:target-target-date a owl:DatatypeProperty ;
    rdfs:label "Target Date" ;
    rdfs:comment "The date by which the target value is expected to be reached." ;
    rdfs:domain npo:target ;
    rdfs:range xsd:date ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:target-value a owl:DatatypeProperty ;
    rdfs:label "Value" ;
    rdfs:comment "The planned value for the indicator (e.g. \"70%\", \"500 households\"). A plain string so it can hold a numeric, percentage, or other planned value without a separate typed field per kind of indicator." ;
    rdfs:domain npo:target ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "lifecycle" ;
    npo:required true .

npoprop:terms-and-conditions-restriction-type a owl:DatatypeProperty ;
    rdfs:label "Restriction Type" ;
    rdfs:comment "Whether the funding governed by these Terms and Conditions is Restricted or Unrestricted Funding. A coarse flag, superseded for new data by one or more structured Use Restriction Grant Terms (see grant-term), which can express what specifically the funding is restricted to or from -- retained here for backward compatibility." ;
    rdfs:domain npo:terms-and-conditions ;
    rdfs:range xsd:string ;
    npo:allowedValue "restricted",
        "unrestricted" ;
    npo:cardinality "one" ;
    npo:group "governance" ;
    npo:required true .

npoprop:use-restriction-restricted-to a owl:DatatypeProperty ;
    rdfs:label "Restricted To" ;
    rdfs:comment "Free-text naming what the funds are specifically restricted to (e.g. a project or program name), where applicable." ;
    rdfs:domain npo:use-restriction ;
    rdfs:range xsd:string ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:use-restriction-restriction-mode a owl:DatatypeProperty ;
    rdfs:label "Restriction Mode" ;
    rdfs:comment "Whether this restriction requires a use, merely permits it, or prohibits it. An Award may carry more than one Use Restriction with different modes (e.g. a required-use restriction to a project, and a separate prohibited-use restriction on lobbying)." ;
    rdfs:domain npo:use-restriction ;
    rdfs:range xsd:string ;
    npo:allowedValue "permitted-use",
        "prohibited-use",
        "required-use" ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:required false .

npoprop:use-restriction-restriction-type a owl:ObjectProperty ;
    rdfs:label "Restriction Type" ;
    rdfs:comment "The nature of what this Use Restriction limits grant funds to or from." ;
    rdfs:domain npo:use-restriction ;
    rdfs:range skos:Concept ;
    npo:cardinality "one" ;
    npo:group "classification" ;
    npo:referenceScheme nporef:use-restriction-type ;
    npo:required true .

nporef:candid-pcs-populations-economically-disadvantaged-people a skos:Concept ;
    skos:definition "Illustrative placeholder for Candid PCS's Economically Disadvantaged People population." ;
    skos:inScheme nporef:candid-pcs-populations ;
    skos:notation "economically-disadvantaged-people" ;
    skos:prefLabel "Economically Disadvantaged People" .

nporef:candid-pcs-populations-people-of-color a skos:Concept ;
    skos:definition "Illustrative placeholder for Candid PCS's People of Color population." ;
    skos:inScheme nporef:candid-pcs-populations ;
    skos:notation "people-of-color" ;
    skos:prefLabel "People of Color" .

nporef:candid-pcs-populations-young-adults a skos:Concept ;
    skos:definition "Illustrative placeholder for Candid PCS's Young Adults population." ;
    skos:inScheme nporef:candid-pcs-populations ;
    skos:notation "young-adults" ;
    skos:prefLabel "Young Adults" .

nporef:candid-pcs-subjects-affordable-housing a skos:Concept ;
    skos:broadMatch nporef:issue-area-housing ;
    skos:broader nporef:candid-pcs-subjects-housing-development ;
    skos:definition "Illustrative placeholder for Candid PCS's Affordable Housing subject." ;
    skos:inScheme nporef:candid-pcs-subjects ;
    skos:notation "affordable-housing" ;
    skos:prefLabel "Affordable Housing" .

nporef:candid-pcs-subjects-economic-development a skos:Concept ;
    skos:broadMatch nporef:issue-area-economic-development ;
    skos:definition "Illustrative placeholder for Candid PCS's Economic Development subject." ;
    skos:inScheme nporef:candid-pcs-subjects ;
    skos:notation "economic-development" ;
    skos:prefLabel "Economic Development" .

nporef:candid-pcs-subjects-education a skos:Concept ;
    skos:broadMatch nporef:issue-area-education ;
    skos:definition "Illustrative placeholder for Candid PCS's Education subject." ;
    skos:inScheme nporef:candid-pcs-subjects ;
    skos:notation "education" ;
    skos:prefLabel "Education" .

nporef:candid-pcs-subjects-environment a skos:Concept ;
    skos:broadMatch nporef:issue-area-environment ;
    skos:definition "Illustrative placeholder for Candid PCS's Environment subject." ;
    skos:inScheme nporef:candid-pcs-subjects ;
    skos:notation "environment" ;
    skos:prefLabel "Environment" .

nporef:claim-type-association a skos:Concept ;
    skos:definition "Two phenomena are observed together, without asserting that one influenced the other." ;
    skos:inScheme nporef:claim-type ;
    skos:notation "association" ;
    skos:prefLabel "Association" .

nporef:claim-type-attribution a skos:Concept ;
    skos:definition "The evidence assigns a defined portion or substantial responsibility for the result to the intervention." ;
    skos:inScheme nporef:claim-type ;
    skos:notation "attribution" ;
    skos:prefLabel "Attribution" .

nporef:claim-type-causation a skos:Concept ;
    skos:definition "The evidence supports a causal relationship between the intervention and the result." ;
    skos:inScheme nporef:claim-type ;
    skos:notation "causation" ;
    skos:prefLabel "Causation" .

nporef:claim-type-contribution a skos:Concept ;
    skos:definition "There is evidence that the intervention played some role in producing the result, alongside other factors." ;
    skos:inScheme nporef:claim-type ;
    skos:notation "contribution" ;
    skos:prefLabel "Contribution" .

nporef:classification-scheme-registry-candid-pcs-organization-types a skos:Concept ;
    skos:definition "Candid's Philanthropy Classification System organization-type facet. Registered but not yet populated as its own reference-data file." ;
    skos:inScheme nporef:classification-scheme-registry ;
    skos:notation "candid-pcs-organization-types" ;
    skos:prefLabel "Candid PCS Organization Types" .

nporef:classification-scheme-registry-candid-pcs-populations a skos:Concept ;
    skos:definition "Candid's Philanthropy Classification System population facet -- what population(s) a resource serves or describes." ;
    skos:inScheme nporef:classification-scheme-registry ;
    skos:notation "candid-pcs-populations" ;
    skos:prefLabel "Candid PCS Populations" .

nporef:classification-scheme-registry-candid-pcs-subjects a skos:Concept ;
    skos:definition "Candid's Philanthropy Classification System subject facet -- what issue or subject a resource addresses or supports." ;
    skos:inScheme nporef:classification-scheme-registry ;
    skos:notation "candid-pcs-subjects" ;
    skos:prefLabel "Candid PCS Subjects" .

nporef:classification-scheme-registry-candid-pcs-support-strategies a skos:Concept ;
    skos:definition "Candid's Philanthropy Classification System support-strategy facet. Registered but not yet populated as its own reference-data file." ;
    skos:inScheme nporef:classification-scheme-registry ;
    skos:notation "candid-pcs-support-strategies" ;
    skos:prefLabel "Candid PCS Support Strategies" .

nporef:classification-scheme-registry-candid-pcs-transaction-types a skos:Concept ;
    skos:definition "Candid's Philanthropy Classification System transaction-type facet -- the form through which support is provided or received. Registered but not yet populated as its own reference-data file." ;
    skos:inScheme nporef:classification-scheme-registry ;
    skos:notation "candid-pcs-transaction-types" ;
    skos:prefLabel "Candid PCS Transaction Types" .

nporef:classification-scheme-registry-commongood-issue-areas a skos:Concept ;
    skos:definition "This ontology's own Issue Area scheme (see issue-area.json), usable as a classification scheme in its own right alongside external taxonomies." ;
    skos:inScheme nporef:classification-scheme-registry ;
    skos:notation "commongood-issue-areas" ;
    skos:prefLabel "CommonGood Issue Areas" .

nporef:condition-barrier-type-cost-sharing-requirement a skos:Concept ;
    skos:definition "Contingent on sharing costs alongside the award." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "cost-sharing-requirement" ;
    skos:prefLabel "Cost-Sharing Requirement" .

nporef:condition-barrier-type-fundraising-target a skos:Concept ;
    skos:definition "Contingent on reaching a fundraising target." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "fundraising-target" ;
    skos:prefLabel "Fundraising Target" .

nporef:condition-barrier-type-matching-requirement a skos:Concept ;
    skos:definition "Contingent on raising or contributing matching funds." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "matching-requirement" ;
    skos:prefLabel "Matching Requirement" .

nporef:condition-barrier-type-other a skos:Concept ;
    skos:definition "A condition barrier not captured by another value in this scheme." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "other" ;
    skos:prefLabel "Other" .

nporef:condition-barrier-type-other-measurable-barrier a skos:Concept ;
    skos:definition "Contingent on another measurable barrier not otherwise listed." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "other-measurable-barrier" ;
    skos:prefLabel "Other Measurable Barrier" .

nporef:condition-barrier-type-outcome-threshold a skos:Concept ;
    skos:definition "Contingent on reaching a specified outcome level." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "outcome-threshold" ;
    skos:prefLabel "Outcome Threshold" .

nporef:condition-barrier-type-output-threshold a skos:Concept ;
    skos:definition "Contingent on reaching a specified output count." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "output-threshold" ;
    skos:prefLabel "Output Threshold" .

nporef:condition-barrier-type-performance-milestone a skos:Concept ;
    skos:definition "Contingent on reaching a defined performance milestone." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "performance-milestone" ;
    skos:prefLabel "Performance Milestone" .

nporef:condition-barrier-type-qualifying-expenses a skos:Concept ;
    skos:definition "Contingent on incurring qualifying expenses." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "qualifying-expenses" ;
    skos:prefLabel "Qualifying Expenses" .

nporef:condition-barrier-type-regulatory-approval a skos:Concept ;
    skos:definition "Contingent on obtaining regulatory approval." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "regulatory-approval" ;
    skos:prefLabel "Regulatory Approval" .

nporef:condition-barrier-type-service-level-threshold a skos:Concept ;
    skos:definition "Contingent on reaching a specified service level." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "service-level-threshold" ;
    skos:prefLabel "Service-Level Threshold" .

nporef:condition-barrier-type-specified-event a skos:Concept ;
    skos:definition "Contingent on a specified event occurring." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "specified-event" ;
    skos:prefLabel "Specified Event" .

nporef:condition-barrier-type-specified-method a skos:Concept ;
    skos:definition "Contingent on using a specified method." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "specified-method" ;
    skos:prefLabel "Specified Method" .

nporef:condition-barrier-type-specified-personnel a skos:Concept ;
    skos:definition "Contingent on specified personnel being engaged." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "specified-personnel" ;
    skos:prefLabel "Specified Personnel" .

nporef:condition-barrier-type-specified-protocol a skos:Concept ;
    skos:definition "Contingent on following a specified protocol." ;
    skos:inScheme nporef:condition-barrier-type ;
    skos:notation "specified-protocol" ;
    skos:prefLabel "Specified Protocol" .

nporef:evidence-strength-anecdotal a skos:Concept ;
    skos:definition "Based on isolated stories or individual accounts, not a systematic review." ;
    skos:inScheme nporef:evidence-strength ;
    skos:notation "anecdotal" ;
    skos:prefLabel "Anecdotal" .

nporef:evidence-strength-inconclusive a skos:Concept ;
    skos:definition "The available evidence does not clearly support or refute the claim." ;
    skos:inScheme nporef:evidence-strength ;
    skos:notation "inconclusive" ;
    skos:prefLabel "Inconclusive" .

nporef:evidence-strength-limited a skos:Concept ;
    skos:definition "Based on a small or narrow body of evidence with significant gaps." ;
    skos:inScheme nporef:evidence-strength ;
    skos:notation "limited" ;
    skos:prefLabel "Limited" .

nporef:evidence-strength-moderate a skos:Concept ;
    skos:definition "Based on a reasonably systematic body of evidence with some limitations." ;
    skos:inScheme nporef:evidence-strength ;
    skos:notation "moderate" ;
    skos:prefLabel "Moderate" .

nporef:evidence-strength-strong a skos:Concept ;
    skos:definition "Based on a rigorous, systematic body of evidence with few limitations." ;
    skos:inScheme nporef:evidence-strength ;
    skos:notation "strong" ;
    skos:prefLabel "Strong" .

nporef:frequency-annual a skos:Concept ;
    skos:definition "Recurs once a year." ;
    skos:inScheme nporef:frequency ;
    skos:notation "annual" ;
    skos:prefLabel "Annual" .

nporef:frequency-monthly a skos:Concept ;
    skos:definition "Recurs every month." ;
    skos:inScheme nporef:frequency ;
    skos:notation "monthly" ;
    skos:prefLabel "Monthly" .

nporef:frequency-one-time a skos:Concept ;
    skos:definition "Occurs once, with no recurrence." ;
    skos:inScheme nporef:frequency ;
    skos:notation "one-time" ;
    skos:prefLabel "One-Time" .

nporef:frequency-quarterly a skos:Concept ;
    skos:definition "Recurs every three months." ;
    skos:inScheme nporef:frequency ;
    skos:notation "quarterly" ;
    skos:prefLabel "Quarterly" .

nporef:issue-area-arts-and-culture a skos:Concept ;
    skos:definition "Arts, culture, and creative expression." ;
    skos:inScheme nporef:issue-area ;
    skos:notation "arts-and-culture" ;
    skos:prefLabel "Arts and Culture" .

nporef:issue-area-food-security a skos:Concept ;
    skos:definition "Reliable access to sufficient, affordable, nutritious food." ;
    skos:inScheme nporef:issue-area ;
    skos:notation "food-security" ;
    skos:prefLabel "Food Security" .

nporef:issue-area-health a skos:Concept ;
    skos:definition "Physical and behavioral health, including access to care." ;
    skos:inScheme nporef:issue-area ;
    skos:notation "health" ;
    skos:prefLabel "Health" .

nporef:issue-area-human-rights a skos:Concept ;
    skos:definition "Civil rights, civil liberties, and human-rights advocacy." ;
    skos:inScheme nporef:issue-area ;
    skos:notation "human-rights" ;
    skos:prefLabel "Human Rights" .

nporef:organization-operating-status-active a skos:Concept ;
    skos:definition "The organization is currently operating." ;
    skos:inScheme nporef:organization-operating-status ;
    skos:notation "active" ;
    skos:prefLabel "Active" .

nporef:organization-operating-status-dissolved a skos:Concept ;
    skos:definition "The organization has formally ceased to exist." ;
    skos:inScheme nporef:organization-operating-status ;
    skos:notation "dissolved" ;
    skos:prefLabel "Dissolved" .

nporef:organization-operating-status-merged a skos:Concept ;
    skos:definition "The organization has combined into another organization and no longer operates independently." ;
    skos:inScheme nporef:organization-operating-status ;
    skos:notation "merged" ;
    skos:prefLabel "Merged" .

nporef:organization-operating-status-unknown a skos:Concept ;
    skos:definition "The organization's current operating status has not been confirmed." ;
    skos:inScheme nporef:organization-operating-status ;
    skos:notation "unknown" ;
    skos:prefLabel "Unknown" .

nporef:publication-status-deprecated a skos:Concept ;
    skos:definition "The scheme is no longer recommended for new use, though existing data may still reference its values." ;
    skos:inScheme nporef:publication-status ;
    skos:notation "deprecated" ;
    skos:prefLabel "Deprecated" .

nporef:restriction-type-permanently-restricted a skos:Concept ;
    skos:broader nporef:restriction-type-donor-restricted ;
    skos:definition "The fund's donor-imposed restriction never expires." ;
    skos:inScheme nporef:restriction-type ;
    skos:notation "permanently-restricted" ;
    skos:prefLabel "Permanently Restricted" .

nporef:restriction-type-temporarily-restricted a skos:Concept ;
    skos:broader nporef:restriction-type-donor-restricted ;
    skos:definition "The fund's donor-imposed restriction expires after a specific time or purpose is satisfied." ;
    skos:inScheme nporef:restriction-type ;
    skos:notation "temporarily-restricted" ;
    skos:prefLabel "Temporarily Restricted" .

nporef:restriction-type-unrestricted a skos:Concept ;
    skos:definition "The fund carries no donor-imposed restriction on its use." ;
    skos:inScheme nporef:restriction-type ;
    skos:notation "unrestricted" ;
    skos:prefLabel "Unrestricted" .

nporef:role-status-active a skos:Concept ;
    skos:definition "The role occupancy is currently in effect." ;
    skos:inScheme nporef:role-status ;
    skos:notation "active" ;
    skos:prefLabel "Active" .

nporef:role-status-cancelled a skos:Concept ;
    skos:definition "The role occupancy was called off before or without reaching its expected conclusion." ;
    skos:inScheme nporef:role-status ;
    skos:notation "cancelled" ;
    skos:prefLabel "Cancelled" .

nporef:role-status-ended a skos:Concept ;
    skos:definition "The role occupancy concluded as expected, e.g. at its effectiveTo date." ;
    skos:inScheme nporef:role-status ;
    skos:notation "ended" ;
    skos:prefLabel "Ended" .

nporef:role-status-planned a skos:Concept ;
    skos:definition "The role occupancy has been agreed but has not yet started." ;
    skos:inScheme nporef:role-status ;
    skos:notation "planned" ;
    skos:prefLabel "Planned" .

nporef:role-status-suspended a skos:Concept ;
    skos:definition "The role occupancy is temporarily paused without having formally ended." ;
    skos:inScheme nporef:role-status ;
    skos:notation "suspended" ;
    skos:prefLabel "Suspended" .

nporef:use-restriction-type-capital-only a skos:Concept ;
    skos:definition "Restricted to capital expenditures." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "capital-only" ;
    skos:prefLabel "Capital Only" .

nporef:use-restriction-type-endowment a skos:Concept ;
    skos:definition "Restricted to an endowment fund." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "endowment" ;
    skos:prefLabel "Endowment" .

nporef:use-restriction-type-equipment-only a skos:Concept ;
    skos:definition "Restricted to equipment purchases." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "equipment-only" ;
    skos:prefLabel "Equipment Only" .

nporef:use-restriction-type-general-purpose a skos:Concept ;
    skos:definition "Not restricted beyond the grantee's general mission." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "general-purpose" ;
    skos:prefLabel "General Purpose" .

nporef:use-restriction-type-individual-benefit a skos:Concept ;
    skos:definition "Concerns benefit to a specific individual, typically as a prohibited use." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "individual-benefit" ;
    skos:prefLabel "Individual Benefit" .

nporef:use-restriction-type-lobbying a skos:Concept ;
    skos:definition "Concerns lobbying activity, typically as a prohibited use." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "lobbying" ;
    skos:prefLabel "Lobbying" .

nporef:use-restriction-type-noncharitable-purpose a skos:Concept ;
    skos:definition "Concerns use for a noncharitable purpose, typically as a prohibited use." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "noncharitable-purpose" ;
    skos:prefLabel "Noncharitable Purpose" .

nporef:use-restriction-type-other a skos:Concept ;
    skos:definition "A use restriction not captured by another value in this scheme." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "other" ;
    skos:prefLabel "Other" .

nporef:use-restriction-type-political-campaign-activity a skos:Concept ;
    skos:definition "Concerns political campaign activity, typically as a prohibited use." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "political-campaign-activity" ;
    skos:prefLabel "Political Campaign Activity" .

nporef:use-restriction-type-regranting a skos:Concept ;
    skos:definition "Restricted to redistribution as regrants." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "regranting" ;
    skos:prefLabel "Regranting" .

nporef:use-restriction-type-scholarship a skos:Concept ;
    skos:definition "Restricted to scholarship purposes." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "scholarship" ;
    skos:prefLabel "Scholarship" .

nporef:use-restriction-type-specific-activity a skos:Concept ;
    skos:definition "Restricted to a named activity." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-activity" ;
    skos:prefLabel "Specific Activity" .

nporef:use-restriction-type-specific-budget a skos:Concept ;
    skos:definition "Restricted to a specific approved budget." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-budget" ;
    skos:prefLabel "Specific Budget" .

nporef:use-restriction-type-specific-cost-category a skos:Concept ;
    skos:definition "Restricted to a specific cost category (e.g. personnel, equipment)." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-cost-category" ;
    skos:prefLabel "Specific Cost Category" .

nporef:use-restriction-type-specific-geography a skos:Concept ;
    skos:definition "Restricted to a named geographic area." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-geography" ;
    skos:prefLabel "Specific Geography" .

nporef:use-restriction-type-specific-population a skos:Concept ;
    skos:definition "Restricted to serving a named population." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-population" ;
    skos:prefLabel "Specific Population" .

nporef:use-restriction-type-specific-program a skos:Concept ;
    skos:definition "Restricted to a named program." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-program" ;
    skos:prefLabel "Specific Program" .

nporef:use-restriction-type-specific-project a skos:Concept ;
    skos:definition "Restricted to a named project." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-project" ;
    skos:prefLabel "Specific Project" .

nporef:use-restriction-type-specific-time-period a skos:Concept ;
    skos:definition "Restricted to use within a defined time period." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "specific-time-period" ;
    skos:prefLabel "Specific Time Period" .

nporef:use-restriction-type-subgranting a skos:Concept ;
    skos:definition "Restricted to redistribution as subgrants." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "subgranting" ;
    skos:prefLabel "Subgranting" .

nporef:use-restriction-type-voter-registration a skos:Concept ;
    skos:definition "Concerns voter registration activity." ;
    skos:inScheme nporef:use-restriction-type ;
    skos:notation "voter-registration" ;
    skos:prefLabel "Voter Registration" .

nporel:aboutResult a owl:ObjectProperty ;
    rdfs:label "is about" ;
    rdfs:comment "An Evidence Claim is about a Result. Declared against the abstract Result concept rather than each subtype separately, so a claim can concern any Output, Outcome, or Impact instance." ;
    rdfs:domain npo:evidence-claim ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:result .

nporel:actsOnBehalfOf a owl:ObjectProperty ;
    rdfs:label "acts on behalf of" ;
    rdfs:comment "A Fiscal Sponsor stands in for a Grantee that lacks independent legal status to receive an Award directly." ;
    rdfs:domain npo:fiscal-sponsor ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#organizational-relationships> ;
    rdfs:range npo:grantee .

nporel:addressesNeed a owl:ObjectProperty ;
    rdfs:label "addresses" ;
    rdfs:comment "A Project addresses one or more identified Needs." ;
    rdfs:domain npo:project ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:need .

nporel:administeredBy a owl:ObjectProperty ;
    rdfs:label "is administered by" ;
    rdfs:comment "A Philanthropic Arrangement is administered by an Organization, such as a fiscal sponsor or fund administrator." ;
    rdfs:domain npo:philanthropic-arrangement ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:organization .

nporel:advises a owl:ObjectProperty ;
    rdfs:label "advises" ;
    rdfs:comment "A Donor Advisor advises a specific Donor-Advised Fund, holding non-binding privileges to recommend its grants and investments." ;
    rdfs:domain npo:donor-advisor ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:donor-advised-fund .

nporel:affiliatedWith a owl:ObjectProperty ;
    rdfs:label "is affiliated with" ;
    rdfs:comment "A Person is affiliated with an Organization, independent of which specific Person Role(s) they occupy there." ;
    rdfs:domain npo:person ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/02-core-concepts.md#organizational-entities> ;
    rdfs:range npo:organization .

nporel:appliesToAward a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "A Compliance Requirement applies to a specific Award -- distinct from the Grant Agreement specifying it: the Agreement is the document that spells out the requirement, while this relationship tracks which Award it actually binds. The same organization can be in good standing on one award and delinquent on another, so the requirement must attach to the Award, not the Grantee in the abstract." ;
    rdfs:domain npo:compliance-requirement ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:award .

nporel:appliesWithin a owl:ObjectProperty ;
    rdfs:label "applies within" ;
    rdfs:comment "An Organization Role is scoped to the Philanthropic Arrangement it was granted within, so the same organization can hold different roles in different arrangements." ;
    rdfs:domain npo:organization-role ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:philanthropic-arrangement .

nporel:assessedAgainstLogicModel a owl:ObjectProperty ;
    rdfs:label "is assessed against" ;
    rdfs:comment "Reports are assessed against the project's Logic Model in terms of Outputs and Outcomes." ;
    rdfs:domain npo:report ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:logic-model .

nporel:assessedAgainstTheoryOfChange a owl:ObjectProperty ;
    rdfs:label "is assessed against" ;
    rdfs:comment "Reports are assessed against the project's Theory of Change in terms of Outputs and Outcomes." ;
    rdfs:domain npo:report ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:theory-of-change .

nporel:assessesOutcome a owl:ObjectProperty ;
    rdfs:label "assesses" ;
    rdfs:comment "An Evaluation assesses whether a grant-funded project achieved its intended Outcomes." ;
    rdfs:domain npo:evaluation ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:outcome .

nporel:assessesOutput a owl:ObjectProperty ;
    rdfs:label "assesses" ;
    rdfs:comment "An Evaluation assesses whether a grant-funded project achieved its intended Outputs." ;
    rdfs:domain npo:evaluation ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:output .

nporel:associatedWithGrantProgram a owl:ObjectProperty ;
    rdfs:label "is associated with" ;
    rdfs:comment "A Program Officer is associated with one or more Grant Programs and typically owns the Review and monitoring relationship for Awards made under them." ;
    rdfs:domain npo:program-officer ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#organizational-relationships> ;
    rdfs:range npo:grant-program .

nporel:attachesComplianceRequirement a owl:ObjectProperty ;
    rdfs:label "attaches" ;
    rdfs:comment "A Grant Agreement attaches Compliance Requirements, including a Reporting Schedule." ;
    rdfs:domain npo:grant-agreement ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:compliance-requirement .

nporel:awardHasClassification a owl:ObjectProperty ;
    rdfs:label "has classification" ;
    rdfs:comment "An Award has one or more Classification Assignments (e.g. Candid PCS Subjects) drawn from an external or internal classification scheme. The scheme classifies the Award; it does not redefine it." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#classification> ;
    rdfs:range npo:classification-assignment .

nporel:awardedBy a owl:ObjectProperty ;
    rdfs:label "is awarded by" ;
    rdfs:comment "An Award is awarded by an Organization -- the original source of the funding, which may differ from the organization that administers it." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:organization .

nporel:awardedTo a owl:ObjectProperty ;
    rdfs:label "is awarded to" ;
    rdfs:comment "An Award is awarded to an Organization -- the ultimate recipient, which may differ from the organization managing compliance on its behalf." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:organization .

nporel:brokenIntoInstallment a owl:ObjectProperty ;
    rdfs:label "is broken into" ;
    rdfs:comment "A Payment Schedule is broken into Installments." ;
    rdfs:domain npo:payment-schedule ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:installment .

nporel:concernsFund a owl:ObjectProperty ;
    rdfs:label "concerns" ;
    rdfs:comment "A Grant Recommendation concerns a specific Fund -- ordinarily a Donor-Advised Fund -- that would pay for the recommended award." ;
    rdfs:domain npo:grant-recommendation ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:fund .

nporel:conductedByReviewer a owl:ObjectProperty ;
    rdfs:label "is conducted by" ;
    rdfs:comment "A Review is conducted by one or more Reviewers." ;
    rdfs:domain npo:review ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:reviewer .

nporel:contributesToImpact a owl:ObjectProperty ;
    rdfs:label "contributes to" ;
    rdfs:comment "An Outcome contributes to a broader or longer-term Impact. Deliberately \"contributes to,\" not \"causes\" -- see Evidence Claim for how a specific causal or contributory interpretation of that contribution is represented and evidenced." ;
    rdfs:domain npo:outcome ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:impact .

nporel:contributesToOutcome a owl:ObjectProperty ;
    rdfs:label "contributes to" ;
    rdfs:comment "An Output contributes to an intended or observed Outcome. Deliberately \"contributes to,\" not \"causes\" -- see Evidence Claim for how a specific causal or contributory interpretation of that contribution is represented and evidenced." ;
    rdfs:domain npo:output ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:outcome .

nporel:disbursedAsPayment a owl:ObjectProperty ;
    rdfs:label "is disbursed as" ;
    rdfs:comment "An Installment is disbursed as a Payment once any Payment Condition is satisfied." ;
    rdfs:domain npo:installment ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:payment .

nporel:evaluatedAgainstReviewCriteria a owl:ObjectProperty ;
    rdfs:label "is evaluated against" ;
    rdfs:comment "A Review evaluates an Application against published Review Criteria." ;
    rdfs:domain npo:review ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:review-criteria .

nporel:evaluatesProject a owl:ObjectProperty ;
    rdfs:label "evaluates" ;
    rdfs:comment "An Evaluation assesses a Project." ;
    rdfs:domain npo:evaluation ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:project .

nporel:experiencedByPopulation a owl:ObjectProperty ;
    rdfs:label "is experienced by" ;
    rdfs:comment "A Need is experienced by a specific Population." ;
    rdfs:domain npo:need ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:population .

nporel:fiscallySponsoredBy a owl:ObjectProperty ;
    rdfs:label "is fiscally sponsored by" ;
    rdfs:comment "A Sponsored Project is fiscally sponsored by an Organization that provides the legal and administrative infrastructure it lacks on its own." ;
    rdfs:domain npo:sponsored-project ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:organization .

nporel:followsGrantLifecycle a owl:ObjectProperty ;
    rdfs:label "follows" ;
    rdfs:comment "An Award's progression from decision through closeout follows the Grant Lifecycle sequence." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:grant-lifecycle .

nporel:formalizedByGrantAgreement a owl:ObjectProperty ;
    rdfs:label "is formalized by" ;
    rdfs:comment "An Award is formalized by a Grant Agreement." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:grant-agreement .

nporel:fulfilledByReport a owl:ObjectProperty ;
    rdfs:label "is fulfilled by" ;
    rdfs:comment "A Reporting Requirement is fulfilled by a submitted Report. Requirement is what must be supplied; Report is the artifact that was actually supplied." ;
    rdfs:domain npo:reporting-requirement ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms> ;
    rdfs:range npo:report .

nporel:fundedBy a owl:ObjectProperty ;
    rdfs:label "is funded by" ;
    rdfs:comment "A Grant Program is funded by a Fund -- the pool of financial resources backing the program's giving strategy." ;
    rdfs:domain npo:grant-program ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:fund .

nporel:fundedFrom a owl:ObjectProperty ;
    rdfs:label "is funded from" ;
    rdfs:comment "An Award draws its funds from a specific Fund." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:fund .

nporel:fundsProject a owl:ObjectProperty ;
    rdfs:label "funds" ;
    rdfs:comment "An Award commits funding to a Project. The Award is the funding commitment; the Project is the work performed using it." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:project .

nporel:governs a owl:ObjectProperty ;
    rdfs:label "governs" ;
    rdfs:comment "A Donor-Advised Fund Arrangement governs the specific Donor-Advised Fund it establishes the advisory relationship for." ;
    rdfs:domain npo:donor-advised-fund-arrangement ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:donor-advised-fund .

nporel:grantTermAppliesToAward a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "A Grant Term applies to a specific Award. Declared against the abstract Grant Term concept, used by Use Restriction, Grant Condition, Approval Requirement, and Reporting Requirement instances -- Compliance Requirement keeps its own existing, more specific appliesToAward predicate unchanged, and Matching Requirement/Payment Condition/Reporting Schedule are already reachable from Award through their existing relationships, so none of those three need this one too." ;
    rdfs:domain npo:grant-term ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms> ;
    rdfs:range npo:award .

nporel:hasConditionResponsibleParty a owl:ObjectProperty ;
    rdfs:label "has responsible party" ;
    rdfs:comment "A Grant Condition optionally identifies the Agent (Person or Organization) responsible for satisfying it -- e.g. the grantee organization for a matching requirement, or a fiscal sponsor rather than the project itself." ;
    rdfs:domain npo:grant-condition ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#grant-terms> ;
    rdfs:range npo:agent .

nporel:hasLegalForm a owl:ObjectProperty ;
    rdfs:label "has legal form" ;
    rdfs:comment "An Organization has a legal form describing what it fundamentally is under law, independent of any role it plays." ;
    rdfs:domain npo:organization ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:organization-type .

nporel:hasLogicModel a owl:ObjectProperty ;
    rdfs:label "has" ;
    rdfs:comment "A Project has a Logic Model connecting its inputs, activities, outputs, and outcomes." ;
    rdfs:domain npo:project ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:logic-model .

nporel:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "has" ;
    rdfs:comment "An Indicator has one or more Measurements -- the observed values recorded over time. Never equated with the Indicator's Target: a Target is planned, a Measurement is observed." ;
    rdfs:domain npo:indicator ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:measurement .

nporel:hasPaymentSchedule a owl:ObjectProperty ;
    rdfs:label "has" ;
    rdfs:comment "An Award's funds are released according to a Payment Schedule." ;
    rdfs:domain npo:award ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:payment-schedule .

nporel:hasTarget a owl:ObjectProperty ;
    rdfs:label "has" ;
    rdfs:comment "An Indicator has a Target -- the planned value expected by a defined date." ;
    rdfs:domain npo:indicator ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:target .

nporel:hasTheoryOfChange a owl:ObjectProperty ;
    rdfs:label "has" ;
    rdfs:comment "A Project has a Theory of Change articulating how its activities are expected to lead to desired long-term change." ;
    rdfs:domain npo:project ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:theory-of-change .

nporel:heldBy a owl:ObjectProperty ;
    rdfs:label "is held by" ;
    rdfs:comment "A Fund is held and administered by an Organization." ;
    rdfs:domain npo:fund ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/08-organizations-roles-and-arrangements.md> ;
    rdfs:range npo:organization .

nporel:implementsProject a owl:ObjectProperty ;
    rdfs:label "implements" ;
    rdfs:comment "An Organization carries out a Project -- typically the Grantee, but modeled directly on Organization rather than a specific role so any organization implementing work (e.g. a Sponsored Project's Fiscal Sponsor) can be represented the same way." ;
    rdfs:domain npo:organization ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:project .

nporel:includesActivity a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "A Logic Model includes the Activities it plans for." ;
    rdfs:domain npo:logic-model ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:activity .

nporel:includesBudget a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "An Application includes a proposed Budget." ;
    rdfs:domain npo:application ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:budget .

nporel:includesInput a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "A Logic Model includes the Inputs it plans for." ;
    rdfs:domain npo:logic-model ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:input .

nporel:includesOutcome a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "A Logic Model includes the Outcomes it plans for." ;
    rdfs:domain npo:logic-model ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:outcome .

nporel:includesOutput a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "A Logic Model includes the Outputs it plans for." ;
    rdfs:domain npo:logic-model ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#programs-results-and-evidence> ;
    rdfs:range npo:output .

nporel:includesReportingSchedule a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "A Compliance Requirement includes a Reporting Schedule that obligates the Grantee to submit Reports." ;
    rdfs:domain npo:compliance-requirement ;
    rdfs:isDefinedBy <https://github.com/EGovender/commongood-atlas/blob/main/docs/03-relationships.md#the-grant-lifecycle-end-to-end> ;
    rdfs:range npo:reporting-schedule .

nporel:issuesFundingOpportunity a owl:ObjectProperty ;
