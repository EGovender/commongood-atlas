    <skos:notation>lobbying</skos:notation>
    <skos:prefLabel>Lobbying</skos:prefLabel>
    <skos:definition>Concerns lobbying activity, typically as a prohibited use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-noncharitable-purpose">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>noncharitable-purpose</skos:notation>
    <skos:prefLabel>Noncharitable Purpose</skos:prefLabel>
    <skos:definition>Concerns use for a noncharitable purpose, typically as a prohibited use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-other">
