    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>endowment</skos:notation>
    <skos:prefLabel>Endowment</skos:prefLabel>
    <skos:definition>Restricted to an endowment fund.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-equipment-only">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>equipment-only</skos:notation>
    <skos:prefLabel>Equipment Only</skos:prefLabel>
    <skos:definition>Restricted to equipment purchases.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-general-purpose">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>general-purpose</skos:notation>
    <skos:prefLabel>General Purpose</skos:prefLabel>
    <skos:definition>Not restricted beyond the grantee's general mission.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-individual-benefit">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:inScheme rdf:resource="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type" />
    <skos:notation>individual-benefit</skos:notation>
    <skos:prefLabel>Individual Benefit</skos:prefLabel>
    <skos:definition>Concerns benefit to a specific individual, typically as a prohibited use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://egovender.github.io/commongood-atlas/ontology/reference-data/use-restriction-type-lobbying">
